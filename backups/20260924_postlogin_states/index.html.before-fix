<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Plano de Sustentação Matriz</title>
<style>
:root{--navy:#092b4d;--orange:#ff5a00;--light:#f4f7fa;--line:#d7e0e8;--green:#d9f5df;--yellow:#fff3a8;--red:#ffc5c5;--text:#102b49}
*{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--text);background:#eef3f7}
.wrap{max-width:1600px;margin:auto;background:white;min-height:100vh}
header{display:flex;align-items:center;gap:28px;padding:22px 28px;border-bottom:4px solid var(--orange);background:linear-gradient(100deg,#fff 55%,#edf4f8)}
.brand{width:145px;height:145px;display:flex;align-items:center;justify-content:center;flex:0 0 145px}
.brand img{width:100%;height:100%;object-fit:contain;display:block}.slogan{font-size:24px;font-weight:800;border-left:1px solid #9cb0c0;padding-left:22px}.slogan:after{content:"";display:block;width:60px;border-bottom:6px solid var(--orange);margin-top:10px}
h1{margin:0;font-size:38px}.matrix{display:block;color:var(--orange);font-size:64px;line-height:.95}.sub{font-size:14px;margin-top:8px}
.toolbar{padding:14px 24px;background:var(--navy);color:#fff;display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:sticky;top:0;z-index:5}
button,.fileLabel{border:0;border-radius:7px;padding:10px 14px;font-weight:700;cursor:pointer;background:var(--orange);color:white}
button.secondary,.fileLabel.secondary{background:white;color:var(--navy)}
input[type=file]{display:none}
.meta{display:grid;grid-template-columns:1.1fr 1.8fr 1fr 1fr .8fr;gap:10px;padding:16px 20px}
.card{border:1px solid var(--line);border-radius:9px;padding:12px;background:#fff}
.card b{display:block;font-size:13px}.card span{font-size:18px;font-weight:800}
section{padding:0 20px 16px} h2{font-size:22px;margin:0 0 10px;border-left:6px solid var(--orange);padding-left:10px}
.tableWrap{overflow:auto;border:1px solid var(--line);border-radius:9px}
table{border-collapse:collapse;width:100%;min-width:1250px} th{background:var(--navy);color:#fff;padding:9px;font-size:13px;position:sticky;top:0}
td{padding:8px;border:1px solid #e4e9ee;text-align:center;font-size:13px} td:first-child{text-align:left;font-weight:700}
.good{background:var(--green)}.warn{background:var(--yellow)}.bad{background:var(--red)}
.summary{display:grid;grid-template-columns:1.05fr 2.1fr 1.25fr;gap:12px;padding:0 20px 16px}
.big{font-size:18px;font-weight:900;margin:12px 0}.ok{color:#009b42}.attention{color:#f3a000}.critical{color:#e52020}
.summary .card{min-height:205px}
.summary h2{font-size:17px;color:var(--orange);border-left:0;padding-left:0}
.summaryKpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.kpiMini{border:1px solid var(--line);border-radius:9px;padding:12px 8px;text-align:center;background:#fff}
.kpiMini .value{font-size:26px;font-weight:900;color:var(--navy)}
.kpiMini .name{font-size:13px;font-weight:700;margin:3px 0 12px}
.kpiMini .goal{font-size:11px;margin-bottom:9px}
.badge{display:inline-block;padding:7px 10px;border-radius:6px;background:#00a341;color:#fff;font-size:11px;font-weight:800}
.summaryLine{display:flex;align-items:center;gap:12px;margin:12px 0;font-size:15px;font-weight:800}
.summaryIcon{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;flex:0 0 38px}
.summaryIcon.okbg{background:#00a341}.summaryIcon.warnbg{background:#f4a300}.summaryIcon.badbg{background:#ef2020}
.alertLine{display:grid;grid-template-columns:38px 1fr;gap:10px;margin:11px 0;align-items:start}
.alertLine b{font-size:14px}.alertLine small{display:block;margin-top:2px}
@media(max-width:1100px){.summary{grid-template-columns:1fr}.summaryKpis{grid-template-columns:repeat(2,1fr)}}
.actions td:nth-child(2),.actions td:nth-child(6){text-align:left}
  .actionTools{display:flex;gap:8px;align-items:center;margin:0 0 10px}
  .actionTools button{padding:9px 14px}
  .monitoringHeader{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
  .monitoringHeader h2{margin:0}
  .indicatorCreatePanel{background:#f7fafc;border:1px solid var(--line);border-left:4px solid var(--orange);border-radius:9px;padding:12px;margin:0 0 12px}
  .indicatorCreatePanel[hidden]{display:none}
  .indicatorCreatePanel strong{display:block;color:var(--navy);font-size:13px;margin-bottom:9px}
  .indicatorCreateForm{display:grid;grid-template-columns:2fr repeat(5,1fr) auto auto;gap:8px;align-items:end}
  .indicatorCreateField{display:flex;flex-direction:column;gap:4px}
  .indicatorCreateField label{font-size:10px;color:#536d82;font-weight:900;text-transform:uppercase}
  .indicatorCreateField input,.indicatorCreateField select{width:100%;padding:8px;border:1px solid #cbd7e2;border-radius:6px;background:#fff;color:var(--navy);font:inherit}
  .indicatorEditButton{padding:4px 7px;background:#e9eff4;color:var(--navy);font-size:10px;border-radius:5px;margin-left:auto}
  .indicatorCreateStatus{grid-column:1/-1;font-size:11px;font-weight:800;color:#087a35;min-height:14px}
  .indicatorCreateStatus.err{color:#b21818}
  @media(max-width:1000px){.indicatorCreateForm{grid-template-columns:repeat(3,1fr)}.indicatorCreateForm button{grid-column:span 1}}
  @media(max-width:620px){.monitoringHeader{display:block}.monitoringHeader button{margin-top:7px}.indicatorCreateForm{grid-template-columns:1fr 1fr}.indicatorCreateForm .indicatorCreateField:first-child{grid-column:1/-1}}

.deleteRow{background:#e52020;color:#fff;border:0;border-radius:5px;padding:5px 9px;font-weight:800;cursor:pointer}
.actions th:last-child,.actions td:last-child{width:80px;text-align:center}
footer{background:var(--navy);color:#fff;padding:22px 28px;display:flex;justify-content:space-around;font-weight:700;border-bottom:8px solid var(--orange)}
.editable{outline:none}.editable:focus{box-shadow:inset 0 0 0 2px var(--orange)}
.indicatorName{display:flex;align-items:center;gap:7px}
.toggleDetail{width:24px;height:24px;padding:0;border-radius:50%;background:var(--navy);color:#fff;font-size:15px;line-height:24px}
.detailRow{display:none;background:#f8fafc}
.detailRow.open{display:table-row}
.detailCell{padding:10px 14px!important;text-align:left!important;border-left:4px solid var(--orange)!important}
.detailBox{display:grid;grid-template-columns:repeat(4,minmax(140px,1fr));gap:10px}
.detailField{background:#fff;border:1px solid var(--line);border-radius:7px;padding:8px}
.detailField label{display:block;font-size:10px;font-weight:800;color:#667788;margin-bottom:4px;text-transform:uppercase}
.detailField div{min-height:24px;font-weight:700}
.inventoryGrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr auto;gap:7px;align-items:center}
.inventoryGrid input{width:100%;padding:7px;border:1px solid var(--line);border-radius:5px}
.inventoryHeader{font-size:10px;font-weight:800;color:#667788;text-transform:uppercase}
.addClient{padding:7px 10px;font-size:11px}
.removeClient{background:#e52020;padding:6px 8px;font-size:10px}
.monthTabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:12px;border-bottom:1px solid var(--line);padding-bottom:8px}
.monthTab{background:#e9eff4;color:var(--navy);padding:7px 10px;border-radius:5px;font-size:11px}
.monthTab.active{background:var(--orange);color:#fff}
.monthDetailContent{min-height:72px}
@media(max-width:1100px){.detailBox{grid-template-columns:1fr 1fr}.inventoryGrid{grid-template-columns:1fr 1fr}}
.note{font-size:12px;opacity:.85}
@media print{.toolbar{display:none} body{background:white}.wrap{max-width:none} @page{size:A3 landscape;margin:8mm}}

.authOverlay{position:fixed;inset:0;background:#092b4d;z-index:9999;display:flex;align-items:center;justify-content:center}.authBox{width:420px;max-width:92vw;background:#fff;padding:30px;border-radius:16px;border-top:7px solid var(--orange)}.authBox input{width:100%;padding:12px;margin:6px 0 12px;border:1px solid #ccd7df;border-radius:7px}.authBox button{width:100%}.authError{color:#c00;font-size:12px;font-weight:bold;margin-top:10px}.syncStatus{padding:7px 10px;border-radius:6px;background:#e9eff4;color:#092b4d;font-size:11px;font-weight:bold}.syncStatus.ok{background:#d9f5df;color:#087a35}.syncStatus.err{background:#ffdede;color:#b21818}.yearSelect{padding:8px;border-radius:6px;border:0;font-weight:bold}
  .viewTabs{display:flex;gap:8px;padding:12px 24px 0;background:#fff;border-bottom:1px solid var(--line)}
  .viewTab{background:#e9eff4;color:var(--navy);border-radius:8px 8px 0 0;padding:11px 18px;font-weight:800}
  .viewTab.active{background:var(--orange);color:#fff}
  .viewTab.operationEmpty{opacity:.72}
  .slaNeologSection{margin-top:16px}.slaNeologSection[hidden]{display:none}.slaNeologNote{margin:-5px 0 10px;color:#718598;font-size:11px;line-height:1.45}.slaNeologTable{min-width:1180px}.slaNeologTable th{background:#0b2f52}.slaNeologTable td.slaEditable{background:#fffdf6;cursor:text}.slaNeologTable td.slaAccumulated{background:#eef5fa;font-weight:900;color:#0b2f52}.slaNeologTable tr.slaSpecial td{background:#fff1df;font-weight:900;color:#0b2f52;border-top:2px solid var(--orange)}.slaNeologTable tr.slaSpecial td.slaAccumulated{background:#ffe4bd}.slaTypeHint{font-size:9px;color:#718598;font-weight:700;display:block;margin-top:2px}
  .viewPanel{display:none}.viewPanel.active{display:block}
  .absControls{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:10px;align-items:end;margin-bottom:14px}
  .absControls label{font-size:12px;font-weight:800;color:var(--navy)}
  .absControls input,.absControls select{display:block;width:100%;margin-top:5px;padding:9px;border:1px solid var(--line);border-radius:7px;font:inherit}
  .absActions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;grid-column:1/-1}
  .absNote{background:#eef5fa;border-left:4px solid var(--orange);padding:10px 12px;border-radius:6px;font-size:12px;line-height:1.45;margin-bottom:12px}
  .absKpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:16px}
  .absKpi{border:1px solid var(--line);border-radius:9px;padding:12px;background:#fff;min-height:88px}
  .absKpi b{display:block;color:#667788;font-size:11px;text-transform:uppercase;margin-bottom:7px}
  .absKpi strong{font-size:23px;color:var(--navy)}
  .absGrid{display:grid;grid-template-columns:1.1fr 1.1fr .9fr;gap:12px;margin-bottom:16px}
  .absCard{border:1px solid var(--line);border-radius:9px;padding:12px;background:#fff}
  .absCard h3{margin:0 0 9px;color:var(--orange);font-size:16px}
  .absTable{min-width:0}
  .absTable table{min-width:0}
  .absTable th{position:static}
  .absTable td:first-child{text-align:left}
  .absBar{height:8px;background:#edf1f4;border-radius:8px;overflow:hidden;min-width:70px}
  .absBar span{display:block;height:100%;background:var(--orange);border-radius:8px}
  .absMuted{font-size:12px;color:#667788}
  .absHistory{margin-top:16px}
  .absHistory table{min-width:760px}
  .absHistory button{padding:5px 8px;background:#e52020}
  .absOptional{display:none!important}
  @media(max-width:1250px){.absKpis{grid-template-columns:repeat(3,1fr)}.absGrid{grid-template-columns:1fr 1fr}}
  @media(max-width:760px){.viewTabs{padding-left:10px;padding-right:10px}.absControls{grid-template-columns:1fr 1fr}.absKpis{grid-template-columns:repeat(2,1fr)}.absGrid{grid-template-columns:1fr}}


  /* Dashboard executivo de absenteísmo */
  .execAbs{padding:18px 24px 26px;background:#f5f8fb}
  .execAbsHeader{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:14px}
  .execEyebrow{display:block;color:var(--orange);font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
  .execAbs h2{margin:0;color:var(--navy);border:0;padding:0;font-size:25px}
  .execSubtitle{margin:5px 0 0;color:#65798d;font-size:13px}
  .execAbsStatus{white-space:nowrap;background:#fff;border:1px solid var(--line);border-radius:8px;padding:9px 12px;color:var(--navy);font-size:11px;font-weight:800}
  .execAbsStatus.ok{background:#e5f7ed;color:#087a35;border-color:#b9e8ca}
  .execAbsStatus.err{background:#fff0f0;color:#b21818;border-color:#f1bcbc}
  .execAbsStatus,.execStatus{display:none!important}
  .execFilters{display:flex;align-items:end;gap:9px;flex-wrap:wrap;padding:12px;background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:14px;box-shadow:0 2px 8px rgba(9,43,77,.04)}
  .execFilters label{min-width:130px;flex:1;color:var(--navy);font-size:11px;font-weight:900}
  .execFilters input,.execFilters select{display:block;width:100%;margin-top:5px;padding:8px 9px;border:1px solid #ccd9e4;border-radius:6px;background:#fff;color:var(--navy);font:inherit;font-size:12px}
  .execFilters button{height:35px;padding:8px 12px;font-size:11px}
  .execFile{display:inline-flex!important;align-items:center;justify-content:center;min-width:170px;flex:0 0 auto!important;background:var(--orange);color:#fff!important;border-radius:7px;padding:9px 12px!important;cursor:pointer}
  .execFile input{display:none!important}
  .execStatus{margin-left:auto;min-width:150px;text-align:center}
  .execKpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}
  .execKpi{position:relative;min-height:104px;padding:13px 14px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 2px 8px rgba(9,43,77,.04);overflow:hidden}
  .execKpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--orange)}
  .execKpiLabel{display:block;color:#60758a;font-size:10px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;max-width:92%}
  .execKpiValue{display:block;margin-top:8px;color:var(--navy);font-size:22px;font-weight:900;line-height:1.05}
  .execKpiMeta{display:block;margin-top:8px;color:#718598;font-size:10px;font-weight:700}
  .execKpiMeta.up{color:#008d53}.execKpiMeta.down{color:#d15b21}.execKpiMeta.neutral{color:#718598}
  .execGrid{display:grid;grid-template-columns:1.35fr 1fr 1.25fr;gap:12px;margin-bottom:12px}
  .execCard{min-width:0;background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;box-shadow:0 2px 8px rgba(9,43,77,.04)}
  .execCard.wide{grid-column:span 2}
  .execCard h3{margin:0 0 9px;padding-left:10px;border-left:4px solid var(--orange);color:var(--navy);font-size:14px}
  .execChart{height:245px;position:relative}
  .execChart canvas{width:100%!important;height:100%!important}
  .execChartNote{margin:-2px 0 7px;color:#73879a;font-size:10px}
  .execBottom{display:grid;grid-template-columns:1.35fr 1fr;gap:12px}
  .execTable{overflow:auto}
  .execTable table{min-width:620px;width:100%;border-collapse:collapse}
  .execTable th{position:static;background:var(--navy);color:#fff;padding:8px;font-size:10px;white-space:nowrap}
  .execTable td{padding:8px;border:1px solid #e3e9ef;text-align:center;font-size:11px;white-space:nowrap}
  .execTable td:first-child{text-align:left;font-weight:800;color:var(--navy)}
  .execBadge{display:inline-block;padding:4px 7px;border-radius:12px;font-size:10px;font-weight:900}
  .execBadge.ok{background:#daf4e3;color:#087a35}.execBadge.warn{background:#fff0cf;color:#966400}.execBadge.alert{background:#ffe0e0;color:#b21818}.execBadge.info{background:#e8eef5;color:#48647f}
  .execEmpty{display:flex;align-items:center;justify-content:center;min-height:105px;color:#73879a;font-size:12px;text-align:center;padding:15px}
  @media(max-width:1250px){.execKpis{grid-template-columns:repeat(3,1fr)}.execGrid{grid-template-columns:1fr 1fr}.execCard.wide{grid-column:span 2}}
  @media(max-width:760px){.execAbs{padding:14px 10px 20px}.execAbsHeader{display:block}.execAbsStatus{display:inline-block;margin-top:10px}.execFilters label{min-width:calc(50% - 5px)}.execStatus{margin-left:0;min-width:100%}.execKpis{grid-template-columns:repeat(2,1fr)}.execGrid,.execBottom{grid-template-columns:1fr}.execCard.wide{grid-column:auto}.execChart{height:220px}}


  .execSubtabs{display:flex;gap:8px;margin:0 0 14px;border-bottom:1px solid #d9e2ea}
  .execSubtab{border:1px solid #d9e2ea;border-bottom:0;border-radius:8px 8px 0 0;background:#e9eff4;color:var(--navy);padding:10px 15px;font-size:12px;font-weight:900;cursor:pointer}
  .execSubtab.active{background:var(--navy);color:#fff;border-color:var(--navy)}
  .execSubpanel{display:none}.execSubpanel.active{display:block}
  .intelRadar{display:flex;justify-content:space-between;align-items:center;gap:14px;background:linear-gradient(120deg,#082d51,#0d4770);color:#fff;border-radius:10px;padding:16px;margin-bottom:12px}
  .intelRadar h3{margin:0;color:#fff;border:0;padding:0;font-size:18px}.intelRadar p{margin:5px 0 0;color:#d7e9f5;font-size:11px}.intelRadarPeriod{white-space:nowrap;color:#d7e9f5;font-size:11px;font-weight:800}
  .intelCards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}
  .intelMetric{background:#fff;border:1px solid var(--line);border-radius:9px;padding:12px;min-height:82px;box-shadow:0 2px 8px rgba(9,43,77,.04)}
  .intelMetric b{display:block;color:#60758a;font-size:10px;text-transform:uppercase}.intelMetric strong{display:block;margin-top:6px;color:var(--navy);font-size:22px}.intelMetric small{display:block;margin-top:4px;color:#73879a;font-size:10px}
  .intelGrid{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:12px;margin-bottom:12px}.intelGrid .wide{grid-column:span 2}
  .intelTable{overflow:auto}.intelTable table{width:100%;min-width:720px;border-collapse:collapse}.intelTable th{position:static;background:var(--navy);color:#fff;padding:8px 7px;font-size:10px;white-space:nowrap}.intelTable td{border:1px solid #e3e9ef;padding:7px;font-size:10px;text-align:center;white-space:nowrap}.intelTable td:first-child{text-align:left;color:var(--navy);font-weight:800}
  .intelPerson{border:0;background:transparent;color:#0b6fbe;cursor:pointer;font:inherit;font-weight:900;text-decoration:underline;padding:0}.intelPerson:hover{color:var(--orange)}
  .intelStatus{display:inline-block;border-radius:12px;padding:4px 7px;font-size:10px;font-weight:900}.intelStatus.stable{background:#def5e7;color:#087a35}.intelStatus.attention{background:#fff0cf;color:#966400}.intelStatus.deviation{background:#ffe0e0;color:#b21818}.intelStatus.improve{background:#deefff;color:#12629b}
  .intelEmpty{display:flex;align-items:center;justify-content:center;min-height:100px;color:#73879a;font-size:12px;text-align:center;padding:15px}.intelNote{color:#718598;font-size:11px;line-height:1.45;margin:0 0 10px}.intelDetail{margin-top:12px}.intelDetailHeader{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}.intelDetailHeader h3{margin:0;color:var(--navy);font-size:14px}.intelClose{border:0;background:#e9eff4;color:var(--navy);border-radius:6px;padding:6px 9px;font-weight:900;cursor:pointer}.intelDetailChart{height:230px;position:relative}.intelDetailChart canvas{width:100%!important;height:100%!important}.intelMotives{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.intelMotives span{background:#eef5fa;border-radius:12px;padding:5px 8px;color:#47647d;font-size:10px;font-weight:800}
  @media(max-width:1250px){.intelCards{grid-template-columns:repeat(2,1fr)}.intelGrid{grid-template-columns:1fr 1fr}.intelGrid .wide{grid-column:span 2}}
  @media(max-width:760px){.execSubtabs{overflow:auto}.execSubtab{white-space:nowrap}.intelRadar{display:block}.intelRadarPeriod{display:block;margin-top:10px}.intelCards{grid-template-columns:1fr 1fr}.intelGrid{grid-template-columns:1fr}.intelGrid .wide{grid-column:auto}}


  .adminPanel{padding:18px 22px 28px;background:#f7fafc}.adminHeader{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;background:linear-gradient(120deg,#082d51,#0d4770);color:#fff;border-radius:10px;padding:18px;margin-bottom:14px}.adminHeader h2{margin:0;color:#fff;border:0;padding:0}.adminHeader p{margin:5px 0 0;color:#d7e9f5;font-size:11px}.adminHeader select{margin-top:8px;border:1px solid #a9c5d8;border-radius:6px;padding:7px;background:#fff;color:#082d51;font-weight:800;min-width:230px}.adminNav{display:flex;gap:7px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:9px;padding:8px;margin-bottom:14px}.adminNav button{border:1px solid #d4e0e9;background:#f6f9fb;color:var(--navy);border-radius:7px;padding:9px 13px;font-size:11px;font-weight:900;cursor:pointer}.adminNav button.active{background:var(--orange);border-color:var(--orange);color:#fff}.adminArea[hidden]{display:none!important}.adminToolbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:12px}.adminToolbar input{min-width:250px;border:1px solid #cbd7e2;border-radius:7px;padding:10px;background:#fff}.adminUserFilters{display:flex;gap:4px;flex-wrap:wrap}.adminUserFilter{border:1px solid #d4e0e9;background:#f6f9fb;color:var(--navy);border-radius:6px;padding:7px 9px;font-size:10px;font-weight:900;cursor:pointer}.adminUserFilter.active{background:var(--navy);border-color:var(--navy);color:#fff}.adminStatusDot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px;background:#718598}.adminStatusDot.active{background:#00a341}.adminStatusDot.pending{background:#f0ad00}.adminStatusDot.inactive{background:#e52020}.adminStatusDot.unlinked{background:#7b61c9}.adminStatusDot.incomplete{background:#7b61c9}.adminBadge.unlinked{background:#eee6ff;color:#6045a8}.adminUserStatusInfo{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;background:#f7fafc;border-left:4px solid var(--orange);border-radius:7px;padding:10px;margin:0 0 12px;color:#536d82;font-size:11px}.adminUserStatusInfo b{display:block;color:var(--navy);font-size:10px;text-transform:uppercase;margin-bottom:3px}.adminConfigPanel{background:#fff;border:1px solid var(--line);border-radius:9px;padding:16px;margin-bottom:14px;box-shadow:0 2px 8px rgba(9,43,77,.04)}.adminConfigPanel h3{margin:0;color:var(--navy);font-size:15px}.adminConfigIntro{color:#718598;font-size:11px;margin:5px 0 12px}.adminConfigGrid{display:grid;grid-template-columns:1.2fr 1.5fr 1.2fr 1fr .7fr;gap:10px}.adminConfigStatus{font-size:11px;font-weight:800;color:#087a35;min-height:16px;margin-top:10px}.adminConfigStatus.err{color:#b21818}.adminLayout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:14px}.adminUserList,.adminEditor{background:#fff;border:1px solid var(--line);border-radius:9px;box-shadow:0 2px 8px rgba(9,43,77,.04)}.adminUserList{padding:8px;max-height:650px;overflow:auto}.adminUserItem{display:block;width:100%;text-align:left;border:1px solid #e1e8ee;background:#fff;border-radius:7px;padding:10px;margin-bottom:7px;cursor:pointer;color:var(--navy)}.adminUserItem:hover,.adminUserItem.active{border-color:var(--orange);background:#fff8f1}.adminUserItem strong{display:block;font-size:12px}.adminUserItem small{display:block;color:#718598;margin-top:4px;font-size:10px}.adminBadge{display:inline-block;border-radius:12px;padding:3px 7px;font-size:10px;font-weight:900;background:#e8eef5;color:#48647f}.adminBadge.ok{background:#def5e7;color:#087a35}.adminBadge.off{background:#ffe0e0;color:#b21818}.adminEditor{padding:16px}.adminEditor h3{margin:0 0 10px;color:var(--navy);font-size:14px}.adminFormGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}.adminField{display:flex;flex-direction:column;gap:4px}.adminField label,.adminSectionLabel{color:#536d82;font-size:10px;font-weight:900;text-transform:uppercase}.adminField input,.adminField select{border:1px solid #cbd7e2;border-radius:6px;padding:8px;background:#fff}.adminSection{border-top:1px solid #e2e9ef;padding-top:13px;margin-top:13px}.adminOperationList{display:flex;gap:9px;flex-wrap:wrap}.adminCheck{display:flex;align-items:center;gap:6px;border:1px solid #d9e3eb;border-radius:7px;padding:8px;background:#fbfdff;color:var(--navy);font-size:11px}.adminCheck input{accent-color:var(--orange)}.adminPermissionOperation{display:flex;align-items:center;gap:8px;margin:10px 0}.adminPermissionOperation select{border:1px solid #cbd7e2;border-radius:6px;padding:7px;background:#fff}.adminPermTable{width:100%;border-collapse:collapse}.adminPermTable th{background:var(--navy);color:#fff;padding:7px;font-size:10px;text-align:left}.adminPermTable td{border:1px solid #e3e9ef;padding:7px;font-size:11px}.adminPermTable td:not(:first-child){text-align:center;width:170px}.adminPermTable input{accent-color:var(--orange)}.adminPermTable select{border:1px solid #cbd7e2;border-radius:5px;padding:5px;background:#fff;color:var(--navy);font-size:10px}.adminBulk{display:flex;gap:7px;margin:8px 0}.adminBulk button{border:0;background:#e9eff4;color:var(--navy);border-radius:6px;padding:6px 9px;font-size:10px;font-weight:900;cursor:pointer}.adminFooter{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.adminEmpty{padding:25px;text-align:center;color:#718598;font-size:12px}.adminNote{color:#718598;font-size:11px;line-height:1.45;margin:7px 0}.adminStatus{font-size:11px;font-weight:800;color:#087a35}.adminStatus.err{color:#b21818}.adminIndicatorTable{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden}.adminIndicatorTable th{background:var(--navy);color:#fff;padding:8px;font-size:10px;text-align:left}.adminIndicatorTable td{border:1px solid #e3e9ef;padding:8px;font-size:11px}.adminIndicatorTable td:not(:first-child){text-align:center}.adminIndicatorForm{background:#fff;border:1px solid var(--line);border-radius:9px;padding:16px;margin-top:14px}.adminIndicatorForm h3{margin:0 0 12px;color:var(--navy);font-size:14px}.adminIndicatorGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.themeToggle{white-space:nowrap}.actionAssignee{display:block;width:100%;margin-top:4px;border:1px solid #cbd7e2;border-radius:5px;padding:3px;font-size:10px;background:#fff}.completeAction{margin-left:4px}.viewTab[hidden],.adminPanel[hidden]{display:none!important}
  body.dark{--navy:#d8e8f5;--line:#365269;background:#102131;color:#e5eef5}body.dark .wrap,body.dark .viewPanel,body.dark section,body.dark .card,body.dark .execCard,body.dark .intelMetric,body.dark .adminUserList,body.dark .adminEditor{background:#152b3d;color:#e5eef5}body.dark .toolbar{background:#071d31}body.dark .adminPanel{background:#102131}body.dark .adminUserItem,body.dark .adminCheck,body.dark .adminField input,body.dark .adminField select,body.dark .adminToolbar input,body.dark .adminPermissionOperation select,body.dark .actionAssignee,body.dark .adminConfigPanel,body.dark .adminConfigGrid input,body.dark .adminConfigGrid select{background:#193246;color:#e5eef5;border-color:#49647a}body.dark .adminUserItem:hover,body.dark .adminUserItem.active{background:#3c2b20;border-color:var(--orange)}body.dark .adminPermTable td{border-color:#365269}body.dark .execSubtab{background:#193246;color:#d8e8f5;border-color:#365269}
  @media(max-width:800px){.adminLayout{grid-template-columns:1fr}.adminFormGrid,.adminIndicatorGrid{grid-template-columns:1fr}.adminUserList{max-height:260px}}


  .executivePanel{padding:18px 22px 30px;background:#f7fafc}.executiveHeader{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;background:linear-gradient(120deg,#082d51,#0d4770);color:#fff;border-radius:10px;padding:18px;margin-bottom:12px}.executiveHeader h2{margin:0;color:#fff;border:0;padding:0;font-size:22px}.executiveHeader p{margin:5px 0 0;color:#d7e9f5;font-size:11px}.executiveHeaderMeta{text-align:right;color:#d7e9f5;font-size:11px;line-height:1.5}.executiveHeaderMeta strong{display:block;color:#fff;font-size:14px}.executiveToolbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:12px}.executiveToolbar label{display:flex;align-items:center;gap:5px;color:var(--navy);font-size:11px;font-weight:900}.executiveToolbar select{border:1px solid #cbd7e2;border-radius:6px;padding:7px;background:#fff;color:var(--navy)}.executiveStatus{margin-left:auto;font-size:11px;font-weight:800;color:#087a35}.executiveStatus.err{color:#b21818}.executiveCards{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:12px}.executiveMetric{background:#fff;border:1px solid var(--line);border-radius:9px;padding:13px;min-height:82px;box-shadow:0 2px 8px rgba(9,43,77,.04)}.executiveMetric small{display:block;text-transform:uppercase;color:#718598;font-size:9px;font-weight:900;letter-spacing:.04em}.executiveMetric strong{display:block;margin-top:6px;color:var(--navy);font-size:22px;line-height:1.1}.executiveMetric span{display:block;margin-top:4px;color:#718598;font-size:10px}.executiveMetric.good strong{color:#087a35}.executiveMetric.warn strong{color:#966400}.executiveMetric.bad strong{color:#b21818}.executiveGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.executiveCard{background:#fff;border:1px solid var(--line);border-radius:9px;padding:13px;box-shadow:0 2px 8px rgba(9,43,77,.04);min-width:0}.executiveCard.wide{grid-column:span 2}.executiveCard h3{margin:0 0 9px;color:var(--navy);font-size:14px;border-left:3px solid var(--orange);padding-left:8px}.executiveChart{height:260px;position:relative}.executiveChart canvas{width:100%!important;height:100%!important}.executiveTable{overflow:auto}.executiveTable table{width:100%;border-collapse:collapse;min-width:620px}.executiveTable th{background:var(--navy);color:#fff;padding:8px 7px;font-size:10px;text-align:left;white-space:nowrap}.executiveTable td{border:1px solid #e3e9ef;padding:7px;font-size:10px;white-space:nowrap}.executiveTable td:not(:first-child){text-align:center}.executiveBadge{display:inline-block;border-radius:12px;padding:4px 7px;font-size:10px;font-weight:900}.executiveBadge.good{background:#def5e7;color:#087a35}.executiveBadge.warn{background:#fff0cf;color:#966400}.executiveBadge.bad{background:#ffe0e0;color:#b21818}.executiveBadge.muted{background:#edf2f6;color:#60788d}.executiveEmpty{display:flex;align-items:center;justify-content:center;min-height:120px;color:#718598;font-size:12px;text-align:center;padding:16px}.executiveFootnote{margin:8px 0 0;color:#718598;font-size:10px;line-height:1.45}.executiveAccessNote{background:#eef5fa;border-left:3px solid #2d81bb;border-radius:5px;padding:9px;color:#49677f;font-size:11px;margin-bottom:12px}.executivePriority{font-weight:900;color:#b21818}.executiveActionOpen{color:#966400;font-weight:800}
  @media(max-width:1250px){.executiveCards{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.executivePanel{padding:12px}.executiveHeader{display:block}.executiveHeaderMeta{text-align:left;margin-top:10px}.executiveCards{grid-template-columns:repeat(2,1fr)}.executiveGrid{grid-template-columns:1fr}.executiveCard.wide{grid-column:auto}.executiveStatus{margin-left:0}}

</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script><script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script></head>
<body><div id="authOverlay" class="authOverlay"><div class="authBox"><h2 style="border:0;padding:0">PLANO DE SUSTENTAÇÃO MATRIZ</h2><p>Acesso restrito • Mundial Logistics</p><b>E-mail</b><input id="loginEmail" type="email"><b>Senha</b><input id="loginPassword" type="password"><button id="loginButton" onclick="login()">ENTRAR</button><button id="requestPasswordResetButton" class="secondary" style="margin-top:8px" onclick="requestPasswordReset()">CRIAR / RECUPERAR SENHA</button><div id="authError" class="authError"></div></div></div><div id="passwordSetupOverlay" class="authOverlay" style="display:none"><div class="authBox" id="passwordSetupBox"><h2 style="border:0;padding:0">CRIAR NOVA SENHA</h2><p id="passwordSetupLead">Crie uma senha pessoal para acessar o Plano de Sustentação.</p><div id="passwordSetupForm"><b>Nova senha</b><input id="newPassword" type="password" autocomplete="new-password" minlength="8"><b>Confirmar nova senha</b><input id="newPasswordConfirm" type="password" autocomplete="new-password" minlength="8"><button id="saveFirstPasswordButton" onclick="saveFirstPassword()">SALVAR NOVA SENHA</button></div><div id="passwordSetupSuccess" style="display:none"><p style="color:#16803c;font-weight:800;font-size:16px">✓ Senha criada com sucesso</p><p>Sua senha foi atualizada. Agora você pode acessar o Plano de Sustentação.</p><button class="secondary" onclick="finishPasswordSetup()">IR PARA O LOGIN</button></div><div id="passwordSetupError" class="authError"></div></div></div>
<div class="wrap">
<header>
  <div class="brand"><img src="data:image/png;base64," alt="Mundial Logistics"></div>
  <div class="slogan">Fazendo marcas<br>venderem mais</div>
  <div><h1>PLANO DE SUSTENTAÇÃO <span id="operationTitle" class="matrix">MATRIZ</span></h1><div class="sub">Desempenho, disciplina e resultados para um crescimento sustentável.</div></div>
</header>

<div class="toolbar">
  <label class="fileLabel">Importar mês (CSV)<input id="csvFile" type="file" accept=".csv,text/csv"></label>
  <button onclick="downloadTemplate()">Baixar modelo CSV</button>
  <button class="secondary" onclick="saveSupabase()" title="As alterações já são salvas automaticamente; use este botão apenas para forçar uma gravação agora.">Salvar agora</button>
  <button class="secondary" onclick="window.print()">Exportar / Imprimir PDF</button>
  <span>Ano: <select id="yearSelect" class="yearSelect" onchange="changeYear()"></select></span><button id="themeToggle" class="secondary themeToggle" onclick="toggleTheme()">Modo escuro</button><span id="syncStatus" class="syncStatus">Aguardando login</span><button class="secondary" onclick="logout()">Sair</button>
</div>

<div class="viewTabs" role="tablist" aria-label="Operações e análise">
  <button id="tabMatriz" class="viewTab active" onclick="switchOperation('MATRIZ')">MATRIZ</button>
  <button id="tabGLP" class="viewTab" onclick="switchOperation('GLP_ACHE')">GLP – OPERAÇÃO ACHÉ</button>
  <button id="tabAbsenteismo" class="viewTab" onclick="showView('absenteismo')">ANÁLISE DE ABSENTEÍSMO</button>
  <button id="tabExecutive" class="viewTab" onclick="showView('executive')" hidden>VISÃO EXECUTIVA</button>
  <button id="tabAdmin" class="viewTab" onclick="showView('admin')" hidden>ADMINISTRAÇÃO</button>
</div>

<div id="viewPlano" class="viewPanel active">
<div class="meta">
 <div class="card"><b>Responsável</b><span id="operationResponsible">Willian Soares</span></div>
 <div class="card"><b>Polaridade</b><span id="operationPolarity" style="font-size:15px">Atingir as metas propostas em pelo menos 8 itens</span></div>
 <div class="card"><b>Objetivo</b><span id="operationObjective" style="font-size:15px">Atendimento aos SLA/metas</span></div>
 <div class="card"><b>Formato de Cálculo</b><span id="operationFormat">#</span></div>
 <div class="card"><b>Peso</b><span id="operationWeight">10%</span></div>
</div>

<section>
<div class="monitoringHeader"><h2 id="monitoringTitle">MONITORAMENTO DOS INDICADORES MATRIZ</h2><button id="newIndicatorButton" class="secondary" onclick="toggleIndicatorCreate(true)" hidden>+ Novo indicador</button></div>
<div id="indicatorCreatePanel" class="indicatorCreatePanel" hidden>
  <strong><span id="indicatorCreateMode">Cadastrar indicador em</span> <span id="indicatorCreateOperation">Matriz</span></strong>
  <form id="indicatorCreateForm" class="indicatorCreateForm" onsubmit="createIndicator(event)">
    <div class="indicatorCreateField"><label for="newIndicatorName">Indicador</label><input id="newIndicatorName" required maxlength="120" placeholder="Nome do indicador"></div>
    <div class="indicatorCreateField"><label for="newIndicatorMeta">Meta</label><input id="newIndicatorMeta" type="number" step="0.01" required placeholder="0"></div>
    <div class="indicatorCreateField"><label for="newIndicatorWeight">Peso (%)</label><input id="newIndicatorWeight" type="number" min="0" max="100" step="0.01" required placeholder="0"></div>
    <div class="indicatorCreateField"><label for="newIndicatorPolarity">Polaridade</label><select id="newIndicatorPolarity"><option value="MAIOR">Maior é melhor</option><option value="MENOR">Menor é melhor</option></select></div>
    <div class="indicatorCreateField"><label for="newIndicatorFormat">Formato</label><select id="newIndicatorFormat"><option value="PERCENT">Percentual</option><option value="NUMBER">Número</option><option value="CURRENCY">Moeda (R$)</option></select></div>
    <div class="indicatorCreateField"><label for="newIndicatorStatus">Status</label><select id="newIndicatorStatus"><option value="true">Ativo</option><option value="false">Inativo</option></select></div>
    <button id="indicatorCreateSubmit" type="submit">Cadastrar</button><button type="button" class="secondary" onclick="toggleIndicatorCreate(false)">Cancelar</button>
    <div id="indicatorCreateStatus" class="indicatorCreateStatus"></div>
  </form>
</div>
<div class="tableWrap"><table id="kpiTable"><thead><tr>
<th>Indicador</th><th>Peso</th><th>Meta</th>
<th>janeiro</th><th>fevereiro</th><th>março</th><th>abril</th><th>maio</th><th>junho</th><th>julho</th><th>agosto</th><th>setembro</th><th>outubro</th><th>novembro</th><th>dezembro</th>
</tr></thead><tbody></tbody></table></div>
</section>

<section id="slaNeologSection" class="slaNeologSection" hidden>
  <h2>MONITORAMENTO SLA NEOLOG – PONTUAÇÃO</h2>
  <p class="slaNeologNote">Quadro exclusivo da operação GLP – Aché. Informe a pontuação mensal; o campo <b>Acumulado</b> é calculado automaticamente. A linha Resultado final soma os pontos preenchidos dos indicadores de pontuação e não recebe valor manual.</p>
  <div class="tableWrap"><table id="slaNeologTable" class="slaNeologTable"><thead><tr><th>Indicador</th><th>janeiro</th><th>fevereiro</th><th>março</th><th>abril</th><th>maio</th><th>junho</th><th>julho</th><th>agosto</th><th>setembro</th><th>outubro</th><th>novembro</th><th>dezembro</th><th>Acumulado</th></tr></thead><tbody></tbody></table></div>
</section>

<div class="summary">
 <div class="card"><h2>RESUMO DO PERÍODO</h2><div id="summary"></div></div>
 <div class="card"><h2>DESTAQUES DO MÊS</h2><div id="highlights"></div></div>
 <div class="card"><h2>PONTOS DE ATENÇÃO</h2><div id="alerts"></div></div>
</div>

<section>
<h2 id="actionTitle">PLANO DE AÇÃO - SUSTENTAÇÃO MATRIZ</h2>
<div class="actionTools"><button onclick="addActionRow()">+ Incluir nova linha</button><button class="secondary" onclick="saveLocal()">Salvar alterações</button></div>
<div class="tableWrap"><table class="actions" id="actionTable"><thead><tr><th>ID</th><th>AÇÃO</th><th>RESPONSÁVEL</th><th>DT. INIC</th><th>DT. FIM</th><th>STATUS</th><th>Obs</th><th>Excluir</th></tr></thead><tbody>
<tr><td>1</td><td contenteditable="true">Criar áreas de picking fracionada com os carrinhos de separação (preparo do projeto)</td><td contenteditable="true">Soares</td><td contenteditable="true">14/04/2026</td><td contenteditable="true">30/06/2026</td><td contenteditable="true">Projeto em fase de análise de viabilidade</td><td contenteditable="true"></td><td><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td></tr>
<tr><td>2</td><td contenteditable="true">Automação da conferencia 100% e cintamento da Nivea (preparo do projeto)</td><td contenteditable="true">Soares</td><td contenteditable="true">14/04/2026</td><td contenteditable="true">30/06/2026</td><td contenteditable="true">Falamos com dois fornecedores especialistas em automação, porém nenhum deles conseguiu apresentar uma solução aderente ao negócio.</td><td contenteditable="true"></td><td><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td></tr>
<tr><td>3</td><td contenteditable="true">Implantação da Mogalog</td><td contenteditable="true">Soares</td><td contenteditable="true">15/04/2026</td><td contenteditable="true"></td><td contenteditable="true"></td><td contenteditable="true"></td><td><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td></tr>
<tr><td>4</td><td contenteditable="true">Incremento do quadro operacional</td><td contenteditable="true">Hellry e Fernando</td><td contenteditable="true">25/08/2026</td><td contenteditable="true"></td><td contenteditable="true"></td><td contenteditable="true"></td><td><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td></tr>
<tr><td>5</td><td contenteditable="true">Implantação do mobile - modulo separação</td><td contenteditable="true">Soares</td><td contenteditable="true">01/08/2024</td><td contenteditable="true"></td><td contenteditable="true"></td><td contenteditable="true"></td><td><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td></tr>
</tbody></table></div>
</section>

</div>

<div id="viewExecutive" class="viewPanel">
  <section class="executivePanel">
    <div class="executiveHeader">
      <div><span class="execEyebrow" style="color:#b9d7ea">Consolidação autorizada</span><h2>VISÃO EXECUTIVA</h2><p>Resumo gerencial da operação ativa, com dados consolidados do Plano de Sustentação, SLA NEOLOG, planos de ação e Absenteísmo.</p></div>
      <div id="executiveHeaderMeta" class="executiveHeaderMeta"><strong>Carregando operação</strong>Somente leitura</div>
    </div>
    <div class="executiveToolbar">
      <label>Mês<select id="executiveMonth" onchange="executiveMonthChange()"><option value="0">Último mês com dados</option></select></label>
      <button class="secondary" onclick="loadExecutiveData()">Atualizar visão</button>
      <span id="executiveStatus" class="executiveStatus">Aguardando dados</span>
    </div>
    <div id="executiveAccessNote" class="executiveAccessNote" hidden></div>
    <div id="executiveCards" class="executiveCards"></div>
    <div class="executiveGrid">
      <article class="executiveCard wide"><h3>Evolução da Performance Ponderada</h3><div class="executiveChart"><canvas id="executivePerformanceTrend"></canvas></div><p class="executiveFootnote">Índice calculado a partir dos indicadores com resultado no mês, respeitando peso e polaridade cadastrados.</p></article>
      <article class="executiveCard"><h3>Situação dos Indicadores</h3><div class="executiveChart"><canvas id="executiveStatusChart"></canvas></div></article>
      <article class="executiveCard"><h3>Performance por Indicador</h3><div class="executiveChart"><canvas id="executiveIndicatorChart"></canvas></div></article>
      <article id="executiveAbsCard" class="executiveCard"><h3>Tendência de Absenteísmo</h3><div id="executiveAbsEmpty" class="executiveEmpty" hidden></div><div class="executiveChart"><canvas id="executiveAbsChart"></canvas></div></article>
      <article id="executiveSlaCard" class="executiveCard"><h3>Pontuação SLA NEOLOG</h3><div id="executiveSlaEmpty" class="executiveEmpty" hidden></div><div class="executiveChart"><canvas id="executiveSlaChart"></canvas></div></article>
      <article class="executiveCard"><h3>Ações por Status</h3><div class="executiveChart"><canvas id="executiveActionsChart"></canvas></div></article>
      <article class="executiveCard wide"><h3>Indicadores e Ações Prioritárias</h3><div id="executiveIndicatorsTable" class="executiveTable"></div></article>
      <article class="executiveCard wide"><h3>Planos de Ação em Acompanhamento</h3><div id="executiveActionsTable" class="executiveTable"></div></article>
    </div>
  </section>
</div>

<div id="viewAbsenteismo" class="viewPanel">
  <section class="execAbs">
    <div class="execAbsHeader">
      <div><span class="execEyebrow">Performance operacional</span><h2>Análise de Absenteísmo</h2><p class="execSubtitle">Visão executiva de horas improdutivas, evolução mensal e principais pontos de atenção.</p></div>
      <div id="absExecStatus" class="execAbsStatus">Aguardando login</div>
    </div>
    <div class="execFilters">
      <label>Ano<select id="absYear" onchange="absYearChange()"></select></label>
      <label>Mês<select id="absMonth" onchange="absMonthChange()"></select></label>
      <label>Local<select id="absLocalFilter" onchange="absFilterChange()"><option value="">Todos os locais</option></select></label>
      <label>Área<select id="absAreaFilter" onchange="absFilterChange()"><option value="">Todas as áreas</option></select></label><label>Centro de custo<select id="absCenterFilter" onchange="absFilterChange()"><option value="">Todos os centros</option></select></label>
      <label>Jornada upload<input id="absDailyHours" type="number" min="0.1" max="24" step="0.1" value="8" onchange="absRecalculate()"></label>
      <button class="secondary" onclick="absLoadSupabase()">Atualizar dados</button>
      <label class="execFile">Importar planilha<input id="absFile" type="file" accept=".xlsx,.xls,.csv,text/csv" onchange="absHandleFile(event)"></label>
      <button class="secondary" onclick="absDownloadCSV()">Exportar CSV</button>
      <span id="absStatus" class="syncStatus execStatus">Aguardando dados</span>
    </div>
    <div class="execSubtabs" role="tablist" aria-label="Subabas da análise de absenteísmo">
      <button id="absSubtabDashboard" class="execSubtab active" onclick="absShowSubtab('dashboard')">Painel executivo</button>
      <button id="absSubtabIntel" class="execSubtab" onclick="absShowSubtab('intel')">Inteligência de desvios</button>
    </div>
    <div id="absSubpanelDashboard" class="execSubpanel active">
      <div id="absKpis" class="execKpis"></div>
      <div class="execGrid">
        <article class="execCard wide"><h3>Evolução do Absenteísmo (%)</h3><div id="absMetaNote" class="execChartNote"></div><div class="execChart"><canvas id="absTrendPctChart"></canvas></div></article>
        <article class="execCard"><h3>Distribuição por Motivo</h3><div class="execChart"><canvas id="absReasonsChart"></canvas></div></article>
        <article class="execCard"><h3>Top 10 Colaboradores — Horas Improdutivas</h3><div class="execChart"><canvas id="absTopChart"></canvas></div></article>
        <article class="execCard"><h3>Absenteísmo por Área / Centro de Custo</h3><div class="execChart"><canvas id="absAreaChart"></canvas></div></article>
        <article class="execCard wide"><h3>Tendência de Horas Improdutivas</h3><div id="absProjectionNote" class="execChartNote"></div><div class="execChart"><canvas id="absHoursTrendChart"></canvas></div></article>
      </div>
      <div class="execBottom">
        <article class="execCard"><h3>Resumo por Centro de Custo</h3><div id="absCostCenters" class="execTable"></div></article>
        <article class="execCard"><h3>Indicadores e Ações</h3><div id="absActions" class="execTable"></div></article>
      </div>
    </div>
    <div id="absSubpanelIntel" class="execSubpanel">
      <div class="intelRadar"><div><h3>Radar de Pessoas</h3><p>Indicadores gerenciais de mudança de comportamento em relação ao próprio histórico. Não são diagnósticos nem conclusões sobre a causa.</p></div><span id="absIntelPeriod" class="intelRadarPeriod">Sem período carregado</span></div>
      <div id="absIntelCards" class="intelCards"></div>
      <div class="intelGrid">
        <article class="execCard wide"><h3>Alertas de Desvio de Absenteísmo</h3><p class="intelNote">A classificação prioriza mudança individual, recorrência e comparação com a média histórica do colaborador.</p><div id="absDeviationTable" class="intelTable"></div></article>
        <article class="execCard"><h3>Novos Desvios do Mês</h3><div id="absNewDeviationTable" class="intelTable"></div></article>
        <article class="execCard"><h3>Desvios Recorrentes</h3><div id="absRecurringTable" class="intelTable"></div></article>
      </div>
      <article id="absPersonDetailCard" class="execCard intelDetail" style="display:none"><div class="intelDetailHeader"><h3 id="absPersonDetailTitle">Detalhe do colaborador</h3><button class="intelClose" onclick="absClosePerson()">Fechar</button></div><div id="absPersonDetail"></div></article>
    </div>
  </section>
</div>


<div id="viewAdmin" class="viewPanel">
  <section class="adminPanel">
    <div class="adminHeader"><div><span class="execEyebrow" style="color:#b9d7ea">Central Administrativa</span><h2>ADMINISTRAÇÃO</h2><p>Gestão independente de operações, usuários, indicadores e permissões.</p><label style="display:block;color:#d7e9f5;font-size:10px;font-weight:900;text-transform:uppercase;margin-top:10px">Administrando:<select id="adminCentralOperation" onchange="adminSelectCentralOperation(this.value)"></select></label></div><span id="adminHeaderStatus" class="adminStatus" style="color:#d7f5e2">Escopo validado</span></div>
    <nav class="adminNav" aria-label="Áreas da Central Administrativa"><button id="adminNavOperations" onclick="adminOpenArea('operations')">Operações</button><button id="adminNavUsers" onclick="adminOpenArea('users')">Usuários</button><button id="adminNavIndicators" onclick="adminOpenArea('indicators')">Indicadores</button><button id="adminNavPermissions" onclick="adminOpenArea('permissions')">Permissões</button></nav>
    <section id="adminAreaOperations" class="adminArea">
      <section id="adminOperationConfig" class="adminConfigPanel"><h3>CONFIGURAÇÕES DA OPERAÇÃO</h3><p class="adminConfigIntro">Parâmetros exibidos nos cards superiores. Cada operação mantém sua própria configuração.</p><div class="adminPermissionOperation"><span>Operação:</span><select id="adminConfigOperation" onchange="adminSelectOperationConfig(Number(this.value))"></select></div><div class="adminConfigGrid"><div class="adminField"><label for="adminConfigResponsible">Responsável</label><select id="adminConfigResponsible"></select></div><div class="adminField"><label for="adminConfigPolarity">Polaridade</label><input id="adminConfigPolarity" maxlength="200" placeholder="Ex.: Atingir as metas propostas"></div><div class="adminField"><label for="adminConfigObjective">Objetivo</label><input id="adminConfigObjective" maxlength="200" placeholder="Objetivo da operação"></div><div class="adminField"><label for="adminConfigFormat">Formato de Cálculo</label><input id="adminConfigFormat" maxlength="80" placeholder="#"></div><div class="adminField"><label for="adminConfigWeight">Peso (%)</label><input id="adminConfigWeight" type="number" min="0" max="100" step="0.01" placeholder="10"></div></div><div id="adminConfigStatus" class="adminConfigStatus"></div><div class="adminFooter"><button class="secondary" onclick="adminCancelOperationConfig()">Cancelar</button><button onclick="adminSaveOperationConfig()">Salvar configurações</button></div></section>
      <section class="adminConfigPanel"><h3>OPERAÇÕES DISPONÍVEIS</h3><p class="adminNote">O Super Administrador pode criar e inativar operações. A troca de operação de indicadores e históricos é bloqueada no banco.</p><button id="adminNewOperationButton" onclick="adminNewOperation()">+ Nova operação</button><div id="adminOperationsCatalog" class="adminEmpty">Carregando operações...</div><form id="adminOperationForm" class="adminIndicatorForm" onsubmit="adminSaveOperation(event)" hidden><h3>Nova operação</h3><div class="adminIndicatorGrid"><div class="adminField"><label>Código</label><input id="adminOperationCode" required maxlength="40" placeholder="Ex.: NOVO_CD"></div><div class="adminField"><label>Nome</label><input id="adminOperationName" required maxlength="120" placeholder="Nome da operação"></div><div class="adminField"><label>Responsável inicial</label><select id="adminOperationResponsible"></select></div></div><div class="adminFooter"><button type="button" class="secondary" onclick="adminCancelOperation()">Cancelar</button><button type="submit">Criar operação</button></div></form></section>
    </section>
    <section id="adminAreaUsers" class="adminArea" hidden><div class="adminToolbar"><input id="adminUserSearch" placeholder="Buscar usuário..." oninput="adminRenderUserList()"><div class="adminUserFilters" role="group" aria-label="Filtro de usuários"><button type="button" class="adminUserFilter active" data-status="all" onclick="adminSetUserFilter('all')">Todos (<span id="adminCountAll">0</span>)</button><button type="button" class="adminUserFilter" data-status="active" onclick="adminSetUserFilter('active')">Ativos (<span id="adminCountActive">0</span>)</button><button type="button" class="adminUserFilter" data-status="pending" onclick="adminSetUserFilter('pending')">Convites pendentes (<span id="adminCountPending">0</span>)</button><button type="button" class="adminUserFilter" data-status="unlinked" onclick="adminSetUserFilter('unlinked')">Pendentes de vínculo (<span id="adminCountUnlinked">0</span>)</button><button type="button" class="adminUserFilter" data-status="inactive" onclick="adminSetUserFilter('inactive')">Bloqueados (<span id="adminCountInactive">0</span>)</button></div><button onclick="adminNewUser()">+ Novo usuário</button><span id="adminStatus" class="adminStatus"></span></div><div class="adminLayout"><div id="adminUserList" class="adminUserList"></div><div id="adminEditor" class="adminEditor" hidden><h3>Dados do usuário</h3><div id="adminUserStatusInfo" class="adminUserStatusInfo"></div><div class="adminFormGrid"><div class="adminField"><label>Nome</label><input id="adminName"></div><div class="adminField"><label>E-mail</label><input id="adminEmail" type="email"></div><div class="adminField"><label>Perfil</label><select id="adminProfile" onchange="adminRenderPermissionPanels()"><option value="super_admin">Super Administrador</option><option value="administrador_operacao">Administrador da Operação</option><option value="coordenador">Coordenador</option><option value="usuario">Usuário</option></select></div><div class="adminField"><label>Status</label><select id="adminActive"><option value="true">Ativo</option><option value="false">Inativo</option></select></div></div><div class="adminSection"><div class="adminSectionLabel">Operações autorizadas</div><div id="adminOperationList" class="adminOperationList"></div></div><div class="adminSection"><div class="adminSectionLabel">Permissões por módulo</div><div class="adminPermissionOperation"><span>Configurar operação:</span><select id="adminPermissionOperation" onchange="adminSetFocusOperation(Number(this.value))"></select></div><div id="adminModulePermissions"></div></div><div class="adminSection"><div class="adminSectionLabel">Permissões por indicador</div><div id="adminIndicatorPermissions"></div></div><div class="adminSection"><div class="adminSectionLabel">Plano de Ação</div><div id="adminActionPermissions"></div></div><div class="adminFooter"><button class="secondary" onclick="adminCancelUser()">Cancelar</button><button id="adminResendInviteButton" class="secondary" onclick="adminResendInvite()" hidden>Reenviar convite</button><button id="adminSaveUserButton" onclick="adminSaveUser()">Salvar permissões</button></div></div></div></section>
    <section id="adminAreaIndicators" class="adminArea" hidden><div class="adminToolbar"><button onclick="adminNewIndicator()">+ Novo indicador</button><span id="adminIndicatorStatus" class="adminStatus"></span></div><div id="adminIndicatorCatalog"></div><form id="adminIndicatorForm" class="adminIndicatorForm" onsubmit="adminSaveIndicator(event)" hidden><h3><span id="adminIndicatorFormTitle">Cadastrar indicador</span></h3><div class="adminIndicatorGrid"><div class="adminField"><label>Nome</label><input id="adminIndicatorName" required maxlength="120"></div><div class="adminField"><label>Polaridade</label><select id="adminIndicatorPolarity"><option value="MAIOR">Maior é melhor</option><option value="MENOR">Menor é melhor</option></select></div><div class="adminField"><label>Objetivo</label><input id="adminIndicatorObjective" maxlength="240"></div><div class="adminField"><label>Formato de cálculo</label><select id="adminIndicatorFormat"><option value="PERCENT">Percentual</option><option value="NUMBER">Número</option><option value="CURRENCY">Moeda (R$)</option></select></div><div class="adminField"><label>Peso (%)</label><input id="adminIndicatorWeight" type="number" min="0" max="100" step="0.01" required></div><div class="adminField"><label>Meta</label><input id="adminIndicatorMeta" type="number" step="0.01" required></div><div class="adminField"><label>Periodicidade</label><input id="adminIndicatorPeriodicity" maxlength="80" placeholder="Mensal"></div><div class="adminField"><label>Responsável</label><select id="adminIndicatorResponsible"></select></div><div class="adminField"><label>Status</label><select id="adminIndicatorActive"><option value="true">Ativo</option><option value="false">Inativo</option></select></div></div><div class="adminFooter"><button type="button" class="secondary" onclick="adminCancelIndicator()">Cancelar</button><button type="submit">Salvar indicador</button></div></form></section>
    <section id="adminAreaPermissions" class="adminArea" hidden><div class="adminConfigPanel"><h3>MATRIZ DE PERMISSÕES</h3><p class="adminNote">Selecione um usuário na área Usuários para configurar os níveis Visualizar, Lançar resultado, Editar e Administrar por módulo e indicador. As permissões são revalidadas pelo Supabase/RLS.</p><button onclick="adminOpenArea('users')">Abrir gestão de usuários e permissões</button></div></section>
  </section>
</div>

<footer><span>PESSOAS QUE FAZEM A DIFERENÇA</span><span>PROCESSOS MAIS EFICIENTES</span><span>SOLUÇÕES QUE GERAM VALOR</span><span>OPERAÇÕES MAIS SUSTENTÁVEIS</span></footer>
</div>
<script>
const months=["janeiro","fevereiro","março","abril","maio","junho","julho","agosto","setembro","outubro","novembro","dezembro"];

const ADMIN_MODULES=[['PLANO_SUSTENTACAO','Plano de Sustentação'],['SLA_NEOLOG','Pontuação SLA NEOLOG'],['ABSENTEISMO','Análise de Absenteísmo'],['PLANO_ACAO','Plano de Ação'],['INVENTARIOS','Inventários'],['VISAO_EXECUTIVA','Visão Executiva']];
let currentUserId=null;
let currentUserIsAdmin=false;
let currentUserIsOperationAdmin=false;
let currentUserProfile='usuario';
let currentUserOperationIds=new Set();
let currentPermissions={modules:{},indicators:{},actions:{}};
let adminUsers=[],adminUserOperations=[],adminUserModules=[],adminUserIndicators=[],adminUserActions=[],adminIndicatorCatalog=[],adminDraft=null,adminFocusOperationId=null,adminOperationConfigs={},adminConfigOperationId=null,adminCentralOperationId=null,adminArea='operations',adminIndicatorEditingId=null;
let adminUserFilter='all';
let adminInviteBusy=false;
let passwordRequestBusy=false;
let firstPasswordBusy=false;
let passwordRecoveryActive=false;
let passwordRequestCooldownUntil=0;
const ACCESS_LEVELS=[['NENHUM','Sem acesso'],['VISUALIZAR','Visualizar'],['LANCAR_RESULTADO','Lançar resultado'],['EDITAR','Editar'],['ADMINISTRAR','Administrar']];
function permKey(operationId,value){return `${operationId}:${value}`}
function adminCanUseCentral(){return currentUserIsAdmin||currentUserIsOperationAdmin}
function effectiveAccessLevel(p){if(!p)return 'NENHUM';if(p.nivel_acesso)return p.nivel_acesso;if(p.pode_editar)return 'EDITAR';if(p.pode_visualizar)return 'VISUALIZAR';return 'NENHUM'}
function accessAllows(p,action='VIEW'){const level=effectiveAccessLevel(p);if(action==='ADMIN')return level==='ADMINISTRAR';if(action==='EDIT')return ['EDITAR','ADMINISTRAR'].includes(level);if(action==='LANCAR_RESULTADO')return ['LANCAR_RESULTADO','EDITAR','ADMINISTRAR'].includes(level);return level!=='NENHUM'}
function canModule(operationId,module,action='VIEW'){if(currentUserIsAdmin||currentUserIsOperationAdmin&&currentUserOperationIds.has(Number(operationId)))return true;const p=currentPermissions.modules[permKey(operationId,module)];return accessAllows(p,action)}
function canIndicator(name,action='VIEW'){if(currentUserIsAdmin||currentUserIsOperationAdmin&&currentUserOperationIds.has(Number(activeOperationId)))return true;const meta=indicatorMeta[name],id=meta?.id||indicatorIdMap[name];if(!id)return false;const p=currentPermissions.indicators[permKey(activeOperationId,id)];return accessAllows(p,action)}
function canLaunchIndicator(name){return canModule(activeOperationId,'PLANO_SUSTENTACAO','LANCAR_RESULTADO')&&canIndicator(name,'LANCAR_RESULTADO')}
function canEditIndicator(name){return canModule(activeOperationId,'PLANO_SUSTENTACAO','EDIT')&&canIndicator(name,'EDIT')}
function canEditInventory(name){return canModule(activeOperationId,'INVENTARIOS','EDIT')&&canIndicator(name,'EDIT')}
function canAction(action='VIEW',operationId=activeOperationId){if(currentUserIsAdmin||currentUserIsOperationAdmin&&currentUserOperationIds.has(Number(operationId)))return true;const p=currentPermissions.actions[operationId];if(!p)return false;return !!p[{VIEW:'pode_visualizar',CREATE:'pode_criar',EDIT:'pode_editar',STATUS:'pode_alterar_status',CONCLUDE:'pode_concluir',DELETE:'pode_excluir'}[action]||'pode_visualizar']}
function slaMainName(name){return name==='Ocorrências Fora do Prazo'?'Ocorrências Monitoramento':name}
function canSlaItem(item,action='VIEW'){if(!canModule(activeOperationId,'SLA_NEOLOG',action))return false;return item.final||canIndicator(slaMainName(item.name),action)}
function slaVisibleIndicators(action='VIEW'){return slaNeologIndicators.filter(item=>canSlaItem(item,action))}
function handleAuthRedirectFeedback(){const hash=window.location.hash||"",params=new URLSearchParams(hash.startsWith("#")?hash.slice(1):hash),code=params.get("error_code"),description=params.get("error_description");if(!code&&!description)return;const messages={otp_expired:"Este link de confirmação expirou ou já foi utilizado. Solicite ao administrador um novo convite."};const el=document.getElementById("authError");if(el)el.textContent=messages[code]||decodeURIComponent((description||"Não foi possível concluir a confirmação do e-mail.").replace(/\+/g," "));const overlay=document.getElementById("authOverlay");if(overlay)overlay.style.display="flex";if(window.history?.replaceState)window.history.replaceState(null,document.title,window.location.pathname+window.location.search)}
async function loadMyPermissions(){currentPermissions={modules:{},indicators:{},actions:{}};if(currentUserIsAdmin)return;const [m,i,a]=await Promise.all([sb.from('sustentacao_usuario_modulos').select('operacao_id,modulo,nivel_acesso,pode_visualizar,pode_lancar_resultado,pode_editar,pode_administrar').eq('user_id',currentUserId).eq('ativo',true).limit(500),sb.from('sustentacao_usuario_indicadores').select('operacao_id,indicador_id,nivel_acesso,pode_visualizar,pode_lancar_resultado,pode_editar,pode_administrar').eq('user_id',currentUserId).eq('ativo',true).limit(2000),sb.from('sustentacao_usuario_plano_acao').select('operacao_id,pode_visualizar,pode_criar,pode_editar,pode_alterar_status,pode_concluir,pode_excluir').eq('user_id',currentUserId).eq('ativo',true).limit(100)]);if(m.error)throw m.error;if(i.error)throw i.error;if(a.error)throw a.error;(m.data||[]).forEach(x=>currentPermissions.modules[permKey(x.operacao_id,x.modulo)]=x);(i.data||[]).forEach(x=>currentPermissions.indicators[permKey(x.operacao_id,x.indicador_id)]=x);(a.data||[]).forEach(x=>currentPermissions.actions[x.operacao_id]=x)}
function applyPermissionUI(){const tabAdmin=document.getElementById('tabAdmin');if(tabAdmin)tabAdmin.hidden=!adminCanUseCentral();const absTab=document.getElementById('tabAbsenteismo');if(absTab)absTab.hidden=!canModule(activeOperationId,'ABSENTEISMO','VIEW');const executiveTab=document.getElementById('tabExecutive');if(executiveTab)executiveTab.hidden=!canModule(activeOperationId,'VISAO_EXECUTIVA','VIEW');document.querySelectorAll('#kpiTable td[contenteditable]').forEach(td=>{const ok=canLaunchIndicator(td.dataset.r);td.contentEditable=String(ok);td.classList.toggle('editable',ok)});document.querySelectorAll('#kpiTable .detailRow').forEach(row=>{const name=row.dataset.indicator,ok=canEditIndicator(name)||canEditInventory(name);row.querySelectorAll('[contenteditable]').forEach(el=>{el.contentEditable=String(ok);el.disabled=!ok});row.querySelectorAll('.addClient,.removeClient').forEach(el=>el.style.display=canEditInventory(name)?'':'none')});const actionEdit=canAction('EDIT'),actionStatus=canAction('STATUS'),actionConclude=canAction('CONCLUDE');document.querySelectorAll('#actionTable tbody tr').forEach(tr=>{[1,2,3,4,6].forEach(i=>{if(tr.cells[i])tr.cells[i].contentEditable=String(actionEdit)});if(tr.cells[5])tr.cells[5].contentEditable=String(actionEdit||actionStatus);const complete=tr.querySelector('.completeAction');if(complete)complete.style.display=actionConclude?'':'none';const del=tr.querySelector('.deleteRow');if(del)del.style.display=canAction('DELETE')?'':'none'});const add=document.querySelector('#actionTable')?.parentElement?.previousElementSibling?.querySelector('button');if(add)add.style.display=canAction('CREATE')?'':'none';const newIndicator=document.getElementById('newIndicatorButton');if(newIndicator){const allowed=canModule(activeOperationId,'PLANO_SUSTENTACAO','ADMIN');newIndicator.hidden=!allowed;newIndicator.style.display=allowed?'':'none';document.querySelectorAll('.indicatorEditButton').forEach(button=>button.style.display=allowed?'':'none')}document.querySelectorAll('#slaNeologTable .slaEditable').forEach(td=>{const ok=canSlaItem({name:td.dataset.name},'LANCAR_RESULTADO');td.contentEditable=String(ok);td.classList.toggle('editable',ok)})}
function updateTheme(){const dark=localStorage.getItem('dashboardTheme')==='dark';document.body.classList.toggle('dark',dark);const b=document.getElementById('themeToggle');if(b)b.textContent=dark?'Modo claro':'Modo escuro'}
function toggleTheme(){localStorage.setItem('dashboardTheme',localStorage.getItem('dashboardTheme')==='dark'?'light':'dark');updateTheme()}
updateTheme();
function adminStatus(text,err=false){const e=document.getElementById('adminStatus');if(e){e.textContent=text;e.className='adminStatus'+(err?' err':'')}}
function adminDraftDefaults(){return {userId:null,email:'',nome:'',perfil:'usuario',ativo:true,operations:new Set(),modules:{},indicators:{},actions:{},authStatus:'new',resendApplicable:false,invitedAt:null,lastInviteAt:null,lastSignInAt:null}}
function adminNewUser(){adminOpenArea('users');adminDraft=adminDraftDefaults();adminFocusOperationId=adminOperations[0]?.id||null;adminRenderEditor()}
function adminCancelUser(){adminDraft=null;const e=document.getElementById('adminEditor');if(e)e.hidden=true}
function adminProfileLabel(profile){return ({admin:'Super Administrador',super_admin:'Super Administrador',gestor:'Administrador da Operação',administrador_operacao:'Administrador da Operação',coordenador:'Coordenador',usuario:'Usuário'})[profile]||profile||'Usuário'}
function adminStatusLabel(status){return ({active:'Ativo',pending:'Convite pendente',unlinked:'Pendente de vínculo',inactive:'Bloqueado',incomplete:'Cadastro incompleto',new:'Novo cadastro'})[status]||'Cadastro incompleto'}
function adminStatusClass(status){return status==='active'?'ok':status==='inactive'?'off':status==='pending'?'pending':status==='unlinked'?'unlinked':'incomplete'}
function adminAuthStatus(u){if(!u)return 'incomplete';if(!u.linked)return 'unlinked';if(!u.ativo)return 'inactive';const confirmed=!!(u.email_confirmed_at||u.confirmed_at);const firstAccess=!!u.first_access_completed||!!u.legacy_compatible_active;return confirmed&&firstAccess?'active':'pending'}
function adminAuthStatusDot(status){return status==='active'?'active':status==='inactive'?'inactive':status==='pending'?'pending':status==='unlinked'?'unlinked':'incomplete'}
function adminResendAvailable(u){return !!u?.user_id&&!u.email_confirmed_at&&!u.confirmed_at}
function adminDateTime(value){if(!value)return '—';const d=new Date(value);return Number.isNaN(d.getTime())?'—':d.toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'})}
function adminSetUserFilter(filter){adminUserFilter=filter;document.querySelectorAll('.adminUserFilter').forEach(button=>button.classList.toggle('active',button.dataset.status===filter));adminRenderUserList()}
function adminUserMatchesFilter(u,status){return adminUserFilter==='all'||adminUserFilter===status}
function adminRenderUserList(){const box=document.getElementById('adminUserList');if(!box)return;const term=(document.getElementById('adminUserSearch')?.value||'').toLowerCase().trim();adminUsers.forEach(u=>{u.adminStatus=adminAuthStatus(u);u.resendApplicable=adminResendAvailable(u)});const scoped=adminCentralOperationId?adminUsers.filter(u=>adminUserOperations.some(x=>x.user_id===u.user_id&&x.operacao_id===adminCentralOperationId&&x.ativo)):adminUsers;const counts={all:scoped.length,active:scoped.filter(u=>u.adminStatus==='active').length,pending:scoped.filter(u=>u.adminStatus==='pending').length,unlinked:scoped.filter(u=>u.adminStatus==='unlinked').length,inactive:scoped.filter(u=>u.adminStatus==='inactive').length};Object.entries({adminCountAll:counts.all,adminCountActive:counts.active,adminCountPending:counts.pending,adminCountUnlinked:counts.unlinked,adminCountInactive:counts.inactive}).forEach(([id,value])=>{const el=document.getElementById(id);if(el)el.textContent=value});const items=scoped.filter(u=>adminUserMatchesFilter(u,u.adminStatus)).filter(u=>`${u.nome||''} ${u.email||''} ${u.perfil||''} ${adminStatusLabel(u.adminStatus)}`.toLowerCase().includes(term));box.innerHTML=items.length?items.map(u=>{const status=u.adminStatus;return `<button class="adminUserItem ${adminDraft?.userId===u.user_id?'active':''}" onclick="adminOpenUser('${u.user_id}')"><strong><span class="adminStatusDot ${adminAuthStatusDot(status)}"></span>${esc(u.nome||u.email)}</strong><small>${esc(u.email)} · ${adminProfileLabel(u.perfil)} · <span class="adminBadge ${adminStatusClass(status)}">${adminStatusLabel(status)}</span></small></button>`}).join(''):'<div class="adminEmpty">Nenhum usuário encontrado neste filtro ou escopo.</div>'}
async function adminLoadData(){if(!adminCanUseCentral())return;try{adminStatus('Carregando...');const [u,o,uo,m,i,a,authQ]=await Promise.all([sb.from('sustentacao_usuarios').select('id,user_id,email,nome,perfil,ativo').order('email').limit(1000),sb.from('sustentacao_operacoes').select('id,codigo,nome,ativo,responsavel_user_id').order('id').limit(100),sb.from('sustentacao_usuario_operacoes').select('user_id,operacao_id,ativo').limit(5000),sb.from('sustentacao_usuario_modulos').select('user_id,operacao_id,modulo,nivel_acesso,pode_visualizar,pode_lancar_resultado,pode_editar,pode_administrar,ativo').limit(5000),sb.from('sustentacao_usuario_indicadores').select('user_id,operacao_id,indicador_id,nivel_acesso,pode_visualizar,pode_lancar_resultado,pode_editar,pode_administrar,ativo').limit(10000),sb.from('sustentacao_usuario_plano_acao').select('user_id,operacao_id,pode_visualizar,pode_criar,pode_editar,pode_alterar_status,pode_concluir,pode_excluir,ativo').limit(1000),adminCallInvite({},'list')]);for(const q of [u,o,uo,m,i,a])if(q.error)throw q.error;if(!authQ?.users)throw new Error('Não foi possível consultar os usuários do Auth.');const visibleIds=new Set(authQ.users.map(x=>x.user_id));adminUsers=(authQ.users||[]).map(x=>({...x,linked:!!x.linked,adminStatus:adminAuthStatus(x),resendApplicable:adminResendAvailable(x)}));adminOperations=o.data||[];adminUserOperations=(uo.data||[]).filter(x=>visibleIds.has(x.user_id));adminUserModules=(m.data||[]).filter(x=>visibleIds.has(x.user_id));adminUserIndicators=(i.data||[]).filter(x=>visibleIds.has(x.user_id));adminUserActions=(a.data||[]).filter(x=>visibleIds.has(x.user_id));const iq=await sb.from('sustentacao_indicadores').select('id,operacao_id,nome,peso,meta,polaridade,objetivo,formato,periodicidade,responsavel_user_id,ativo,ordem').order('operacao_id').order('ordem').limit(5000);if(iq.error)throw iq.error;adminIndicatorCatalog=iq.data||[];if(!adminCentralOperationId||!adminOperations.some(x=>x.id===adminCentralOperationId))adminCentralOperationId=currentUserIsAdmin?null:(adminOperations[0]?.id||null);adminRenderCentral();if(!adminDraft)adminNewUser();else adminRenderEditor();await adminLoadOperationConfigs();adminStatus('Pronto')}catch(e){console.error(e);adminStatus('Erro ao carregar a Central',true)}}
function adminOpenArea(area){adminArea=area;['operations','users','indicators','permissions'].forEach(x=>{const panel=document.getElementById('adminArea'+x[0].toUpperCase()+x.slice(1));if(panel)panel.hidden=x!==area;const nav=document.getElementById('adminNav'+x[0].toUpperCase()+x.slice(1));if(nav)nav.classList.toggle('active',x===area)});if(area==='users')adminRenderUserList();if(area==='indicators')adminRenderIndicatorCatalog()}
function adminSelectCentralOperation(value){adminCentralOperationId=value==='ALL'?null:Number(value)||null;adminConfigOperationId=adminCentralOperationId||adminOperations[0]?.id||null;adminDraft=null;adminRenderCentral();adminLoadOperationConfigs().catch(e=>adminStatus(e.message,true))}
function adminRenderCentral(){const select=document.getElementById('adminCentralOperation');if(select){const own=adminOperations.filter(o=>currentUserIsAdmin||currentUserOperationIds.has(Number(o.id)));select.innerHTML=(currentUserIsAdmin?'<option value="ALL">Todas as operações</option>':'')+own.map(o=>`<option value="${o.id}" ${adminCentralOperationId===o.id?'selected':''}>${esc(o.nome)}</option>`).join('');if(currentUserIsAdmin&&adminCentralOperationId===null)select.value='ALL';else if(adminCentralOperationId)select.value=String(adminCentralOperationId)}const createOp=document.getElementById('adminNewOperationButton');if(createOp)createOp.hidden=!currentUserIsAdmin;const title=document.getElementById('adminHeaderStatus');if(title)title.textContent=currentUserIsAdmin?'Super Administrador · escopo global':`Administrador da Operação · ${adminOperations.find(o=>o.id===adminCentralOperationId)?.nome||'escopo autorizado'}`;const opCatalog=document.getElementById('adminOperationsCatalog');if(opCatalog)opCatalog.innerHTML=adminOperations.filter(o=>currentUserIsAdmin||currentUserOperationIds.has(Number(o.id))).map(o=>`<div class="adminCheck"><b>${esc(o.codigo)}</b> — ${esc(o.nome)} <span class="adminBadge ${o.ativo?'ok':'off'}">${o.ativo?'Ativa':'Inativa'}</span><span style="margin-left:auto">${esc(adminUsers.find(u=>u.user_id===o.responsavel_user_id)?.nome||adminOperationConfigs[o.id]?.responsavel_nome||'Sem responsável')}</span></div>`).join('')||'<div class="adminEmpty">Nenhuma operação disponível.</div>';adminRenderOperationConfig();adminRenderIndicatorCatalog()}
function adminNewOperation(){if(!currentUserIsAdmin)return;const form=document.getElementById('adminOperationForm');if(!form)return;form.hidden=false;document.getElementById('adminOperationCode').value='';document.getElementById('adminOperationName').value='';document.getElementById('adminOperationResponsible').innerHTML='<option value="">Sem responsável</option>'+adminUsers.filter(u=>u.ativo).map(u=>`<option value="${u.user_id}">${esc(u.nome||u.email)}</option>`).join('')}
function adminCancelOperation(){const form=document.getElementById('adminOperationForm');if(form)form.hidden=true}
async function adminSaveOperation(event){event?.preventDefault();if(!currentUserIsAdmin)return;const codigo=document.getElementById('adminOperationCode').value.trim().toUpperCase().replace(/[^A-Z0-9_]+/g,'_'),nome=document.getElementById('adminOperationName').value.trim(),responsavel_user_id=document.getElementById('adminOperationResponsible').value||null;if(!codigo||!nome){adminStatus('Informe código e nome da operação.',true);return}adminStatus('Criando operação...');try{const q=await sb.from('sustentacao_operacoes').insert({codigo,nome,ativo:true,responsavel_user_id}).select('id').single();if(q.error)throw q.error;adminCancelOperation();await adminLoadData();adminStatus('Operação criada ✓')}catch(e){console.error(e);adminStatus(e.message||'Não foi possível criar a operação.',true)}}
function adminIndicatorOperationAllowed(){return !!adminCentralOperationId&&(currentUserIsAdmin||currentUserOperationIds.has(Number(adminCentralOperationId)))}
function adminResponsibleOptions(selected,operationId){const linked=adminUserOperations.filter(x=>x.operacao_id===operationId&&x.ativo).map(x=>x.user_id);return '<option value="">Sem responsável</option>'+adminUsers.filter(u=>u.ativo&&(linked.length===0||linked.includes(u.user_id))).map(u=>`<option value="${u.user_id}" ${u.user_id===selected?'selected':''}>${esc(u.nome||u.email)}</option>`).join('')}
function adminRenderIndicatorCatalog(){const host=document.getElementById('adminIndicatorCatalog');if(!host)return;const items=adminIndicatorCatalog.filter(x=>!adminCentralOperationId||x.operacao_id===adminCentralOperationId);if(!items.length){host.innerHTML='<div class="adminEmpty">Nenhum indicador cadastrado neste escopo.</div>';return}host.innerHTML=`<table class="adminIndicatorTable"><thead><tr><th>Operação</th><th>Indicador</th><th>Meta</th><th>Peso</th><th>Periodicidade</th><th>Responsável</th><th>Status</th><th></th></tr></thead><tbody>${items.map(x=>`<tr><td>${esc(adminOperations.find(o=>o.id===x.operacao_id)?.codigo||'')}</td><td>${esc(x.nome)}</td><td>${formatAdminIndicatorValue(x,x.meta)}</td><td>${Number(x.peso||0).toLocaleString('pt-BR',{maximumFractionDigits:2})}%</td><td>${esc(x.periodicidade||'—')}</td><td>${esc(adminUsers.find(u=>u.user_id===x.responsavel_user_id)?.nome||'—')}</td><td><span class="adminBadge ${x.ativo?'ok':'off'}">${x.ativo?'Ativo':'Inativo'}</span></td><td><button class="secondary" onclick="adminEditIndicator(${x.id})">Editar</button></td></tr>`).join('')}</tbody></table>`}
function adminNewIndicator(){if(!adminIndicatorOperationAllowed()){adminIndicatorStatus('Selecione uma operação autorizada.',true);return}adminIndicatorEditingId=null;const form=document.getElementById('adminIndicatorForm');form.hidden=false;document.getElementById('adminIndicatorFormTitle').textContent=`Cadastrar indicador em ${operationDisplayNameForAdmin()}`;document.getElementById('adminIndicatorName').value='';document.getElementById('adminIndicatorObjective').value='';document.getElementById('adminIndicatorWeight').value='';document.getElementById('adminIndicatorMeta').value='';document.getElementById('adminIndicatorPeriodicity').value='Mensal';document.getElementById('adminIndicatorPolarity').value='MAIOR';document.getElementById('adminIndicatorFormat').value='PERCENT';document.getElementById('adminIndicatorActive').value='true';document.getElementById('adminIndicatorResponsible').innerHTML=adminResponsibleOptions('',adminCentralOperationId)}
function operationDisplayNameForAdmin(){return adminOperations.find(o=>o.id===adminCentralOperationId)?.nome||'a operação selecionada'}
function adminEditIndicator(id){const x=adminIndicatorCatalog.find(i=>Number(i.id)===Number(id));if(!x)return;adminCentralOperationId=x.operacao_id;adminOpenArea('indicators');adminIndicatorEditingId=x.id;const form=document.getElementById('adminIndicatorForm');form.hidden=false;document.getElementById('adminIndicatorFormTitle').textContent=`Editar indicador em ${operationDisplayNameForAdmin()}`;document.getElementById('adminIndicatorName').value=x.nome||'';document.getElementById('adminIndicatorObjective').value=x.objetivo||'';document.getElementById('adminIndicatorWeight').value=x.peso??'';document.getElementById('adminIndicatorMeta').value=x.meta??'';document.getElementById('adminIndicatorPeriodicity').value=x.periodicidade||'';document.getElementById('adminIndicatorPolarity').value=x.polaridade||'MAIOR';document.getElementById('adminIndicatorFormat').value=x.formato||'PERCENT';document.getElementById('adminIndicatorActive').value=x.ativo===false?'false':'true';document.getElementById('adminIndicatorResponsible').innerHTML=adminResponsibleOptions(x.responsavel_user_id,x.operacao_id)}
function adminCancelIndicator(){adminIndicatorEditingId=null;const form=document.getElementById('adminIndicatorForm');if(form)form.hidden=true}
function adminIndicatorStatus(text,err=false){const e=document.getElementById('adminIndicatorStatus');if(e){e.textContent=text;e.className='adminStatus'+(err?' err':'')}}
async function adminSaveIndicator(event){event?.preventDefault();if(!adminIndicatorOperationAllowed()){adminIndicatorStatus('Operação fora do escopo autorizado.',true);return}const nome=document.getElementById('adminIndicatorName').value.trim(),objetivo=document.getElementById('adminIndicatorObjective').value.trim(),peso=Number(document.getElementById('adminIndicatorWeight').value),meta=Number(document.getElementById('adminIndicatorMeta').value),polaridade=document.getElementById('adminIndicatorPolarity').value,formato=document.getElementById('adminIndicatorFormat').value,periodicidade=document.getElementById('adminIndicatorPeriodicity').value.trim()||null,responsavel_user_id=document.getElementById('adminIndicatorResponsible').value||null,ativo=document.getElementById('adminIndicatorActive').value==='true';if(!nome||!Number.isFinite(peso)||peso<0||peso>100||!Number.isFinite(meta)||meta<0){adminIndicatorStatus('Informe nome, meta e peso válidos.',true);return}adminIndicatorStatus('Salvando...');try{const payload={operacao_id:adminCentralOperationId,nome,objetivo,peso,meta,polaridade,formato,periodicidade,responsavel_user_id,ativo,updated_at:new Date().toISOString()};let q;if(adminIndicatorEditingId)q=await sb.from('sustentacao_indicadores').update(payload).eq('id',adminIndicatorEditingId).eq('operacao_id',adminCentralOperationId).select('id').single();else{payload.ordem=adminIndicatorCatalog.filter(x=>x.operacao_id===adminCentralOperationId).reduce((m,x)=>Math.max(m,Number(x.ordem)||0),0)+1;q=await sb.from('sustentacao_indicadores').insert(payload).select('id').single()}if(q.error)throw q.error;adminIndicatorStatus('Indicador salvo ✓');adminCancelIndicator();await adminLoadData();syncMsg(ativo?'Indicador salvo na Central ✓':'Indicador inativado; histórico preservado ✓','ok')}catch(e){console.error(e);adminIndicatorStatus(e.message||'Não foi possível salvar o indicador.',true)}}
function adminOpenUser(userId){const u=adminUsers.find(x=>x.user_id===userId);if(!u)return;adminOpenArea('users');const d=adminDraftDefaults();d.userId=u.user_id;d.email=u.email||'';d.nome=u.nome||'';d.perfil=u.perfil==='admin'?'super_admin':u.perfil==='gestor'?'administrador_operacao':u.perfil||'usuario';d.ativo=u.ativo!==false;d.authStatus=u.adminStatus||adminAuthStatus(u);d.resendApplicable=u.resendApplicable??adminResendAvailable(u);d.invitedAt=u.invited_at||null;d.lastInviteAt=u.confirmation_sent_at||u.invited_at||null;d.lastSignInAt=u.last_sign_in_at||null;adminUserOperations.filter(x=>x.user_id===userId&&x.ativo).forEach(x=>d.operations.add(x.operacao_id));adminUserModules.filter(x=>x.user_id===userId&&x.ativo).forEach(x=>d.modules[permKey(x.operacao_id,x.modulo)]={...x});adminUserIndicators.filter(x=>x.user_id===userId&&x.ativo).forEach(x=>d.indicators[permKey(x.operacao_id,x.indicador_id)]={...x});adminUserActions.filter(x=>x.user_id===userId&&x.ativo).forEach(x=>d.actions[x.operacao_id]={...x});adminDraft=d;adminFocusOperationId=[...d.operations][0]||adminOperations[0]?.id||null;adminRenderEditor()}
function adminToggleOperation(id,checked){if(!adminDraft)return;if(checked)adminDraft.operations.add(id);else adminDraft.operations.delete(id);if(!adminDraft.operations.has(adminFocusOperationId))adminFocusOperationId=[...adminDraft.operations][0]||adminOperations[0]?.id||null;adminRenderEditor()}
function adminSetFocusOperation(id){adminFocusOperationId=id;adminRenderPermissionPanels()}
function adminModuleValue(op,mod){return adminDraft?.modules[permKey(op,mod)]||{nivel_acesso:'NENHUM',pode_visualizar:false,pode_lancar_resultado:false,pode_editar:false,pode_administrar:false}}
function adminIndicatorValue(op,id){return adminDraft?.indicators[permKey(op,id)]||{nivel_acesso:'NENHUM',pode_visualizar:false,pode_lancar_resultado:false,pode_editar:false,pode_administrar:false}}
function adminActionValue(op){return adminDraft?.actions[op]||{pode_visualizar:false,pode_criar:false,pode_editar:false,pode_alterar_status:false,pode_concluir:false,pode_excluir:false}}
function adminSetModuleLevel(op,mod,level){const k=permKey(op,mod),v={...adminModuleValue(op,mod),nivel_acesso:level,pode_visualizar:level!=='NENHUM',pode_lancar_resultado:['LANCAR_RESULTADO','EDITAR','ADMINISTRAR'].includes(level),pode_editar:['EDITAR','ADMINISTRAR'].includes(level),pode_administrar:level==='ADMINISTRAR'};adminDraft.modules[k]=v;adminRenderPermissionPanels()}
function adminSetModule(op,mod,key,value){adminSetModuleLevel(op,mod,value?key==='pode_editar'?'EDITAR':'VISUALIZAR':'NENHUM')}
function adminSetIndicatorLevel(op,id,level){const k=permKey(op,id),v={...adminIndicatorValue(op,id),nivel_acesso:level,pode_visualizar:level!=='NENHUM',pode_lancar_resultado:['LANCAR_RESULTADO','EDITAR','ADMINISTRAR'].includes(level),pode_editar:['EDITAR','ADMINISTRAR'].includes(level),pode_administrar:level==='ADMINISTRAR'};adminDraft.indicators[k]=v;adminRenderPermissionPanels()}
function adminSetIndicator(op,id,key,value){adminSetIndicatorLevel(op,id,value?key==='pode_editar'?'EDITAR':'VISUALIZAR':'NENHUM')}
function adminSetAction(op,key,value){adminDraft.actions[op]={...adminActionValue(op),[key]:value};adminRenderPermissionPanels()}
function adminSelectIndicators(all){if(!adminDraft||!adminFocusOperationId)return;adminIndicatorCatalog.filter(x=>x.operacao_id===adminFocusOperationId).forEach(x=>adminSetIndicatorLevel(adminFocusOperationId,x.id,all?'EDITAR':'NENHUM'));adminRenderPermissionPanels()}
function adminConfigStatus(text,err=false){const el=document.getElementById("adminConfigStatus");if(el){el.textContent=text;el.className="adminConfigStatus"+(err?" err":"")}}
function adminConfigDefault(){return {id:null,operacao_id:adminConfigOperationId,responsavel_user_id:null,responsavel_nome:"",polaridade:"",objetivo:"",formato_calculo:"",peso:null,ativo:true}}
async function adminLoadOperationConfigs(){const q=await sb.from("sustentacao_configuracoes_operacao").select("id,operacao_id,responsavel_user_id,responsavel_nome,polaridade,objetivo,formato_calculo,peso,ativo,updated_at,updated_by").eq("ativo",true).limit(100);if(q.error)throw q.error;adminOperationConfigs={};(q.data||[]).forEach(x=>adminOperationConfigs[x.operacao_id]=x);if(!adminConfigOperationId||!adminOperations.some(x=>x.id===adminConfigOperationId))adminConfigOperationId=adminOperations[0]?.id||null;adminRenderOperationConfig()}
function adminRenderOperationConfig(){const select=document.getElementById("adminConfigOperation"),userSelect=document.getElementById("adminConfigResponsible");if(!select||!userSelect)return;select.innerHTML=adminOperations.map(o=>`<option value="${o.id}" ${o.id===adminConfigOperationId?"selected":""}>${esc(o.nome)}</option>`).join("");const config={...adminConfigDefault(),...(adminOperationConfigs[adminConfigOperationId]||{})};userSelect.innerHTML=`<option value="">Sem responsável</option>`+adminUsers.filter(u=>u.ativo).map(u=>{const label=u.nome||(u.user_id===config.responsavel_user_id&&config.responsavel_nome)||u.email;return `<option value="${u.user_id}" ${u.user_id===config.responsavel_user_id?"selected":""}>${esc(label)}</option>`}).join("");userSelect.value=config.responsavel_user_id||"";document.getElementById("adminConfigPolarity").value=config.polaridade||"";document.getElementById("adminConfigObjective").value=config.objetivo||"";document.getElementById("adminConfigFormat").value=config.formato_calculo||"";document.getElementById("adminConfigWeight").value=config.peso??"";adminConfigStatus("")}
function adminSelectOperationConfig(id){adminConfigOperationId=id;adminRenderOperationConfig()}
function adminCancelOperationConfig(){adminRenderOperationConfig()}
async function adminSaveOperationConfig(){if(!adminConfigOperationId){adminConfigStatus("Selecione uma operação.",true);return}const pesoRaw=document.getElementById("adminConfigWeight")?.value.trim(),peso=pesoRaw===""?null:Number(pesoRaw);if(peso!==null&&(!Number.isFinite(peso)||peso<0||peso>100)){adminConfigStatus("Informe um peso entre 0 e 100.",true);return}const responsibleId=document.getElementById("adminConfigResponsible")?.value||null;const responsible=adminUsers.find(u=>u.user_id===responsibleId),current=adminOperationConfigs[adminConfigOperationId];const responsibleName=responsible?.nome||(current?.responsavel_user_id===responsibleId&&current?.responsavel_nome)||responsible?.email||null;const payload={operacao_id:adminConfigOperationId,responsavel_user_id:responsibleId,responsavel_nome:responsibleName,polaridade:document.getElementById("adminConfigPolarity")?.value.trim()||"",objetivo:document.getElementById("adminConfigObjective")?.value.trim()||"",formato_calculo:document.getElementById("adminConfigFormat")?.value.trim()||"",peso,ativo:true,updated_at:new Date().toISOString(),updated_by:currentUserId};adminConfigStatus("Salvando...");try{await adminGetFreshSession();let q;if(current?.id)q=await sb.from("sustentacao_configuracoes_operacao").update(payload).eq("id",current.id).eq("operacao_id",adminConfigOperationId).select("*").single();else q=await sb.from("sustentacao_configuracoes_operacao").insert(payload).select("*").single();if(q.error)throw q.error;adminOperationConfigs[adminConfigOperationId]=q.data;adminConfigStatus("Configurações salvas ✓");if(activeOperationId===adminConfigOperationId){operationConfigs[activeOperationId]=q.data;setOperationContext()}syncMsg("Configurações da operação salvas ✓","ok")}catch(e){console.error(e);adminConfigStatus(e.message||"Erro ao salvar configurações.",true)}}

function adminRenderEditor(){const e=document.getElementById('adminEditor');if(!e||!adminDraft)return;e.hidden=false;const statusInfo=document.getElementById('adminUserStatusInfo');if(statusInfo){const status=adminDraft.userId?adminDraft.authStatus:'new';statusInfo.innerHTML=adminDraft.userId?`<div><b>Status</b><span class="adminBadge ${adminStatusClass(status)}"><span class="adminStatusDot ${adminAuthStatusDot(status)}"></span>${adminStatusLabel(status)}</span></div><div><b>Data do convite</b>${adminDateTime(adminDraft.invitedAt)}</div><div><b>Último envio do convite</b>${adminDateTime(adminDraft.lastInviteAt)}</div>`:'<div><b>Status</b>Novo cadastro</div><div><b>Data do convite</b>—</div><div><b>Último envio do convite</b>—</div>'}const profile=document.getElementById('adminProfile');[...profile.options].forEach(o=>o.hidden=!currentUserIsAdmin&&['super_admin','administrador_operacao'].includes(o.value));if(!currentUserIsAdmin&&['super_admin','administrador_operacao'].includes(adminDraft.perfil))adminDraft.perfil='usuario';document.getElementById('adminName').value=adminDraft.nome;document.getElementById('adminEmail').value=adminDraft.email;document.getElementById('adminEmail').readOnly=!!adminDraft.userId;profile.value=adminDraft.perfil;document.getElementById('adminActive').value=String(adminDraft.ativo);const resendButton=document.getElementById('adminResendInviteButton');if(resendButton){resendButton.hidden=!adminDraft.userId||!adminDraft.resendApplicable;resendButton.disabled=adminInviteBusy}const saveButton=document.getElementById('adminSaveUserButton');if(saveButton)saveButton.disabled=adminInviteBusy;document.getElementById('adminOperationList').innerHTML=adminOperations.map(o=>`<label class="adminCheck"><input type="checkbox" ${adminDraft.perfil==='super_admin'||adminDraft.operations.has(o.id)?'checked':''} ${adminDraft.perfil==='super_admin'?'disabled':''} onchange="adminToggleOperation(${o.id},this.checked)"> ${esc(o.nome)}</label>`).join('');adminRenderPermissionPanels();adminRenderUserList()}
function accessLevelOptions(current){return ACCESS_LEVELS.map(([value,label])=>`<option value="${value}" ${value===current?'selected':''}>${label}</option>`).join('')}
function adminRenderPermissionPanels(){if(!adminDraft)return;const opSelect=document.getElementById('adminPermissionOperation');if(!opSelect)return;const ops=adminOperations.filter(o=>adminDraft.perfil==='super_admin'||adminDraft.operations.has(o.id));if(!ops.some(o=>o.id===adminFocusOperationId))adminFocusOperationId=ops[0]?.id||null;opSelect.innerHTML=ops.length?ops.map(o=>`<option value="${o.id}" ${o.id===adminFocusOperationId?'selected':''}>${esc(o.nome)}</option>`).join(''):'<option value="">Nenhuma operação selecionada</option>';const modBox=document.getElementById('adminModulePermissions'),indBox=document.getElementById('adminIndicatorPermissions'),actBox=document.getElementById('adminActionPermissions');if(['super_admin','administrador_operacao'].includes(adminDraft.perfil)){const note='<p class="adminNote">Este perfil administra o escopo autorizado por regra de banco. A operação vinculada continua sendo validada pelo RLS.</p>';modBox.innerHTML=note;indBox.innerHTML=note;actBox.innerHTML=note;return}if(!adminFocusOperationId){modBox.innerHTML='<div class="adminEmpty">Selecione uma operação para configurar.</div>';indBox.innerHTML='';actBox.innerHTML='';return}modBox.innerHTML=`<table class="adminPermTable"><thead><tr><th>Módulo</th><th>Nível de acesso</th></tr></thead><tbody>${ADMIN_MODULES.map(([key,label])=>{const p=adminModuleValue(adminFocusOperationId,key);return `<tr><td>${label}</td><td><select onchange="adminSetModuleLevel(${adminFocusOperationId},'${key}',this.value)">${accessLevelOptions(effectiveAccessLevel(p))}</select></td></tr>`}).join('')}</tbody></table>`;const inds=adminIndicatorCatalog.filter(x=>x.operacao_id===adminFocusOperationId);indBox.innerHTML=`<div class="adminBulk"><button onclick="adminSelectIndicators(true)">Editar todos</button><button onclick="adminSelectIndicators(false)">Remover todos</button></div>${inds.length?`<table class="adminPermTable"><thead><tr><th>Indicador</th><th>Nível de acesso</th></tr></thead><tbody>${inds.map(x=>{const p=adminIndicatorValue(x.operacao_id,x.id);return `<tr><td>${esc(x.nome)}</td><td><select onchange="adminSetIndicatorLevel(${x.operacao_id},${x.id},this.value)">${accessLevelOptions(effectiveAccessLevel(p))}</select></td></tr>`}).join('')}</tbody></table>`:'<div class="adminEmpty">Nenhum indicador cadastrado nesta operação.</div>'}`;const a=adminActionValue(adminFocusOperationId),fields=[['pode_visualizar','Visualizar'],['pode_criar','Criar'],['pode_editar','Editar'],['pode_alterar_status','Alterar status'],['pode_concluir','Concluir'],['pode_excluir','Excluir']];actBox.innerHTML=`<table class="adminPermTable"><thead><tr><th>Ação</th><th>Permitir</th></tr></thead><tbody>${fields.map(([key,label])=>`<tr><td>${label}</td><td><input type="checkbox" ${a[key]?'checked':''} onchange="adminSetAction(${adminFocusOperationId},'${key}',this.checked)"></td></tr>`).join('')}</tbody></table>`}
function adminPayload(){return {p_operation_ids:[...adminDraft.operations].map(Number),p_module_permissions:Object.entries(adminDraft.modules).filter(([k])=>adminDraft.operations.has(Number(k.split(':')[0]))).map(([k,v])=>{const [operation_id,modulo]=k.split(':');return {operacao_id:Number(operation_id),modulo,nivel_acesso:effectiveAccessLevel(v),pode_visualizar:!!v.pode_visualizar,pode_lancar_resultado:!!v.pode_lancar_resultado,pode_editar:!!v.pode_editar,pode_administrar:!!v.pode_administrar}}),p_indicator_permissions:Object.entries(adminDraft.indicators).filter(([k])=>adminDraft.operations.has(Number(k.split(':')[0]))).map(([k,v])=>{const [operation_id,indicador_id]=k.split(':');return {operacao_id:Number(operation_id),indicador_id:Number(indicador_id),nivel_acesso:effectiveAccessLevel(v),pode_visualizar:!!v.pode_visualizar,pode_lancar_resultado:!!v.pode_lancar_resultado,pode_editar:!!v.pode_editar,pode_administrar:!!v.pode_administrar}}),p_action_permissions:Object.entries(adminDraft.actions).filter(([op])=>adminDraft.operations.has(Number(op))).map(([operacao_id,v])=>({operacao_id:Number(operacao_id),pode_visualizar:!!v.pode_visualizar,pode_criar:!!v.pode_criar,pode_editar:!!v.pode_editar,pode_alterar_status:!!v.pode_alterar_status,pode_concluir:!!v.pode_concluir,pode_excluir:!!v.pode_excluir}))}}
async function adminGetFreshSession(){
  const refreshed=await sb.auth.refreshSession();
  if(refreshed.error||!refreshed.data?.session){
    const current=await sb.auth.getSession();
    if(current.error||!current.data?.session)throw new Error("Sua sessão expirou. Faça login novamente.");
    return current.data.session;
  }
  return refreshed.data.session;
}
async function adminCallInvite(payload,action="save"){
  let session=await adminGetFreshSession();
  const requestBody={...payload,action};
  let response=await fetch(`${SB_URL}/functions/v1/admin-users`,{method:"POST",headers:{apikey:SB_KEY,Authorization:`Bearer ${session.access_token}`,"Content-Type":"application/json"},body:JSON.stringify(requestBody)});
  if(response.status===401){
    session=await adminGetFreshSession();
    response=await fetch(`${SB_URL}/functions/v1/admin-users`,{method:"POST",headers:{apikey:SB_KEY,Authorization:`Bearer ${session.access_token}`,"Content-Type":"application/json"},body:JSON.stringify(requestBody)});
  }
  const result=await response.json().catch(()=>({}));
  if(!response.ok){const error=new Error(result.error||"Não foi possível cadastrar o usuário.");error.code=result.code||"";error.user_id=result.user_id;throw error}
  return result;
}
function adminFriendlyInviteError(error){
  const message=String(error?.message||"").toLowerCase();
  if(error?.code==="EMAIL_RATE_LIMIT"||message.includes("rate limit")||message.includes("over_email_send_rate_limit")||message.includes("limite temporário")||message.includes("too many"))return "Não foi possível enviar o convite neste momento. O limite temporário de envio de e-mails foi atingido. Tente novamente mais tarde ou verifique a configuração de e-mail.";
  if(message.includes("email address not authorized"))return "O destinatário ainda não está autorizado pelo serviço de e-mail do projeto. Configure um SMTP de produção para liberar os convites corporativos.";
  if(message.includes("already confirmed"))return "Este usuário já confirmou o e-mail. Para redefinir a senha, use o fluxo de recuperação de senha.";
  if(error?.code==="ACCESS_SAVE_ERROR"||message.includes("usuário auth foi preservado")||message.includes("vínculo e as permissões"))return "O usuário foi criado no Auth, mas o vínculo administrativo não terminou. Salve novamente; o sistema reutilizará o mesmo usuário e não criará duplicidade.";
  if(message.includes("sem permissão")||message.includes("permission"))return "Você não possui permissão para administrar este usuário ou operação.";
  if(message.includes("e-mail válido"))return "Informe um e-mail válido para continuar.";
  return "Não foi possível concluir o cadastro do usuário. Verifique os dados e tente novamente.";
}
function adminInvitePayload(){
  const p=adminPayload();
  return {email:document.getElementById("adminEmail").value.trim().toLowerCase(),nome:document.getElementById("adminName").value.trim(),perfil:document.getElementById("adminProfile").value,ativo:document.getElementById("adminActive").value==="true",operation_ids:p.p_operation_ids,module_permissions:p.p_module_permissions,indicator_permissions:p.p_indicator_permissions,action_permissions:p.p_action_permissions};
}
async function adminResendInvite(){
  if(!adminDraft?.userId||adminInviteBusy)return;
  const payload=adminInvitePayload();adminInviteBusy=true;adminStatus("Enviando convite...");adminRenderEditor();
  try{const result=await adminCallInvite(payload,"resend");adminStatus(result.invited?"Convite reenviado ✓":adminFriendlyInviteError(new Error(result.message||"Este usuário já confirmou o e-mail.")),!result.invited)}catch(error){console.error(error);adminStatus(adminFriendlyInviteError(error),true)}finally{adminInviteBusy=false;if(adminDraft)adminRenderEditor()}
}
async function adminSaveUser(){
  if(!adminDraft||adminInviteBusy)return;
  const nome=document.getElementById("adminName").value.trim(),email=document.getElementById("adminEmail").value.trim().toLowerCase();
  if(!nome||!email){adminStatus("Informe nome e e-mail",true);return}
  const payload=adminInvitePayload();adminInviteBusy=true;adminStatus("Salvando...");adminRenderEditor();
  try{const result=await adminCallInvite(payload,"save");const userId=result.user_id||adminDraft.userId;const message=result.invite_state==="pending"?"Usuário e permissões salvos. O convite já existe; use Reenviar convite quando necessário.":result.invited?"Convite enviado e permissões salvas":"Permissões salvas";adminStatus(message);await adminLoadData();adminOpenUser(userId)}catch(error){console.error(error);if(error?.code==="ACCESS_SAVE_ERROR"&&error?.user_id&&adminDraft){adminDraft.userId=error.user_id;adminDraft.authStatus="pending";adminDraft.resendApplicable=true}adminStatus(adminFriendlyInviteError(error),true)}finally{adminInviteBusy=false;if(adminDraft)adminRenderEditor()}
}

/* Visão Executiva consolidada por RPC autorizada */
let executiveState={data:null,month:0};
let executiveCharts={};
const executiveMonthNames=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
function executiveStatusText(status){return status==='good'?'Dentro da meta':status==='warn'?'Atenção':status==='bad'?'Abaixo da meta':'Sem resultado'}
function executiveStatusClass(status){return status==='good'?'good':status==='warn'?'warn':status==='bad'?'bad':'muted'}
function executiveType(ind){return ind?.formato||'PERCENT'}
function executiveFormat(ind,value,empty='—'){if(value===null||value===undefined||value==='')return empty;const n=Number(value);if(!Number.isFinite(n))return empty;const type=executiveType(ind);if(type==='CURRENCY')return n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});if(type==='NUMBER')return n.toLocaleString('pt-BR',{maximumFractionDigits:2});return n.toLocaleString('pt-BR',{maximumFractionDigits:2})+'%'}
function executiveScore(ind,value){if(value===null||value===undefined||value===''||!Number.isFinite(Number(value)))return null;const v=Number(value),goal=Number(ind.meta||0),lower=String(ind.polaridade||'').toUpperCase()==='MENOR';if(lower&&goal===0)return v<=0?100:0;if(!lower&&goal===0)return v>0?100:0;if(lower)return v<=0?100:Math.min(100,goal/v*100);return Math.min(100,v/goal*100)}
function executiveRowStatus(ind,value){if(value===null||value===undefined||value==='')return 'muted';const v=Number(value),goal=Number(ind.meta||0),lower=String(ind.polaridade||'').toUpperCase()==='MENOR';const hit=lower?v<=goal:v>=goal;if(hit)return 'good';const score=executiveScore(ind,v);return score!==null&&score>=90?'warn':'bad'}
function executiveLatestMonth(data){const nums=(data?.resultados||[]).filter(x=>x.resultado!==null&&x.resultado!==undefined&&x.resultado!=='').map(x=>Number(x.mes)).filter(x=>x>=1&&x<=12);return nums.length?Math.max(...nums):0}
function executiveSelectedMonth(data){const select=document.getElementById('executiveMonth');if(!select)return executiveState.month||executiveLatestMonth(data);let current=Number(select.value||0);if(current===0)return executiveLatestMonth(data);return current}
function executiveResultMap(data){const map=new Map();(data?.resultados||[]).forEach(x=>map.set(`${x.indicador_id}:${x.mes}`,x));return map}
function executiveSelectedResults(data){const month=executiveSelectedMonth(data),map=executiveResultMap(data);return (data?.indicadores||[]).map(ind=>({ind,result:month?map.get(`${ind.id}:${month}`):null,value:month?map.get(`${ind.id}:${month}`)?.resultado:null})).filter(x=>x.value!==null&&x.value!==undefined&&x.value!=='')}
function executiveWeighted(data,month){const map=executiveResultMap(data);const available=(data?.indicadores||[]).map(ind=>({ind,value:map.get(`${ind.id}:${month}`)?.resultado})).filter(x=>x.value!==null&&x.value!==undefined&&x.value!=='');if(!available.length)return null;const total=available.reduce((a,x)=>a+Number(x.ind.peso||0),0);if(!total)return available.reduce((a,x)=>a+(executiveScore(x.ind,x.value)||0),0)/available.length;return available.reduce((a,x)=>a+(executiveScore(x.ind,x.value)||0)*Number(x.ind.peso||0),0)/total}
function executiveDestroyCharts(){Object.values(executiveCharts).forEach(c=>{try{c.destroy()}catch(_){}});executiveCharts={}}
function executiveBuildMonthSelect(data){const el=document.getElementById('executiveMonth');if(!el)return;const previous=Number(el.value||0);el.innerHTML='<option value="0">Último mês com dados</option>';for(let i=1;i<=12;i++){const has=(data?.resultados||[]).some(x=>Number(x.mes)===i);const o=document.createElement('option');o.value=String(i);o.textContent=executiveMonthNames[i-1]+(has?'':' — sem dados');o.disabled=!has;el.appendChild(o)}const chosen=previous&&[...el.options].some(o=>Number(o.value)===previous&&!o.disabled)?previous:0;el.value=String(chosen);executiveState.month=chosen}
function executiveRenderCards(data){const host=document.getElementById('executiveCards');if(!host)return;const month=executiveSelectedMonth(data),items=executiveSelectedResults(data),good=items.filter(x=>executiveRowStatus(x.ind,x.value)==='good').length,bad=items.filter(x=>executiveRowStatus(x.ind,x.value)==='bad').length,score=month?executiveWeighted(data,month):null,open=(data.acoes||[]).filter(x=>!x.concluido&&String(x.status||'').toLowerCase()!=='concluído').length,slaRows=(data.sla||[]).filter(x=>Number(x.mes)===month&&x.tipo==='PONTOS'&&x.indicador!=='Resultado final'),sla=slaRows.length?slaRows.reduce((a,x)=>a+Number(x.valor||0),0):null;const absRows=data.absenteismo?.permitido?(data.absenteismo.mensal||[]).filter(x=>Number(x.ano)===selectedYear&&(!month||Number(x.mes)===month)):[];const abs=absRows.length?absRows[absRows.length-1]:null;const cards=[['Indicadores avaliados',`${items.length}/${(data.indicadores||[]).length}`,month?executiveMonthNames[month-1]:'Ano selecionado',''],['Dentro da meta',String(good),items.length?`${Math.round(good/items.length*100)}% dos resultados`:'Sem resultados','good'],['Pontos de atenção',String(bad),items.length?`${Math.round(bad/items.length*100)}% dos resultados`:'Sem resultados',bad?'bad':''],['Performance ponderada',score===null?'—':score.toLocaleString('pt-BR',{maximumFractionDigits:1})+'%','Peso e polaridade dos indicadores',score!==null&&score>=90?'good':score!==null?'warn':''],['Ações em aberto',String(open),data.acessos?.plano_acao?'Plano de ação autorizado':'Módulo sem acesso',open?'warn':'good'],['Absenteísmo',abs?Number(abs.indice_absenteismo||0).toLocaleString('pt-BR',{maximumFractionDigits:2})+'%': '—',data.acessos?.absenteismo?'Mês selecionado':'Módulo sem acesso',abs&&Number(abs.indice_absenteismo)>0?'warn':'']];if(data.acessos?.sla_neolog)cards.push(['SLA NEOLOG',sla===null?'—':sla.toLocaleString('pt-BR',{maximumFractionDigits:1})+' pts',month?executiveMonthNames[month-1]:'Sem mês','']);host.innerHTML=cards.map(c=>`<div class="executiveMetric ${c[3]}"><small>${c[0]}</small><strong>${c[1]}</strong><span>${c[2]}</span></div>`).join('')}
function executiveRenderTrend(data){const labels=executiveMonthNames.map(x=>x.slice(0,3).toUpperCase()),values=labels.map((_,i)=>executiveWeighted(data,i+1));executiveCharts.performance=new Chart(document.getElementById('executivePerformanceTrend'),{type:'line',data:{labels,datasets:[{label:'Performance ponderada (%)',data:values,borderColor:'#0d6fb8',backgroundColor:'rgba(13,111,184,.14)',fill:true,tension:.28,spanGaps:true},{label:'Referência de meta',data:labels.map(()=>100),borderColor:'#f47b20',borderDash:[6,5],pointRadius:0,tension:0}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:0,max:110,ticks:{callback:v=>v+'%'}}},plugins:{legend:{position:'bottom'}}}})}
function executiveRenderStatus(data){const items=executiveSelectedResults(data),counts={good:0,warn:0,bad:0,muted:0};items.forEach(x=>counts[executiveRowStatus(x.ind,x.value)]++);executiveCharts.status=new Chart(document.getElementById('executiveStatusChart'),{type:'doughnut',data:{labels:['Dentro da meta','Atenção','Abaixo da meta','Sem resultado'],datasets:[{data:[counts.good,counts.warn,counts.bad,counts.muted],backgroundColor:['#18a957','#f2b134','#e52b35','#b9c6d0'],borderWidth:2,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}}}})}
function executiveRenderIndicators(data){const items=executiveSelectedResults(data).sort((a,b)=>(executiveScore(b.ind,b.value)||0)-(executiveScore(a.ind,a.value)||0));const labels=items.map(x=>x.ind.nome),values=items.map(x=>executiveScore(x.ind,x.value));executiveCharts.indicators=new Chart(document.getElementById('executiveIndicatorChart'),{type:'bar',data:{labels,datasets:[{label:'Realização (%)',data:values,backgroundColor:values.map(v=>v>=100?'#18a957':v>=90?'#f2b134':'#e52b35'),borderRadius:4}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{min:0,max:110,ticks:{callback:v=>v+'%'}},y:{ticks:{font:{size:9}}}},plugins:{legend:{display:false}}}})}
function executiveRenderAbs(data){const card=document.getElementById('executiveAbsCard'),empty=document.getElementById('executiveAbsEmpty'),canvas=document.getElementById('executiveAbsChart');if(!data.absenteismo?.permitido||!(data.absenteismo.mensal||[]).length){card.hidden=true;return}card.hidden=false;empty.hidden=true;const rows=(data.absenteismo.mensal||[]).filter(x=>Number(x.ano)===selectedYear),labels=rows.map(x=>executiveMonthNames[Number(x.mes)-1]?.slice(0,3).toUpperCase()),values=rows.map(x=>Number(x.indice_absenteismo||0));executiveCharts.abs=new Chart(canvas,{type:'line',data:{labels,datasets:[{label:'Absenteísmo (%)',data:values,borderColor:'#e05252',backgroundColor:'rgba(224,82,82,.12)',fill:true,tension:.25}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true,ticks:{callback:v=>v+'%'}}},plugins:{legend:{position:'bottom'}}}})}
function executiveRenderSla(data){const card=document.getElementById('executiveSlaCard');if(!data.acessos?.sla_neolog||!(data.sla||[]).length){card.hidden=true;return}card.hidden=false;const sums=Array(12).fill(0),has=Array(12).fill(false);(data.sla||[]).filter(x=>x.tipo==='PONTOS'&&x.indicador!=='Resultado final').forEach(x=>{const i=Number(x.mes)-1;if(i>=0&&i<12){sums[i]+=Number(x.valor||0);has[i]=true}});executiveCharts.sla=new Chart(document.getElementById('executiveSlaChart'),{type:'bar',data:{labels:executiveMonthNames.map(x=>x.slice(0,3).toUpperCase()),datasets:[{label:'Pontos SLA',data:sums.map((v,i)=>has[i]?v:null),backgroundColor:'#0d6fb8',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:false}},plugins:{legend:{position:'bottom'}}}})}
function executiveRenderActionsChart(data){const counts={Concluído:0,Pendente:0,'Em andamento':0,Outros:0};(data.acoes||[]).forEach(x=>{const s=String(x.concluido?'Concluído':x.status||'Outros');if(s==='Pendente'||s==='Em andamento'||s==='Concluído')counts[s]++;else counts.Outros++});executiveCharts.actions=new Chart(document.getElementById('executiveActionsChart'),{type:'doughnut',data:{labels:Object.keys(counts),datasets:[{data:Object.values(counts),backgroundColor:['#18a957','#f2b134','#0d6fb8','#aab8c4'],borderWidth:2,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}}}})}
function executiveRenderTables(data){const month=executiveSelectedMonth(data),items=executiveSelectedResults(data),table=document.getElementById('executiveIndicatorsTable');if(!items.length)table.innerHTML='<div class="executiveEmpty">Nenhum resultado mensal disponível para a operação e o mês selecionados.</div>';else table.innerHTML=`<table><thead><tr><th>Indicador</th><th>Resultado</th><th>Meta</th><th>Peso</th><th>Situação</th><th>Variação</th></tr></thead><tbody>${items.map(({ind,value})=>{const status=executiveRowStatus(ind,value),diff=Number(value)-Number(ind.meta||0);return `<tr><td>${esc(ind.nome)}</td><td>${executiveFormat(ind,value)}</td><td>${executiveFormat(ind,ind.meta)}</td><td>${Number(ind.peso||0).toLocaleString('pt-BR',{maximumFractionDigits:2})}%</td><td><span class="executiveBadge ${executiveStatusClass(status)}">${executiveStatusText(status)}</span></td><td>${executiveFormat(ind,diff,'—')}</td></tr>`}).join('')}</tbody></table><p class="executiveFootnote">Mês analisado: ${month?executiveMonthNames[month-1]:'último mês com dados'}.</p>`;const actionTable=document.getElementById('executiveActionsTable'),actions=(data.acoes||[]).filter(x=>!x.concluido&&String(x.status||'').toLowerCase()!=='concluído').slice(0,12);if(!data.acessos?.plano_acao)actionTable.innerHTML='<div class="executiveEmpty">O usuário não possui permissão para visualizar Planos de Ação.</div>';else if(!actions.length)actionTable.innerHTML='<div class="executiveEmpty">Nenhum plano de ação em aberto.</div>';else actionTable.innerHTML=`<table><thead><tr><th>Ação</th><th>Responsável</th><th>Prazo</th><th>Status</th><th>Prioridade</th></tr></thead><tbody>${actions.map(x=>{const overdue=x.data_fim&&new Date(x.data_fim+'T23:59:59')<new Date();return `<tr><td>${esc(x.acao||'')}</td><td>${esc(x.responsavel||'')}</td><td>${x.data_fim?dateBR(x.data_fim):'Sem prazo'}</td><td>${esc(x.status||'Pendente')}</td><td class="${overdue?'executivePriority':'executiveActionOpen'}">${overdue?'Vencida':'Em acompanhamento'}</td></tr>`}).join('')}</tbody></table>`}
function executiveRender(data){if(!data)return;executiveDestroyCharts();executiveBuildMonthSelect(data);const meta=document.getElementById('executiveHeaderMeta');if(meta)meta.innerHTML=`<strong>${esc(data.operacao?.nome||operationDisplayName())}</strong>${executiveSelectedMonth(data)?executiveMonthNames[executiveSelectedMonth(data)-1]+' de '+selectedYear:'Sem resultados mensais'}`;executiveRenderCards(data);executiveRenderTrend(data);executiveRenderStatus(data);executiveRenderIndicators(data);executiveRenderAbs(data);executiveRenderSla(data);executiveRenderActionsChart(data);executiveRenderTables(data);const note=document.getElementById('executiveAccessNote');const hidden=[];if(!data.acessos?.plano_acao)hidden.push('Planos de Ação');if(!data.acessos?.sla_neolog)hidden.push('SLA NEOLOG');if(!data.acessos?.absenteismo)hidden.push('Absenteísmo');if(note){note.hidden=!hidden.length;note.textContent=hidden.length?'Alguns módulos não estão disponíveis para este usuário: '+hidden.join(', ')+'. Os demais indicadores continuam consolidados conforme as permissões cadastradas.':''}}
async function loadExecutiveData(){if(!activeOperationId||!canModule(activeOperationId,'VISAO_EXECUTIVA','VIEW'))return;const status=document.getElementById('executiveStatus');if(status)status.textContent='Consultando dados autorizados...';try{const q=await sb.rpc('obter_visao_executiva',{p_operacao_id:activeOperationId,p_ano:selectedYear});if(q.error)throw q.error;if(!q.data?.permitido)throw new Error('Acesso não autorizado à Visão Executiva.');executiveState.data=q.data;executiveRender(q.data);if(status){status.textContent='Atualizado pelo Supabase';status.className='executiveStatus'}}catch(e){console.error(e);if(status){status.textContent=e.message||'Erro ao carregar';status.className='executiveStatus err'}const host=document.getElementById('executiveCards');if(host)host.innerHTML='<div class="executiveEmpty">Não foi possível carregar a visão executiva.</div>'}}
function executiveMonthChange(){executiveState.month=Number(document.getElementById('executiveMonth')?.value||0);if(executiveState.data)executiveRender(executiveState.data)}

/* Aba executiva de análise de absenteísmo */
let absRows = [];
let absUploadRows = [];
let absSupabaseRows = [];
let absSupabaseAreas = [];
let absSourceMode = localStorage.getItem("absenteismoSource") || "supabase";
let absFileName = "";
let absCharts = {};
const absMonths = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
const absReasonLabels = {faltas:"Faltas", atestados:"Horas de atestados", atrasos:"Atrasos"};
const absAliases = {cadastro:["cadastro","matricula","matrícula","id"],nome:["nome","colaborador","funcionario","funcionário"],admissao:["admissão","admissao"],situacao:["situação","situacao","status"],cargo:["descrição cargo","descricao cargo","cargo","função","funcao"],centro:["descrição (c.custo)","descricao (c.custo)","centro de custo","centro","ccusto"],setor:["setor","area","área"],faltas:["faltas","falta"],atestados:["horas atestados","atestados","hora atestado"],atrasos:["atrasos","atraso"],total:["total horas não trabalhadas","total horas nao trabalhadas","total improdutivas","horas improdutivas","total"]};
function absNorm(v){return String(v??"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/\s+/g," ").trim()}
function absNum(v){if(v==null||String(v).trim()==="")return 0;let s=String(v).trim().replace(/\s/g,"");if(s.includes(",")&&s.includes(".")){s=s.lastIndexOf(",")>s.lastIndexOf(".")?s.replace(/\./g,"").replace(",","."):s.replace(/,/g,"")}else{s=s.replace(",",".")}s=s.replace(/[^0-9.-]/g,"");let n=Number(s);return Number.isFinite(n)?n:0}
function absEsc(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m]))}
function absFmt(n,digits=2){return Number(n||0).toLocaleString("pt-BR",{minimumFractionDigits:digits,maximumFractionDigits:digits})}
function absPct(n){return `${absFmt(n,2)}%`}
function absSetStatus(text,cls=""){const e=document.getElementById("absStatus"),x=document.getElementById("absExecStatus");if(e){e.textContent=text;e.className="syncStatus execStatus "+cls}if(x){x.textContent=text;x.className="execAbsStatus "+cls}}
function absParseDate(v){if(v instanceof Date)return v;if(typeof v==="number"&&window.XLSX&&XLSX.SSF){let p=XLSX.SSF.parse_date_code(v);return p?new Date(p.y,p.m-1,p.d):null}let s=String(v??"").trim();if(!s)return null;let m=s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);if(m)return new Date(+m[3],+m[2]-1,+m[1]);let d=new Date(s);return Number.isNaN(d.getTime())?null:d}
function absKeyForHeader(h){const n=absNorm(h);for(const [key,aliases] of Object.entries(absAliases))if(aliases.includes(n))return key;return ""}
function absRowsFromMatrix(matrix){if(!matrix?.length)throw new Error("A planilha está vazia.");let headerRow=matrix.findIndex(r=>r.some(c=>absKeyForHeader(c)==="cadastro"||absKeyForHeader(c)==="nome"));if(headerRow<0)headerRow=0;const headers=matrix[headerRow].map(x=>String(x??"")),keys=headers.map(absKeyForHeader),get=(row,key)=>{const i=keys.indexOf(key);return i>=0?row[i]:""},out=[],seen=new Set();matrix.slice(headerRow+1).forEach(row=>{const cadastro=String(get(row,"cadastro")??"").trim(),nome=String(get(row,"nome")??"").trim();if(!cadastro&&!nome)return;const identity=cadastro||nome;if(seen.has(identity))return;seen.add(identity);const motivos={faltas:absNum(get(row,"faltas")),atestados:absNum(get(row,"atestados")),atrasos:absNum(get(row,"atrasos"))},totalCell=get(row,"total"),total=String(totalCell??"").trim()===""?Object.values(motivos).reduce((a,b)=>a+b,0):absNum(totalCell);out.push({cadastro,nome:nome||cadastro,situacao:String(get(row,"situacao")??"").trim(),cargo:String(get(row,"cargo")??"").trim(),centro:String(get(row,"centro")??"").trim()||"Não informado",setor:String(get(row,"setor")??"").trim(),area:String(get(row,"setor")??"").trim(),...motivos,total,expected:0,worked:0,monthKey:document.getElementById("absMonth")?.value||""})});if(!out.length)throw new Error("Não encontrei registros válidos. Verifique a coluna Cadastro ou Nome.");return out}
function absReadCSV(text){const lines=text.replace(/\r/g,"").split("\n").filter(x=>x.trim());if(!lines.length)return [];const sep=(lines[0].match(/;/g)||[]).length>=(lines[0].match(/,/g)||[]).length?";":",";return lines.map(line=>{let a=[],cur="",quoted=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){if(quoted&&line[i+1]==='"'){cur+='"';i++}else quoted=!quoted}else if(ch===sep&&!quoted){a.push(cur);cur=""}else cur+=ch}a.push(cur);return a.map(x=>x.trim())})}
function absLoadMatrix(matrix,name="Planilha"){try{absUploadRows=absRowsFromMatrix(matrix);absFileName=name;absSourceMode="upload";absRows=absUploadRows;localStorage.setItem("absenteismoSource","upload");localStorage.setItem(`absenteismoRows:${activeOperationCode||"MATRIZ"}`,JSON.stringify(absUploadRows));localStorage.setItem(`absenteismoFile:${activeOperationCode||"MATRIZ"}`,name);absSetStatus(`${absRows.length} registros do upload` ,"ok");absRenderDashboard()}catch(e){absSetStatus("Erro na planilha","err");alert(e.message)}}
function absHandleFile(event){const file=event.target.files?.[0];if(!file)return;absSetStatus("Lendo planilha...");const ext=file.name.toLowerCase().split(".").pop(),rd=new FileReader();rd.onerror=()=>absSetStatus("Não foi possível ler o arquivo","err");rd.onload=()=>{try{if(ext==="csv")absLoadMatrix(absReadCSV(rd.result),file.name);else{if(!window.XLSX)throw new Error("A biblioteca XLSX ainda não carregou.");const wb=XLSX.read(rd.result,{type:"array",cellDates:true}),ws=wb.Sheets[wb.SheetNames[0]];absLoadMatrix(XLSX.utils.sheet_to_json(ws,{header:1,defval:""}),file.name)}}catch(e){absSetStatus("Erro na leitura","err");alert(e.message)}};if(ext==="csv")rd.readAsText(file,"UTF-8");else rd.readAsArrayBuffer(file)}
function absBusinessDays(year,month){let n=0,last=new Date(year,month,0).getDate();for(let d=1;d<=last;d++){const date=new Date(year,month-1,d);if(date.getDay()!==0&&date.getDay()!==6)n++}return n}
function absPeriod(){const y=+(document.getElementById("absYear")?.value||document.getElementById("yearSelect")?.value||new Date().getFullYear()),v=document.getElementById("absMonth")?.value||`${y}-05`;return {year:y,month:+String(v).slice(-2),key:v}}
function absAggregate(rows,year,month){const days=absBusinessDays(year,month),daily=absNum(document.getElementById("absDailyHours")?.value)||8,people=rows.length,improd=rows.reduce((s,r)=>s+absNum(r.total),0),expected=rows.reduce((s,r)=>s+absNum(r.expected),0)||(!rows.some(r=>r.expected)?people*days*daily:0),reasons=Object.fromEntries(Object.keys(absReasonLabels).map(k=>[k,rows.reduce((s,r)=>s+absNum(r[k]),0)]));return {people,improd,expected,reasons,pct:expected?improd/expected*100:0,daysAway:daily?improd/daily:0}}
function absApplyFilters(rows){const local=document.getElementById("absLocalFilter")?.value||"",area=document.getElementById("absAreaFilter")?.value||"";const center=document.getElementById("absCenterFilter")?.value||"";return rows.filter(r=>(!local||r.centro===local)&&(!area||r.area===area||r.setor===area)&&(!center||r.setor===center))}
function absCurrentRows(){const p=absPeriod();if(absSourceMode==="upload")return absApplyFilters(absUploadRows);return absApplyFilters(absSupabaseRows.filter(r=>r.monthKey===p.key))}
function absMonthlyData(){const p=absPeriod();if(absSourceMode==="upload"){const a=absAggregate(absCurrentRows(),p.year,p.month);return [{key:p.key,month:p.month,aggregate:a}]}const map={};absApplyFilters(absSupabaseRows.filter(r=>r.monthKey.startsWith(`${p.year}-`))).forEach(r=>{if(!map[r.monthKey])map[r.monthKey]=[];map[r.monthKey].push(r)});return Object.entries(map).map(([key,rows])=>({key,month:+key.slice(-2),aggregate:absAggregate(rows,p.year,+key.slice(-2))})).sort((a,b)=>a.key.localeCompare(b.key))}
function absSelectedAreaRows(){const p=absPeriod(),local=document.getElementById("absLocalFilter")?.value||"",area=document.getElementById("absAreaFilter")?.value||"",center=document.getElementById("absCenterFilter")?.value||"";return absSupabaseAreas.filter(r=>r.mes_referencia===p.key&&(!local||r.local===local)&&(!area||r.area===area)&&(!center||r.area===center))}
function absPopulateFilters(){const years=[...new Set(absSupabaseRows.map(r=>r.monthKey.slice(0,4)))].filter(Boolean).sort(),yearSelect=document.getElementById("absYear"),yearNow=String(absPeriod().year);yearSelect.innerHTML=(years.length?years:[yearNow]).map(y=>`<option value="${y}">${y}</option>`).join("");yearSelect.value=years.includes(yearNow)?yearNow:(years[0]||yearNow);const monthSelect=document.getElementById("absMonth"),old=monthSelect.value||`${yearSelect.value}-05`;monthSelect.innerHTML=absMonths.map((m,i)=>`<option value="${yearSelect.value}-${String(i+1).padStart(2,"0")}">${m}</option>`).join("");monthSelect.value=old.startsWith(yearSelect.value+"-")?old:`${yearSelect.value}-05`;const locals=[...new Set([...absSupabaseRows.map(r=>r.centro),...absSupabaseAreas.map(r=>r.local)].filter(Boolean))].sort((a,b)=>a.localeCompare(b,"pt-BR")),areas=[...new Set(absSupabaseAreas.map(r=>r.area).filter(Boolean))].sort((a,b)=>a.localeCompare(b,"pt-BR")),centers=[...new Set(absSupabaseRows.map(r=>r.setor).filter(Boolean))].sort((a,b)=>a.localeCompare(b,"pt-BR")),local=document.getElementById("absLocalFilter"),area=document.getElementById("absAreaFilter"),center=document.getElementById("absCenterFilter"),oldLocal=local.value,oldArea=area.value,oldCenter=center.value;local.innerHTML='<option value="">Todos os locais</option>'+locals.map(x=>`<option value="${absEsc(x)}">${absEsc(x)}</option>`).join("");area.innerHTML='<option value="">Todas as áreas</option>'+areas.map(x=>`<option value="${absEsc(x)}">${absEsc(x)}</option>`).join("");center.innerHTML='<option value="">Todos os centros</option>'+centers.map(x=>`<option value="${absEsc(x)}">${absEsc(x)}</option>`).join("");if(locals.includes(oldLocal))local.value=oldLocal;if(areas.includes(oldArea))area.value=oldArea;if(centers.includes(oldCenter))center.value=oldCenter}
function absYearChange(){const y=document.getElementById("absYear")?.value;if(y){selectedYear=+y;if(document.getElementById("yearSelect"))document.getElementById("yearSelect").value=y}absLoadSupabase()}
function absMonthChange(){absRenderDashboard()}
function absFilterChange(){absRenderDashboard()}
async function absLoadSupabase(){if(typeof sb==="undefined"||!activeOperationId){absSetStatus("Operação ainda não carregada","err");return}const year=+(document.getElementById("absYear")?.value||document.getElementById("yearSelect")?.value||new Date().getFullYear());absSetStatus("Consultando Supabase...");try{const like=`${year}-%`,[reg,areas]=await Promise.all([sb.from("absenteismo_registros").select("mes_referencia,local,colaborador,setor,cargo,situacao,horas_esperadas,horas_trabalhadas,horas_faltas,horas_atestados,horas_atrasos,horas_improdutivas,indice_absenteismo,operacao_id").eq("operacao_id",activeOperationId).order("mes_referencia").order("colaborador").limit(10000),sb.from("absenteismo_areas").select("mes_referencia,local,area,total_horas,horas_faltas,horas_atestados,horas_atrasos,horas_improdutivas,indice_absenteismo,status,qtd_trabalhando,qtd_demitido,operacao_id").eq("operacao_id",activeOperationId).order("mes_referencia").order("total_horas",{ascending:false}).limit(10000)]);if(reg.error)throw reg.error;if(areas.error)throw areas.error;absSupabaseRows=(reg.data||[]).map(r=>({monthKey:r.mes_referencia,mes_referencia:r.mes_referencia,nome:r.colaborador||"Não informado",situacao:r.situacao||"",cargo:r.cargo||"",centro:r.local||"Não informado",setor:r.setor||"",area:r.setor||"",faltas:absNum(r.horas_faltas),atestados:absNum(r.horas_atestados),atrasos:absNum(r.horas_atrasos),total:absNum(r.horas_improdutivas),expected:absNum(r.horas_esperadas),worked:absNum(r.horas_trabalhadas),indice:absNum(r.indice_absenteismo)}));absSupabaseAreas=areas.data||[];absSourceMode="supabase";localStorage.setItem("absenteismoSource","supabase");absPopulateFilters();absRenderDashboard();absSetStatus(`${absSupabaseRows.length} registros carregados do Supabase`,"ok")}catch(e){console.error(e);absSetStatus("Erro ao consultar Supabase","err");alert("Não foi possível consultar as tabelas de absenteísmo: "+e.message)}}
function absHandleSourceChange(){absLoadSupabase()}
function absDestroyCharts(){Object.values(absCharts).forEach(c=>{try{c.destroy()}catch(e){}});absCharts={}}
function absChart(id,type,data,options={}){if(!window.Chart)return;const canvas=document.getElementById(id);if(!canvas)return;absCharts[id]=new Chart(canvas.getContext("2d"),{type,data,options:{responsive:true,maintainAspectRatio:false,animation:false,plugins:{legend:{labels:{boxWidth:10,usePointStyle:true,font:{size:10}}}},scales:type==="doughnut"?{}:{x:{grid:{color:"#e8eef3"},ticks:{font:{size:10},color:"#5d7387"}},y:{grid:{color:"#e8eef3"},ticks:{font:{size:10},color:"#5d7387"},beginAtZero:true}},...options}})}
function absVariation(current,previous,kind="number"){if(previous==null||!Number.isFinite(previous))return {text:"Sem mês anterior",class:"neutral"};if(!previous)return {text:"Sem base comparável",class:"neutral"};const delta=current-previous,pct=delta/Math.abs(previous)*100,arrow=delta>0?"▲":"▼",cls=kind==="bad"?(delta>0?"down":"up"):(delta>0?"up":"down");return {text:`${arrow} ${absFmt(Math.abs(pct),1)}% vs. mês anterior`,class:cls}}
function absKpi(label,value,meta,variation){return `<div class="execKpi"><span class="execKpiLabel">${label}</span><strong class="execKpiValue">${value}</strong><span class="execKpiMeta ${variation.class}">${variation.text}</span>${meta?`<span class="execKpiMeta">${meta}</span>`:""}</div>`}
function absRenderKpis(current,previous){const meta=null,rows=[absKpi("Colaboradores cadastrados",absFmt(current.people,0),"",absVariation(current.people,previous?.people)),absKpi("Horas improdutivas",`${absFmt(current.improd)} h`,"",absVariation(current.improd,previous?.improd,"bad")),absKpi("% de absenteísmo",absPct(current.pct),"",absVariation(current.pct,previous?.pct,"bad")),absKpi("Horas disponíveis",`${absFmt(current.expected)} h`,"",absVariation(current.expected,previous?.expected)),absKpi("Dias de afastamento",absFmt(current.daysAway,1),"Equivalente em horas / jornada",absVariation(current.daysAway,previous?.daysAway,"bad")),absKpi("Meta do mês","Não cadastrada","Configure a meta no Supabase",{text:"Sem parâmetro de meta",class:"neutral"})];document.getElementById("absKpis").innerHTML=rows.join("")}
function absLinearProjection(values){const pts=values.map((v,i)=>v==null?null:{x:i,y:v}).filter(Boolean);if(pts.length<3)return Array(12).fill(null);const n=pts.length,sx=pts.reduce((a,p)=>a+p.x,0),sy=pts.reduce((a,p)=>a+p.y,0),sxx=pts.reduce((a,p)=>a+p.x*p.x,0),sxy=pts.reduce((a,p)=>a+p.x*p.y,0),slope=(n*sxy-sx*sy)/(n*sxx-sx*sx||1),intercept=(sy-slope*sx)/n,last=pts[pts.length-1].x;return values.map((v,i)=>i>last?Math.max(0,intercept+slope*i):null)}
function absRenderCharts(currentRows){absDestroyCharts();const p=absPeriod(),monthly=absMonthlyData(),labels=absMonths,monthlyPct=labels.map((_,i)=>{const x=monthly.find(m=>m.month===i+1);return x?Number(x.aggregate.pct.toFixed(2)):null}),monthlyHours=labels.map((_,i)=>{const x=monthly.find(m=>m.month===i+1);return x?Number(x.aggregate.improd.toFixed(2)):null}),projection=absLinearProjection(monthlyHours),realCount=monthlyHours.filter(v=>v!=null).length;document.getElementById("absMetaNote").textContent="Meta não cadastrada nas tabelas do Supabase; a linha de meta não é exibida para evitar valor fictício.";document.getElementById("absProjectionNote").textContent=realCount>=3?"Barras azuis: realizado. Linha tracejada: projeção estatística baseada nos meses disponíveis.":"A projeção será exibida quando houver pelo menos três meses reais disponíveis.";absChart("absTrendPctChart","line",{labels,datasets:[{label:"Absenteísmo (%)",data:monthlyPct,borderColor:"#0b6fbe",backgroundColor:"rgba(11,111,190,.12)",fill:true,tension:.35,pointRadius:4},{label:"Meta (%) — não cadastrada",data:Array(12).fill(null),borderColor:"#ff7a21",borderDash:[6,5],pointRadius:0}]},{scales:{y:{suggestedMin:0,suggestedMax:Math.max(5,...monthlyPct.filter(v=>v!=null),1)}}});const reasons=Object.entries(currentRows.reduce((o,r)=>{Object.keys(absReasonLabels).forEach(k=>o[k]=(o[k]||0)+absNum(r[k]));return o},{})).filter(([,v])=>v>0);absChart("absReasonsChart","doughnut",{labels:reasons.map(([k])=>absReasonLabels[k]),datasets:[{data:reasons.map(([,v])=>Number(v.toFixed(2))),backgroundColor:["#0b6fbe","#ff7a21","#f5b82e","#7f8c98"],borderColor:"#fff",borderWidth:2}]},{cutout:"62%"});const top=[...currentRows].sort((a,b)=>b.total-a.total).slice(0,10).reverse();absChart("absTopChart","bar",{labels:top.map(r=>r.nome||"Não informado"),datasets:[{label:"Horas",data:top.map(r=>Number(r.total.toFixed(2))),backgroundColor:"#ff7a21",borderRadius:4}]},{indexAxis:"y",plugins:{legend:{display:false}},scales:{x:{beginAtZero:true}}});const areas=absSelectedAreaRows().sort((a,b)=>Number(b.indice_absenteismo)-Number(a.indice_absenteismo)).slice(0,12);absChart("absAreaChart","bar",{labels:areas.map(r=>r.area||r.local),datasets:[{label:"Absenteísmo (%)",data:areas.map(r=>Number((absNum(r.indice_absenteismo)*100).toFixed(2))),backgroundColor:areas.map((_,i)=>i===0?"#ff7a21":"#0b6fbe"),borderRadius:4}]},{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}});absChart("absHoursTrendChart","line",{labels,datasets:[{label:"Realizado (h)",data:monthlyHours,borderColor:"#0b6fbe",backgroundColor:"#0b6fbe",tension:.3,pointRadius:3},{label:"Projeção (h)",data:projection,borderColor:"#9aaabd",backgroundColor:"#9aaabd",borderDash:[6,5],tension:.3,pointRadius:2}]},{scales:{y:{beginAtZero:true}}})}
function absStatusLabel(raw){const s=absNorm(raw);if(s.includes("crit"))return ["Atenção","alert"];if(s.includes("control")||s.includes("ok"))return ["Controlado","ok"];return [raw||"Sem meta","info"]}
function absRenderSummary(currentRows){const p=absPeriod(),local=document.getElementById("absLocalFilter")?.value||"",area=document.getElementById("absAreaFilter")?.value||"";let data=absSelectedAreaRows();if(absSourceMode==="upload"){const groups={};currentRows.forEach(r=>{const key=r.centro||"Não informado";if(!groups[key])groups[key]={area:key,local:key,total_horas:0,horas_improdutivas:0,indice_absenteismo:0,qtd_trabalhando:0,qtd_demitido:0,status:""};groups[key].horas_improdutivas+=r.total;groups[key].total_horas+=r.expected;groups[key].qtd_trabalhando++});data=Object.values(groups).map(r=>({...r,indice_absenteismo:r.total_horas?r.horas_improdutivas/r.total_horas:0}))}if(!data.length){document.getElementById("absCostCenters").innerHTML='<div class="execEmpty">Não há áreas cadastradas para este filtro.</div>';return}document.getElementById("absCostCenters").innerHTML=`<table><thead><tr><th>Centro de custo</th><th>Colaboradores</th><th>Horas</th><th>% Absenteísmo</th><th>Meta</th><th>Status</th></tr></thead><tbody>${data.map(r=>{const [label,cls]=absStatusLabel(r.status);const people=absNum(r.qtd_trabalhando)+absNum(r.qtd_demitido);return `<tr><td>${absEsc(r.area||r.local)}</td><td>${people||"—"}</td><td>${absFmt(r.horas_improdutivas)} h</td><td>${absPct(absNum(r.indice_absenteismo)*100)}</td><td>Não cadastrada</td><td><span class="execBadge ${cls}">${absEsc(label)}</span></td></tr>`}).join("")}</tbody></table>`}
function absRenderActions(current){const reasonTotal=current.improd?current.improd:1,items=[{name:"Absenteísmo total",value:absPct(current.pct),meta:"Não cadastrada",status:"Sem meta cadastrada",cls:"info"},{name:"Horas improdutivas",value:`${absFmt(current.improd)} h`,meta:"—",status:current.improd>0?"Acompanhar":"Controlado",cls:current.improd>0?"warn":"ok"},{name:"% Horas de atestados",value:absPct(current.reasons.atestados/reasonTotal*100),meta:"Não cadastrada",status:"Sem meta cadastrada",cls:"info"},{name:"% Horas de atrasos",value:absPct(current.reasons.atrasos/reasonTotal*100),meta:"Não cadastrada",status:"Sem meta cadastrada",cls:"info"}];document.getElementById("absActions").innerHTML=`<table><thead><tr><th>Indicador</th><th>Atual</th><th>Meta</th><th>Status</th></tr></thead><tbody>${items.map(x=>`<tr><td>${x.name}</td><td><b>${x.value}</b></td><td>${x.meta}</td><td><span class="execBadge ${x.cls}">${x.status}</span></td></tr>`).join("")}</tbody></table>`}
function absHistory(){try{return JSON.parse(localStorage.getItem("absenteismoHistory")||"[]")}catch(e){return []}}
function absRenderHistory(current){window.absCurrent=current;return current}
function absSaveHistory(){if(!window.absCurrent)return;const c=window.absCurrent,h=absHistory().filter(x=>!(x.key===c.key));h.unshift(c);localStorage.setItem("absenteismoHistory",JSON.stringify(h.slice(0,24)))}
function absClearHistory(){localStorage.removeItem("absenteismoHistory")}
function absDownloadCSV(){const p=absPeriod(),rows=absCurrentRows(),a=absAggregate(rows,p.year,p.month);if(!rows.length){alert("Não há dados para exportar.");return}const lines=[["indicador","valor"],["periodo",p.key],["colaboradores",a.people],["horas_improdutivas",a.improd],["horas_disponiveis",a.expected],["percentual_absenteismo",a.pct],...Object.keys(absReasonLabels).map(k=>[absReasonLabels[k],a.reasons[k]])];const csv=lines.map(x=>x.join(";")).join("\n"),link=document.createElement("a");link.href=URL.createObjectURL(new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8"}));link.download=`resumo_absenteismo_${p.key}.csv`;link.click()}

function absShowSubtab(tab){const intel=tab==="intel";document.getElementById("absSubpanelDashboard").classList.toggle("active",!intel);document.getElementById("absSubpanelIntel").classList.toggle("active",intel);document.getElementById("absSubtabDashboard").classList.toggle("active",!intel);document.getElementById("absSubtabIntel").classList.toggle("active",intel);if(intel)absRenderIntelligence(absCurrentRows())}
function absMonthKeyBefore(key,steps=1){const d=new Date(+key.slice(0,4),+key.slice(5,7)-1-steps,1);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}`}
function absReasonTotals(rows){return Object.fromEntries(Object.keys(absReasonLabels).map(k=>[k,rows.reduce((s,r)=>s+absNum(r[k]),0)]))}
function absPredominantReason(rows){const t=absReasonTotals(rows),entry=Object.entries(t).sort((a,b)=>b[1]-a[1])[0];return entry&&entry[1]>0?absReasonLabels[entry[0]]:"Sem ocorrência"}
function absHistoryProfiles(){const p=absPeriod(),rows=absApplyFilters(absSupabaseRows.filter(r=>r.monthKey.startsWith(`${p.year}-`))),profiles=new Map();rows.forEach(r=>{const name=r.nome||"Não informado";if(!profiles.has(name))profiles.set(name,{name,area:r.setor||r.centro||"Não informado",centro:r.centro||"Não informado",months:{},reasons:{}});const x=profiles.get(name);x.area=r.setor||x.area;x.centro=r.centro||x.centro;if(!x.months[r.monthKey])x.months[r.monthKey]={total:0,rows:[],reasons:{}};x.months[r.monthKey].total+=absNum(r.total);x.months[r.monthKey].rows.push(r);Object.keys(absReasonLabels).forEach(k=>x.months[r.monthKey].reasons[k]=(x.months[r.monthKey].reasons[k]||0)+absNum(r[k]))});return [...profiles.values()].map(x=>{const keys=Object.keys(x.months).sort(),currentKey=p.key,previousKey=absMonthKeyBefore(currentKey),previous=x.months[previousKey]?.total||0,current=x.months[currentKey]?.total||0,histKeys=keys.filter(k=>k<currentKey),baselineKeys=histKeys.slice(0,-1),histValues=baselineKeys.map(k=>x.months[k].total),average=histValues.length?histValues.reduce((a,b)=>a+b,0)/histValues.length:0,prev2=x.months[absMonthKeyBefore(currentKey,2)]?.total||0,currentReasons=x.months[currentKey]?.reasons||{},currentHas=!!x.months[currentKey],aboveCurrent=average===0?current>0:current>average*1.15,abovePrevious=average===0?previous>0:previous>average*1.15,growth2=current>previous&&previous>prev2&&current>0&&previous>0,consecutive=aboveCurrent&&abovePrevious&&(current>=previous||current>average*1.5),abrupt=average===0?current>0:current>=average*1.8&&current-average>=2,recentValues=[current,previous,prev2],aboveCount=recentValues.filter(v=>average===0?v>0:v>average*1.15).length,priorDeviation=average===0?histKeys.some(k=>x.months[k].total>0):histKeys.some(k=>x.months[k].total>average*1.5),improvement=priorDeviation&&previous>0&&current<previous*.7&&(average===0||current<=average*1.1),recurring=!improvement&&aboveCount>=3,attention=!improvement&&(aboveCurrent||growth2),deviation=!improvement&&(consecutive||abrupt||recurring),status=deviation?"Desvio":improvement?"Melhora":attention?"Atenção":"Estável",statusClass=status==="Desvio"?"deviation":status==="Melhora"?"improve":status==="Atenção"?"attention":"stable",variation=previous?((current-previous)/previous*100):current>0?null:0,reason=absReasonLabels[Object.entries(currentReasons).sort((a,b)=>b[1]-a[1])[0]?.[0]]||absPredominantReason(histKeys.slice(-2).flatMap(k=>x.months[k].rows)),newDeviation=deviation&&((average<=1&&current>0)||(average>0&&current>=average*2&&current>previous)),message=deviation?(growth2||consecutive?"Tendência de aumento identificada – 2 meses consecutivos acima do padrão histórico.":"Alteração significativa em relação ao padrão histórico."):improvement?"Redução consistente após período de desvio.":attention?"Início de alteração relevante em relação ao histórico.":"Comportamento dentro do histórico.";return {...x,currentKey,previousKey,current,previous,prev2,average,histKeys,currentReasons,status,statusClass,variation,reason,newDeviation,recurring,attention,improvement,message,currentHas,seriesKeys:keys}}).filter(x=>x.currentHas||x.previous>0||x.histKeys.length)}
function absIntelStatus(status,cls){return `<span class="intelStatus ${cls}">${status}</span>`}
function absIntelPersonButton(name){return `<button class="intelPerson" onclick="absOpenPerson(${absEsc(JSON.stringify(name))})">${absEsc(name)}</button>`}
function absIntelMiniTable(items,empty){if(!items.length)return `<div class="intelEmpty">${empty}</div>`;return `<table><thead><tr><th>Colaborador</th><th>Atual</th><th>Tendência</th></tr></thead><tbody>${items.slice(0,8).map(x=>`<tr><td>${absIntelPersonButton(x.name)}</td><td>${absFmt(x.current)} h</td><td>${absIntelStatus(x.status,x.statusClass)}</td></tr>`).join("")}</tbody></table>`}
function absRenderIntelligence(){const p=absPeriod(),profiles=absHistoryProfiles(),newOnes=profiles.filter(x=>x.newDeviation).sort((a,b)=>b.current-a.current),recurring=profiles.filter(x=>x.recurring).sort((a,b)=>b.current-a.current),attention=profiles.filter(x=>x.attention&&!x.improvement),recovery=profiles.filter(x=>x.improvement),consecutive=profiles.filter(x=>x.current>x.previous&&x.previous>x.prev2&&x.current>0&&x.previous>0),currentRows=profiles.filter(x=>x.currentHas);document.getElementById("absIntelPeriod").textContent=`${absMonths[p.month-1]} de ${p.year} • ${profiles.length} perfis históricos`;document.getElementById("absIntelCards").innerHTML=`<div class="intelMetric"><b>Novos desvios identificados</b><strong>${newOnes.length}</strong><small>no mês selecionado</small></div><div class="intelMetric"><b>Aumento por 2 meses consecutivos</b><strong>${consecutive.length}</strong><small>crescimento contínuo</small></div><div class="intelMetric"><b>Desvios recorrentes</b><strong>${recurring.length}</strong><small>acima do histórico por 3+ meses</small></div><div class="intelMetric"><b>Colaboradores em recuperação</b><strong>${recovery.length}</strong><small>redução após período de desvio</small></div>`;const rows=[...profiles].filter(x=>x.currentHas||x.previous>0).sort((a,b)=>({Desvio:0,Atenção:1,Melhora:2,Estável:3}[a.status]-({Desvio:0,Atenção:1,Melhora:2,Estável:3}[b.status])||b.current-a.current));document.getElementById("absDeviationTable").innerHTML=rows.length?`<table><thead><tr><th>Colaborador</th><th>Área</th><th>Média histórica</th><th>Mês anterior</th><th>Mês atual</th><th>Variação</th><th>Tendência</th><th>Motivo predominante</th><th>Status</th></tr></thead><tbody>${rows.slice(0,150).map(x=>`<tr><td>${absIntelPersonButton(x.name)}</td><td>${absEsc(x.area)}</td><td>${absFmt(x.average)} h</td><td>${absFmt(x.previous)} h</td><td>${absFmt(x.current)} h</td><td>${x.variation==null?"Novo":`${x.variation>=0?"+":""}${absFmt(x.variation,1)}%`}</td><td>${absEsc(x.message)}</td><td>${absEsc(x.reason)}</td><td>${absIntelStatus(x.status,x.statusClass)}</td></tr>`).join("")}</tbody></table>`:'<div class="intelEmpty">Histórico insuficiente para classificar os colaboradores com os filtros atuais.</div>';document.getElementById("absNewDeviationTable").innerHTML=absIntelMiniTable(newOnes,"Nenhum novo desvio identificado no mês selecionado.");document.getElementById("absRecurringTable").innerHTML=absIntelMiniTable(recurring,"Nenhum desvio recorrente identificado.");if(!profiles.length)document.getElementById("absIntelCards").innerHTML='<div class="intelEmpty" style="grid-column:1/-1">Carregue o histórico do Supabase para ativar o Radar de Pessoas.</div>'}
function absOpenPerson(name){const x=absHistoryProfiles().find(p=>p.name===name);if(!x)return;const card=document.getElementById("absPersonDetailCard"),target=document.getElementById("absPersonDetail"),p=absPeriod(),keys=x.seriesKeys.filter(k=>k<=p.key).slice(-12),labels=keys.map(k=>`${absMonths[+k.slice(-2)-1].slice(0,3)}/${k.slice(0,4)}`),values=keys.map(k=>Number(x.months[k].total.toFixed(2))),avgs=keys.map(()=>Number(x.average.toFixed(2)));document.getElementById("absPersonDetailTitle").textContent=`Detalhe: ${x.name}`;target.innerHTML=`<p class="intelNote"><b>Área:</b> ${absEsc(x.area)} · <b>Status:</b> ${absIntelStatus(x.status,x.statusClass)} · ${absEsc(x.message)}</p><div class="intelDetailChart"><canvas id="absPersonChart"></canvas></div><div class="intelMotives">${Object.entries(x.currentReasons).filter(([,v])=>v>0).map(([k,v])=>`<span>${absReasonLabels[k]}: ${absFmt(v)} h</span>`).join("")||"<span>Sem motivos registrados no mês atual.</span>"}</div>`;card.style.display="block";if(absCharts.absPersonChart)absCharts.absPersonChart.destroy();absCharts.absPersonChart=new Chart(document.getElementById("absPersonChart").getContext("2d"),{type:"line",data:{labels,datasets:[{label:"Horas improdutivas",data:values,borderColor:"#ff7a21",backgroundColor:"rgba(255,122,33,.12)",fill:true,tension:.3,pointRadius:4},{label:"Média histórica",data:avgs,borderColor:"#0b6fbe",borderDash:[6,5],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,animation:false,plugins:{legend:{labels:{font:{size:10}}}},scales:{y:{beginAtZero:true}}}});card.scrollIntoView({behavior:"smooth",block:"start"})}
function absClosePerson(){const card=document.getElementById("absPersonDetailCard");card.style.display="none";if(absCharts.absPersonChart){absCharts.absPersonChart.destroy();delete absCharts.absPersonChart}}

function absRenderDashboard(){const p=absPeriod(),rows=absCurrentRows(),current=absAggregate(rows,p.year,p.month),series=absMonthlyData(),idx=series.findIndex(x=>x.key===p.key),previous=idx>0?series[idx-1].aggregate:null;absRenderHistory({...current,key:p.key,year:p.year,month:p.month});absRenderKpis(current,previous);absRenderCharts(rows);absRenderSummary(rows);absRenderActions(current);absRenderIntelligence(rows)}
function absRecalculate(){absRenderDashboard()}
function showView(view){document.querySelectorAll(".viewPanel").forEach(x=>x.classList.remove("active"));document.querySelectorAll(".viewTab").forEach(x=>x.classList.remove("active"));if(view==="admin"){if(!adminCanUseCentral()){syncMsg("Acesso restrito à Administração","err");return}document.getElementById("viewAdmin").classList.add("active");document.getElementById("tabAdmin").classList.add("active");adminLoadData();return}if(view==="executive"){if(!canModule(activeOperationId,"VISAO_EXECUTIVA","VIEW")){syncMsg("Você não possui permissão para visualizar a Visão Executiva","err");document.getElementById("viewPlano").classList.add("active");updateOperationTabs();return}document.getElementById("viewExecutive").classList.add("active");document.getElementById("tabExecutive").classList.add("active");loadExecutiveData();return}if(view==="absenteismo"){if(!canModule(activeOperationId,"ABSENTEISMO","VIEW")){syncMsg("Você não possui permissão para visualizar o Absenteísmo","err");document.getElementById("viewPlano").classList.add("active");updateOperationTabs();return}document.getElementById("viewAbsenteismo").classList.add("active");document.getElementById("tabAbsenteismo").classList.add("active");absRenderDashboard();if(typeof sb!=="undefined"&&activeOperationId&&absSourceMode==="supabase")absLoadSupabase()}else{document.getElementById("viewPlano").classList.add("active");updateOperationTabs()}}
(function loadAbsenteismo(){try{const scope=localStorage.getItem("activeOperationCode")||"MATRIZ";const legacy=scope==="MATRIZ"?localStorage.getItem("absenteismoRows"):null;absUploadRows=JSON.parse(localStorage.getItem(`absenteismoRows:${scope}`)||legacy||"[]");absFileName=localStorage.getItem(`absenteismoFile:${scope}`)||localStorage.getItem("absenteismoFile")||"";absRows=absUploadRows}catch(e){absUploadRows=[];absRows=[]}absRenderDashboard();window.addEventListener("load",()=>{if(typeof sb!=="undefined"&&absSourceMode==="supabase")absLoadSupabase()})})();


const indicatorSeed=[
["OTD",15,97,[100,100,99.09,100,100,100,100,100]],
["OTIF",20,97,[99,99,99.3,97,97.3,97.2,97.8,97.9]],
["Fill Rate",15,98,[99,99,98.01,99.02,98.81,99.98,99.71,98.81]],
["Acuracidade de Estoque",15,98,[100,100,99.66,99.95,97.91,99.98,98.76,100]],
["Divergência Estoque",3,2,[2,9,8.61,4,0,0,3,4]],
["Internalização 48h",5,99,[99,97,99.11,97.3,98,100,99.83,99.81]],

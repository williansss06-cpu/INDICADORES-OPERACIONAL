let rows=[];
let indicatorDetails={};
let activeOperationCode=localStorage.getItem("activeOperationCode")||"MATRIZ";
let activeOperationId=null;
let operations=[];
let indicatorIdMap={};
let indicatorMeta={};
let operationLoadToken=0;
let autoSaveTimer=null;
let autoSaveInFlight=false;
let autoSaveQueued=false;
let autoSaveSuppressed=false;
let autoSaveDirtyKeys=new Set();
let autoSaveDirtyAll=false;
function markAutoSaveDirty(kind,name,month){autoSaveDirtyKeys.add(`${kind}:${name}:${month}`)}
function scheduleAutoSave(reason="alteração"){
 if(autoSaveSuppressed||!activeOperationId||!window.usuarioSustentacao)return;
 clearTimeout(autoSaveTimer);
 syncMsg("Alterações pendentes — salvando automaticamente...","warn");
 autoSaveTimer=setTimeout(()=>runAutoSave(reason),900);
}
async function runAutoSave(reason="alteração"){
 if(autoSaveInFlight){autoSaveQueued=true;return}
 autoSaveInFlight=true;
 try{await saveSupabase({silent:true,reason})}
 finally{
  autoSaveInFlight=false;
  if(autoSaveQueued){autoSaveQueued=false;scheduleAutoSave("alterações pendentes")}
 }
}
const slaNeologIndicators=[
 {name:"Acuracidade inventário",type:"PONTOS"},
 {name:"Segurança e BPDA",type:"PONTOS"},
 {name:"Expedição",type:"PONTOS"},
 {name:"Ocorrências Fora do Prazo",type:"PONTOS"},
 {name:"Avarias Valor",type:"MOEDA"},
 {name:"Avarias Unidades",type:"UNIDADES"},
 {name:"Separação",type:"PONTOS"},
 {name:"Recebimento",type:"PONTOS"},
 {name:"Resultado final",type:"PONTOS",final:true}
];
let slaNeologValues={};
function slaResetValues(){slaNeologValues={};slaNeologIndicators.forEach(x=>{slaNeologValues[x.name]=Array(12).fill(null)})}
slaResetValues();
function slaFormatValue(value,type){if(value===null||value===undefined||value===""||Number.isNaN(Number(value)))return "—";const n=Number(value);if(type==="MOEDA")return n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});return n.toLocaleString("pt-BR",{maximumFractionDigits:2})}
function slaParseValue(raw){let s=String(raw??"").trim();if(!s||s==="—"||s==="-")return null;s=s.replace(/R\$/g,"").replace(/\s/g,"").replace(/\./g,"").replace(/,/g,".").replace(/[^0-9+\-.]/g,"");if(!s||s==="-")return null;const n=Number(s);return Number.isFinite(n)?n:null}
function slaAccumulated(name,type){const values=(slaNeologValues[name]||[]).filter(v=>v!==null&&v!==undefined&&v!=="").map(Number).filter(Number.isFinite);return values.length?values.reduce((a,b)=>a+b,0):null}
function slaFinalMonth(month){const values=slaVisibleIndicators('VIEW').filter(x=>!x.final&&x.type==="PONTOS").map(x=>slaNeologValues[x.name]?.[month]).filter(v=>v!==null&&v!==undefined&&v!=="").map(Number).filter(Number.isFinite);return values.length?values.reduce((a,b)=>a+b,0):null}
function slaFinalAccumulated(){const values=slaVisibleIndicators('VIEW').filter(x=>!x.final&&x.type==="PONTOS").flatMap(x=>slaNeologValues[x.name]||[]).filter(v=>v!==null&&v!==undefined&&v!=="").map(Number).filter(Number.isFinite);return values.length?values.reduce((a,b)=>a+b,0):null}
function slaUpdateDerived(){document.querySelectorAll("#slaNeologTable .slaAccumulated").forEach(cell=>{const name=cell.dataset.name;const item=slaNeologIndicators.find(x=>x.name===name);if(item)cell.textContent=slaFormatValue(item.final?slaFinalAccumulated():slaAccumulated(name,item.type),item.type)}) ;for(let m=0;m<12;m++){const cell=document.querySelector(`#slaNeologTable td.slaFinalCell[data-month=\"${m}\"]`);if(cell)cell.textContent=slaFormatValue(slaFinalMonth(m),"PONTOS")}}
function updateSlaNeolog(name,month,raw){const item=slaNeologIndicators.find(x=>x.name===name);if(!item||item.final)return;slaNeologValues[name][month]=slaParseValue(raw);slaUpdateDerived();scheduleAutoSave("pontuação SLA Neolog")}
function renderSlaNeolog(){const section=document.getElementById("slaNeologSection"),tb=document.querySelector("#slaNeologTable tbody");if(!section||!tb)return;const visible=activeOperationCode==="GLP_ACHE";section.hidden=!visible;if(!visible){tb.innerHTML="";return}tb.innerHTML="";slaVisibleIndicators('VIEW').forEach(item=>{const tr=document.createElement("tr");if(item.final)tr.className="slaSpecial";const typeHint=item.type==="MOEDA"?"R$":item.type==="UNIDADES"?"unidades":"pontos";const first=`<td><b>${esc(item.name)}</b><span class=\"slaTypeHint\">${item.final?"consolidado":typeHint}</span></td>`;const cells=months.map((m,i)=>{const value=item.final?slaFinalMonth(i):slaNeologValues[item.name]?.[i];const edit=item.final?` class=\"slaFinalCell\" data-month=\"${i}\"`:` class=\"slaEditable\" contenteditable=\"true\" data-name=\"${esc(item.name)}\" data-month=\"${i}\" oninput=\"updateSlaNeolog('${item.name.replace(/'/g,"\\'")}',${i},this.innerText)\"`;return `<td${edit}>${slaFormatValue(value,item.type)}</td>`}).join("");const accumulated=item.final?null:slaAccumulated(item.name,item.type);tr.innerHTML=first+cells+`<td class=\"slaAccumulated\" data-name=\"${esc(item.name)}\">${slaFormatValue(accumulated,item.type)}</td>`;tb.appendChild(tr)});slaUpdateDerived()}
const lowerBetter=new Set(["Divergência Estoque","Frete vs Tabela (menor)"]);
function operationStorageKey(base){return `${base}:${activeOperationCode||"MATRIZ"}`}
function operationDisplayName(){return operations.find(x=>x.codigo===activeOperationCode)?.nome||(activeOperationCode==="GLP_ACHE"?"GLP – Operação Aché":"Plano de Sustentação Matriz")}
function operationShortName(){return activeOperationCode==="GLP_ACHE"?"GLP – Operação Aché":"MATRIZ"}
function indicatorValueType(name){
 const configured=indicatorMeta[name]?.formato;
 if(configured) return configured;
 if(activeOperationCode!=="GLP_ACHE")return "PERCENT";
 if(name==="Avarias Valor")return "CURRENCY";
 if(name==="Ocorrências Monitoramento"||name==="Avarias Unidades")return "NUMBER";
 return "PERCENT";
}
function formatIndicatorValue(name,v,empty="-"){
 if(v===null||v===undefined||v==="")return empty;
 const n=Number(v);if(!Number.isFinite(n))return empty;
 const type=indicatorValueType(name);
 if(type==="CURRENCY")return n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
 if(type==="NUMBER")return n.toLocaleString("pt-BR",{maximumFractionDigits:2});
 return n.toLocaleString("pt-BR",{maximumFractionDigits:2})+"%";
}
function fmt(v){return formatIndicatorValue("__generic__",v)}
function fmtMeta(name,v){return formatIndicatorValue(name,(v===null||v===undefined||v==="")?0:v,"0")}
 function formatAdminIndicatorValue(item,v){const n=Number(v);if(!Number.isFinite(n))return "—";const type=item?.formato||indicatorMeta[item?.nome]?.formato||"PERCENT";if(type==="CURRENCY")return n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});if(type==="NUMBER")return n.toLocaleString("pt-BR",{maximumFractionDigits:2});return n.toLocaleString("pt-BR",{maximumFractionDigits:2})+"%"}
function fmtValue(name,v){return formatIndicatorValue(name,v)}
function cellClass(name,val,goal){
 if(val===null||val===""||isNaN(val)) return "";
 let ok=(indicatorMeta[name]?.polaridade==="MENOR"||(!indicatorMeta[name]&&lowerBetter.has(name)))?val<=goal:val>=goal;
 if(ok)return "good";
 let delta=Math.abs(val-goal);
 return delta<=2?"warn":"bad";
}

/* Os detalhes são carregados por operação após a leitura do Supabase. */

function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function getDetail(name,mi){
 if(!indicatorDetails[name]) indicatorDetails[name]={};
 if(!indicatorDetails[name][mi]) indicatorDetails[name][mi]={volumeProduto:"",volumeTotal:"",foraTotal:"",obs:"",clientes:[]};
 return indicatorDetails[name][mi];
}
function latestDataMonth(name){
 const r=rows.find(x=>x[0]===name); if(!r)return 0;
 let last=0; r[3].forEach((v,i)=>{if(v!==null&&v!==undefined&&v!=="")last=i}); return last;
}
function detailHTML(name){
 const active=latestDataMonth(name);
 const tabs=months.map((m,i)=>`<button class="monthTab ${i===active?"active":""}" onclick="showDetailMonth('${name}',${i},this)">${m.slice(0,3).toUpperCase()}</button>`).join("");
 return `<div class="monthTabs">${tabs}</div><div class="monthDetailContent">${monthDetailHTML(name,active)}</div>`;
}
function monthDetailHTML(name,mi){
 const d=getDetail(name,mi);
 const monthLabel=months[mi].toUpperCase();
 if(name==="Acuracidade de Estoque"){
   let clients=(d.clientes||[]).map((c,i)=>`
    <div class="inventoryGrid clientRow" data-index="${i}">
      <input placeholder="Cliente" value="${esc(c.cliente)}" oninput="updateClient('${name}',${mi},${i},'cliente',this.value)">
      <input placeholder="Total inventariado" value="${esc(c.total)}" oninput="updateClient('${name}',${mi},${i},'total',this.value)">
      <input placeholder="Total correto" value="${esc(c.correto)}" oninput="updateClient('${name}',${mi},${i},'correto',this.value)">
      <input placeholder="Total divergente" value="${esc(c.fora)}" oninput="updateClient('${name}',${mi},${i},'fora',this.value)">
      <input placeholder="Resultado %" value="${esc(c.resultado)}" oninput="updateClient('${name}',${mi},${i},'resultado',this.value)">
      <button class="removeClient" onclick="removeClient('${name}',${mi},${i})">Excluir</button>
    </div>`).join("");
   return `<div style="font-weight:800;margin-bottom:8px">Detalhamento do inventário — ${monthLabel}</div>
   <div class="inventoryGrid inventoryHeader"><span>Cliente</span><span>Total inventariado</span><span>Total correto</span><span>Total divergente</span><span>Resultado</span><span></span></div>
   <div>${clients||'<div style="padding:8px 0;color:#667788">Nenhum cliente informado neste mês.</div>'}</div>
   <button class="addClient" onclick="addClient('${name}',${mi})">+ Incluir cliente em ${monthLabel}</button>`;
 }
 return `<div style="font-weight:800;margin-bottom:8px">Detalhamento — ${monthLabel}</div><div class="detailBox">
   <div class="detailField"><label>Volume / produto</label><div contenteditable="true" class="editable" oninput="updateDetail('${name}',${mi},'volumeProduto',this.innerText)">${esc(d.volumeProduto)}</div></div>
   <div class="detailField"><label>Total processado</label><div contenteditable="true" class="editable" oninput="updateDetail('${name}',${mi},'volumeTotal',this.innerText)">${esc(d.volumeTotal)}</div></div>
   <div class="detailField"><label>Total fora da meta</label><div contenteditable="true" class="editable" oninput="updateDetail('${name}',${mi},'foraTotal',this.innerText)">${esc(d.foraTotal)}</div></div>
   <div class="detailField"><label>Observação</label><div contenteditable="true" class="editable" oninput="updateDetail('${name}',${mi},'obs',this.innerText)">${esc(d.obs)}</div></div>
 </div>`;
}
function saveDetails(){localStorage.setItem(operationStorageKey("indicatorDetailsMonthly"),JSON.stringify(indicatorDetails))}
function updateDetail(name,mi,key,value){getDetail(name,mi)[key]=value;saveDetails();markAutoSaveDirty("detail",name,mi);scheduleAutoSave("detalhamento")}
function toggleIndicatorDetail(btn){
 const detail=btn.closest("tr").nextElementSibling;
 detail.classList.toggle("open");
 btn.textContent=detail.classList.contains("open")?"−":"+";
 btn.title=detail.classList.contains("open")?"Recolher detalhes":"Abrir detalhes";
}
function showDetailMonth(name,mi,btn){
 const row=btn.closest(".detailRow");
 row.querySelectorAll(".monthTab").forEach(b=>b.classList.remove("active"));
 btn.classList.add("active");
 row.querySelector(".monthDetailContent").innerHTML=monthDetailHTML(name,mi);
}
function addClient(name,mi){
 const d=getDetail(name,mi); if(!d.clientes)d.clientes=[];
 d.clientes.push({cliente:"",total:"",correto:"",fora:"",resultado:""});
 saveDetails(); markAutoSaveDirty("detail",name,mi); refreshDetailMonth(name,mi); scheduleAutoSave("inventário");
}
function updateClient(name,mi,i,key,value){getDetail(name,mi).clientes[i][key]=value;saveDetails();markAutoSaveDirty("detail",name,mi);scheduleAutoSave("inventário")}
function removeClient(name,mi,i){getDetail(name,mi).clientes.splice(i,1);saveDetails();markAutoSaveDirty("detail",name,mi);refreshDetailMonth(name,mi);scheduleAutoSave("inventário")}
function refreshDetailMonth(name,mi){
 const row=[...document.querySelectorAll(".detailRow")].find(x=>x.dataset.indicator===name);
 if(row){
   row.querySelector(".monthDetailContent").innerHTML=monthDetailHTML(name,mi);
   row.querySelectorAll(".monthTab").forEach((b,i)=>b.classList.toggle("active",i===mi));
   row.classList.add("open");
   const b=row.previousElementSibling.querySelector(".toggleDetail"); if(b)b.textContent="−";
 }
}

let indicatorEditingId=null;
function indicatorCreateStatus(text,err=false){const el=document.getElementById("indicatorCreateStatus");if(el){el.textContent=text;el.className="indicatorCreateStatus"+(err?" err":"")}}
function indicatorEntryById(id){return Object.entries(indicatorMeta).find(([,meta])=>Number(meta.id)===Number(id))||null}
function resetIndicatorCreate(){const form=document.getElementById("indicatorCreateForm");if(form)form.reset();const format=document.getElementById("newIndicatorFormat");if(format)format.value="PERCENT";const polarity=document.getElementById("newIndicatorPolarity");if(polarity)polarity.value="MAIOR";const status=document.getElementById("newIndicatorStatus");if(status)status.value="true";const submit=document.getElementById("indicatorCreateSubmit");if(submit)submit.textContent="Cadastrar";const mode=document.getElementById("indicatorCreateMode");if(mode)mode.textContent="Cadastrar indicador em"}
function toggleIndicatorCreate(open){const panel=document.getElementById("indicatorCreatePanel");if(!panel)return;const allowed=currentUserIsAdmin||canModule(activeOperationId,"PLANO_SUSTENTACAO","ADMIN");if(open&&!allowed){indicatorCreateStatus("Você não possui permissão para cadastrar indicadores.",true);panel.hidden=false;return}if(!open){indicatorEditingId=null;resetIndicatorCreate();panel.hidden=true;return}indicatorEditingId=null;resetIndicatorCreate();panel.hidden=false;const label=document.getElementById("indicatorCreateOperation");if(label)label.textContent=operationDisplayName();indicatorCreateStatus("");document.getElementById("newIndicatorName")?.focus()}
function editIndicator(id){const entry=indicatorEntryById(id);if(!entry){indicatorCreateStatus("Indicador não encontrado nesta operação.",true);return}const [name,meta]=entry,panel=document.getElementById("indicatorCreatePanel");if(!panel)return;const allowed=currentUserIsAdmin||canModule(activeOperationId,"PLANO_SUSTENTACAO","ADMIN");if(!allowed){indicatorCreateStatus("Você não possui permissão para editar indicadores.",true);panel.hidden=false;return}indicatorEditingId=Number(id);panel.hidden=false;document.getElementById("indicatorCreateOperation").textContent=operationDisplayName();document.getElementById("indicatorCreateMode").textContent="Editar indicador em";document.getElementById("newIndicatorName").value=name;document.getElementById("newIndicatorMeta").value=meta.meta??0;document.getElementById("newIndicatorWeight").value=meta.peso??0;document.getElementById("newIndicatorPolarity").value=meta.polaridade||"MAIOR";document.getElementById("newIndicatorFormat").value=meta.formato||"PERCENT";document.getElementById("newIndicatorStatus").value=meta.ativo===false?"false":"true";document.getElementById("indicatorCreateSubmit").textContent="Salvar alterações";indicatorCreateStatus("");document.getElementById("newIndicatorName")?.focus()}
async function createIndicator(event){event?.preventDefault();if(!activeOperationId){indicatorCreateStatus("Selecione uma operação antes de cadastrar.",true);return}const allowed=currentUserIsAdmin||canModule(activeOperationId,"PLANO_SUSTENTACAO","ADMIN");if(!allowed){indicatorCreateStatus("Você não possui permissão para cadastrar indicadores.",true);return}const nome=document.getElementById("newIndicatorName")?.value.trim(),meta=Number(document.getElementById("newIndicatorMeta")?.value),peso=Number(document.getElementById("newIndicatorWeight")?.value),polaridade=document.getElementById("newIndicatorPolarity")?.value,formato=document.getElementById("newIndicatorFormat")?.value,ativo=document.getElementById("newIndicatorStatus")?.value!=="false";if(!nome){indicatorCreateStatus("Informe o nome do indicador.",true);return}if(!Number.isFinite(meta)||!Number.isFinite(peso)||meta<0||peso<0||peso>100){indicatorCreateStatus("Informe uma meta e um peso válidos.",true);return}const sameName=Object.keys(indicatorMeta).some(existing=>existing.toLowerCase()===nome.toLowerCase()&&(!indicatorEditingId||Number(indicatorMeta[existing]?.id)!==Number(indicatorEditingId)));if(sameName){indicatorCreateStatus("Já existe um indicador com esse nome nesta operação.",true);return}indicatorCreateStatus(indicatorEditingId?"Salvando alterações...":"Cadastrando...");try{if(indicatorEditingId){const entry=indicatorEntryById(indicatorEditingId);const oldName=entry?.[0]||nome;const oldMeta=entry?.[1]||{};const q=await sb.from("sustentacao_indicadores").update({nome,peso,meta,polaridade,formato,ativo,updated_at:new Date().toISOString()}).eq("id",indicatorEditingId).eq("operacao_id",activeOperationId).select("id").single();if(q.error){if(q.error.code==="23505")throw new Error("Já existe um indicador com esse nome nesta operação.");throw q.error}if(oldName!==nome&&indicatorDetails[oldName]){indicatorDetails[nome]=indicatorDetails[oldName];delete indicatorDetails[oldName];saveDetails()}indicatorEditingId=null;resetIndicatorCreate();toggleIndicatorCreate(false);await loadAll();syncMsg(ativo?"Indicador atualizado ✓":"Indicador inativado; histórico preservado ✓","ok")}else{const ordem=rows.reduce((max,r)=>Math.max(max,Number(indicatorMeta[r[0]]?.ordem)||0),0)+1;const q=await sb.from("sustentacao_indicadores").insert({operacao_id:activeOperationId,nome,peso,meta,polaridade,formato,ordem,ativo:true}).select("id").single();if(q.error){if(q.error.code==="23505")throw new Error("Já existe um indicador com esse nome nesta operação.");throw q.error}resetIndicatorCreate();toggleIndicatorCreate(false);await loadAll();syncMsg("Indicador cadastrado ✓","ok")}}catch(e){console.error(e);indicatorCreateStatus(e.message||"Não foi possível salvar o indicador.",true)}}

function render(){
 const tb=document.querySelector("#kpiTable tbody"); tb.innerHTML="";
 const operationTitle=document.getElementById("operationTitle"),monitoringTitle=document.getElementById("monitoringTitle"),actionTitle=document.getElementById("actionTitle");
 if(operationTitle)operationTitle.textContent=activeOperationCode==="GLP_ACHE"?"GLP – OPERAÇÃO ACHÉ":"MATRIZ";
 if(monitoringTitle)monitoringTitle.textContent=`MONITORAMENTO DOS INDICADORES ${activeOperationCode==="GLP_ACHE"?"GLP – OPERAÇÃO ACHÉ":"MATRIZ"}`;
 if(actionTitle)actionTitle.textContent=`PLANO DE AÇÃO - ${activeOperationCode==="GLP_ACHE"?"GLP – OPERAÇÃO ACHÉ":"SUSTENTAÇÃO MATRIZ"}`;
 if(!rows.length){
   tb.innerHTML=`<tr><td colspan="15" style="padding:28px;text-align:center;color:#667788">Nenhum indicador cadastrado para ${esc(operationDisplayName())}. Os indicadores desta operação serão cadastrados separadamente.</td></tr>`;
   document.getElementById("summary").innerHTML="";document.getElementById("highlights").innerHTML="";document.getElementById("alerts").innerHTML="";renderSlaNeolog();return;
 }
 rows.forEach(r=>{
   const tr=document.createElement("tr");
   const editMain=canLaunchIndicator(r[0]);
   tr.innerHTML=`<td><div class="indicatorName"><button class="toggleDetail" onclick="toggleIndicatorDetail(this)" title="Abrir detalhes">+</button><span>${r[0]}</span><button class="indicatorEditButton" onclick="editIndicator(${Number(indicatorMeta[r[0]]?.id)||0})" title="Editar indicador">Editar</button></div></td><td>${r[1]}%</td><td>${fmtMeta(r[0],r[2])}</td>`+
   months.map((m,i)=>`<td contenteditable="${editMain}" data-r="${r[0]}" data-i="${i}" class="${editMain?"editable":""} ${cellClass(r[0],r[3][i],r[2])}">${fmtValue(r[0],r[3][i])}</td>`).join("");
   tb.appendChild(tr);
   const dtr=document.createElement("tr");
   dtr.className="detailRow";
   dtr.dataset.indicator=r[0];
   dtr.innerHTML=`<td colspan="15" class="detailCell">${detailHTML(r[0])}</td>`;
   tb.appendChild(dtr);
 });
 document.querySelectorAll("#kpiTable td[contenteditable]").forEach(td=>{
   td.addEventListener("input",()=>{
     let txt=td.innerText.replace("%","").replace(",",".").trim(), rr=rows.find(x=>x[0]===td.dataset.r);
     if(rr){rr[3][+td.dataset.i]=txt===""||txt==="-"?null:parseFloat(txt);saveLocal(false);markAutoSaveDirty("result",td.dataset.r,+td.dataset.i);scheduleAutoSave("resultado mensal")}
   });
   td.onblur=()=>{
     let txt=td.innerText.replace("%","").replace(",",".").trim(), rr=rows.find(x=>x[0]===td.dataset.r);
     if(rr)rr[3][+td.dataset.i]=txt===""||txt==="-"?null:parseFloat(txt); markAutoSaveDirty("result",td.dataset.r,+td.dataset.i); render(); saveLocal(false); scheduleAutoSave("resultado mensal");
   };
 });
 updateSummary();applyPermissionUI();
}
function lastMonthIndex(){let x=-1;rows.forEach(r=>r[3].forEach((v,i)=>{if(v!==null&&v!==undefined&&v!=="")x=Math.max(x,i)}));return x}
function updateSummary(){
 let mi=lastMonthIndex(); if(mi<0)return;
 let good=0,warn=0,bad=0, alerts=[], highs=[];
 rows.forEach(r=>{
   let v=r[3][mi]; if(v==null)return;
   let cls=cellClass(r[0],v,r[2]);
   if(cls==="good"){good++; highs.push({name:r[0],value:v,goal:r[2]});}
   else { if(cls==="warn") warn++; else bad++; alerts.push({name:r[0],value:v,goal:r[2],cls}); }
 });
 document.getElementById("summary").innerHTML=
   `<div class="summaryLine"><span class="summaryIcon okbg">✓</span><span class="ok">${good} indicadores acima da meta</span></div>`+
   `<div class="summaryLine"><span class="summaryIcon warnbg">!</span><span class="attention">${warn} indicadores em atenção</span></div>`+
   `<div class="summaryLine"><span class="summaryIcon badbg">×</span><span class="critical">${bad} indicador${bad===1?"":"es"} crítico${bad===1?"":"s"}</span></div>`;
 const preferred=["OTD","OTIF","Fill Rate","Frete vs Tabela (menor)"];
 let selected=preferred.map(n=>highs.find(x=>x.name===n)).filter(Boolean);
 if(selected.length<4) selected=highs.slice(0,4);
 document.getElementById("highlights").innerHTML=
   `<div style="font-weight:800;margin-bottom:9px">${months[mi].toUpperCase()}</div><div class="summaryKpis">`+
   selected.map(x=>`<div class="kpiMini"><div class="value">${fmtValue(x.name,x.value)}</div><div class="name">${x.name.replace(" (menor)","")}</div><div class="goal">Meta: ${fmtMeta(x.name,x.goal)}</div><span class="badge">✓ Acima da meta</span></div>`).join("")+
   `</div>`;
 document.getElementById("alerts").innerHTML=alerts.length?
   alerts.slice(0,3).map(x=>`<div class="alertLine"><span class="summaryIcon ${x.cls==="bad"?"badbg":"warnbg"}">${x.cls==="bad"?"!":"!"}</span><div><b>${x.name}: <span class="${x.cls==="bad"?"critical":"attention"}">${fmtValue(x.name,x.value)}</span></b><small>Meta: ${fmtMeta(x.name,x.goal)}</small></div></div>`).join("")
   :`<div class="summaryLine"><span class="summaryIcon okbg">✓</span><span class="ok">Sem desvios no mês.</span></div>`;
}
function parseCSV(text){
 const lines=text.replace(/\r/g,"").split("\n").filter(x=>x.trim());
 const sep=(lines[0].match(/;/g)||[]).length>(lines[0].match(/,/g)||[]).length?";":",";
 const a=lines.map(l=>l.split(sep).map(x=>x.trim().replace(/^"|"$/g,"")));
 const h=a[0].map(x=>x.toLowerCase());
 let m=h.indexOf("mes"), ind=h.indexOf("indicador"), val=h.indexOf("valor");
 if(m<0||ind<0||val<0) throw new Error("Use colunas: mes;indicador;valor");
 a.slice(1).forEach(x=>{
   let mi=months.indexOf((x[m]||"").toLowerCase()), rr=rows.find(r=>r[0].toLowerCase()===(x[ind]||"").toLowerCase());
   if(mi>=0&&rr) rr[3][mi]=parseFloat((x[val]||"").replace("%","").replace(",","."));
 });
 render(); saveLocal(false); autoSaveDirtyAll=true; scheduleAutoSave("importação CSV");
}
document.getElementById("csvFile").onchange=e=>{let f=e.target.files[0];if(!f)return;let rd=new FileReader();rd.onload=()=>{try{parseCSV(rd.result)}catch(err){alert(err.message)}};rd.readAsText(f,"UTF-8")};
function downloadTemplate(){
 let s="mes;indicador;valor\n";
 rows.forEach(r=>s+=`setembro;${r[0]};\n`);
 let b=new Blob([s],{type:"text/csv;charset=utf-8"}),a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="modelo_indicadores_mes.csv";a.click();
}

function renumberActions(){
 document.querySelectorAll("#actionTable tbody tr").forEach((tr,i)=>{
   tr.cells[0].textContent=i+1;
 });
}
function addActionRow(){
 const tb=document.querySelector("#actionTable tbody");
 const tr=document.createElement("tr");
 tr.dataset.id="";
 tr.dataset.concluido="false";
 tr.innerHTML=`<td></td>
 <td contenteditable="true" class="editable">Digite a ação</td>
 <td contenteditable="true" class="editable">Responsável</td>
 <td contenteditable="true" class="editable"></td>
 <td contenteditable="true" class="editable"></td>
 <td contenteditable="true" class="editable"></td>
 <td contenteditable="true" class="editable"></td>
 <td><button class="completeAction" onclick="toggleActionComplete(this)">Concluir</button><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td>`;
 tb.appendChild(tr);
 applyPermissionUI();
 renumberActions();
 tr.cells[1].focus();
 saveLocal(false); scheduleAutoSave("novo plano de ação");
}
function deleteActionRow(btn){
 if(!confirm("Deseja excluir esta linha do plano de ação?")) return;
 btn.closest("tr").remove();
 renumberActions();
 saveLocal(false); scheduleAutoSave("exclusão de plano de ação");
}
document.querySelector("#actionTable tbody").addEventListener("input",()=>{saveLocal(false);scheduleAutoSave("plano de ação")});

function saveLocal(show=true){
 localStorage.setItem(operationStorageKey("matrizRows"),JSON.stringify(rows));
 localStorage.setItem(operationStorageKey("matrizActions"),document.querySelector("#actionTable tbody").innerHTML);
 if(show)alert("Dados salvos neste navegador.");
}
(function load(){
 
 
 document.querySelectorAll("#actionTable tbody tr").forEach(tr=>{
   if(tr.cells.length===7){
     const td=document.createElement("td");
     td.innerHTML='<button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button>';
     tr.appendChild(td);
   }
 });
 renumberActions();
 render();
})();

const SB_URL="https://nemvssopcgmfxjndpmlw.supabase.co";
const SB_KEY="sb_publishable_o9a_7dC7qOcmA32yHvqx9A_eb8X1Pmg";
const sb=window.supabase.createClient(SB_URL,SB_KEY);
const APP_URL="https://williansss06-cpu.github.io/INDICADORES-OPERACIONAL/";
const PASSWORD_RESET_URL=APP_URL+"?reset-password=true";
let selectedYear=2026;
let operationConfigs={};

function syncMsg(t,c=""){let e=document.getElementById("syncStatus");if(e){e.textContent=t;e.className="syncStatus "+c}}
function years(){let s=document.getElementById("yearSelect");s.innerHTML="";for(let y=2024;y<=2035;y++){let o=new Option(y,y,y===selectedYear,y===selectedYear);s.add(o)}}
function updateOperationTabs(){document.querySelectorAll("#tabMatriz,#tabGLP,#tabAbsenteismo,#tabExecutive,#tabAdmin").forEach(x=>x.classList.remove("active"));const allowed=new Set(operations.map(x=>x.codigo));const matriz=document.getElementById("tabMatriz"),glp=document.getElementById("tabGLP");if(matriz)matriz.hidden=!allowed.has("MATRIZ");if(glp)glp.hidden=!allowed.has("GLP_ACHE");const op=activeOperationCode==="GLP_ACHE"?"tabGLP":"tabMatriz";const opButton=document.getElementById(op);if(opButton)opButton.classList.add("active");const label=document.getElementById("operationTitle");if(label)label.textContent=activeOperationCode==="GLP_ACHE"?"GLP – OPERAÇÃO ACHÉ":"MATRIZ";applyPermissionUI()}
function setOperationContext(){updateOperationTabs();const isMatriz=activeOperationCode==="MATRIZ",title=document.getElementById("monitoringTitle"),action=document.getElementById("actionTitle");if(title)title.textContent=`MONITORAMENTO DOS INDICADORES ${isMatriz?"MATRIZ":"GLP – OPERAÇÃO ACHÉ"}`;if(action)action.textContent=`PLANO DE AÇÃO - ${isMatriz?"SUSTENTAÇÃO MATRIZ":"GLP – OPERAÇÃO ACHÉ"}`;const config=operationConfigs[activeOperationId]||{};const responsible=config.responsavel_nome||"Não cadastrado",polarity=config.polaridade||"Não cadastrado",objective=config.objetivo||"Não cadastrado",format=config.formato_calculo||"Não cadastrado",weight=config.peso===null||config.peso===undefined||config.peso===""?"Não cadastrado":Number(config.peso).toLocaleString("pt-BR",{maximumFractionDigits:2})+"%";const values={operationResponsible:responsible,operationPolarity:polarity,operationObjective:objective,operationFormat:format,operationWeight:weight};Object.entries(values).forEach(([id,value])=>{const el=document.getElementById(id);if(el)el.textContent=value})}
function authFriendlyMessage(error,fallback="Não foi possível concluir esta solicitação. Tente novamente mais tarde ou entre em contato com o administrador."){const text=String(error?.message||error||"").toLowerCase();if(text.includes("rate limit")||text.includes("over_email_send_rate_limit")||text.includes("too many")||text.includes("email" )&&text.includes("429"))return "Não foi possível enviar o e-mail neste momento. Aguarde alguns minutos e tente novamente ou entre em contato com o administrador.";if(text.includes("invalid login credentials"))return "E-mail ou senha inválidos.";return fallback}
function setButtonBusy(button,busy,label){if(!button)return;if(busy){if(!button.dataset.originalLabel)button.dataset.originalLabel=button.textContent;button.disabled=true;button.textContent=label}else{button.disabled=false;button.textContent=button.dataset.originalLabel||button.textContent}}
function startPasswordCooldown(seconds=60){passwordRequestCooldownUntil=Date.now()+seconds*1000;const button=document.getElementById("requestPasswordResetButton");if(!button)return;setButtonBusy(button,true,`Aguarde ${seconds}s`);const tick=()=>{const remaining=Math.ceil((passwordRequestCooldownUntil-Date.now())/1000);if(remaining>0){button.disabled=true;button.textContent=`Aguarde ${remaining}s`;window.setTimeout(tick,1000)}else{setButtonBusy(button,false)}};tick()}
async function login(){let e=loginEmail.value.trim(),p=loginPassword.value;authError.textContent="Entrando...";const button=document.getElementById("loginButton");if(button?.disabled)return;setButtonBusy(button,true,"Entrando...");try{let {data,error}=await sb.auth.signInWithPassword({email:e,password:p});if(error){authError.textContent=authFriendlyMessage(error,"Não foi possível entrar. Verifique o e-mail e a senha.");return}authError.textContent="";await enter(data.user)}finally{setButtonBusy(button,false)}}
function authReturnParams(){const search=new URLSearchParams(window.location.search||""),rawHash=window.location.hash||"",hash=new URLSearchParams(rawHash.startsWith("#")?rawHash.slice(1):rawHash);return {search,hash}}
function authLinkType(){const {search,hash}=authReturnParams();return search.get("type")||hash.get("type")||""}
function isPasswordSetupLink(){return ["invite","recovery"].includes(authLinkType())}
function isPasswordResetRoute(){return authReturnParams().search.get("reset-password")==="true"}
function hasPasswordRecoveryIntent(){const {search,hash}=authReturnParams();return isPasswordResetRoute()||authLinkType()==="recovery"||search.has("code")||hash.has("access_token")&&authLinkType()==="recovery"}
function clearPasswordRoute(){if(window.history?.replaceState)window.history.replaceState(null,document.title,window.location.pathname)}
function showPasswordSetup(mode="recovery"){passwordRecoveryActive=mode==="recovery"||isPasswordResetRoute()||authLinkType()==="recovery";const overlay=document.getElementById("passwordSetupOverlay"),auth=document.getElementById("authOverlay"),error=document.getElementById("passwordSetupError"),form=document.getElementById("passwordSetupForm"),success=document.getElementById("passwordSetupSuccess"),title=document.querySelector("#passwordSetupBox h2"),lead=document.getElementById("passwordSetupLead");if(title)title.textContent="CRIAR NOVA SENHA";if(lead)lead.textContent=passwordRecoveryActive?"Defina uma nova senha para acessar o Plano de Sustentação.":"Seu acesso foi confirmado. Crie uma senha pessoal para entrar no Plano de Sustentação.";if(error)error.textContent="";if(form)form.style.display="block";if(success)success.style.display="none";if(overlay)overlay.style.display="flex";if(auth)auth.style.display="none"}
async function requestPasswordReset(){const email=document.getElementById("loginEmail")?.value.trim().toLowerCase(),button=document.getElementById("requestPasswordResetButton");if(passwordRequestBusy||Date.now()<passwordRequestCooldownUntil)return;if(!email||!email.includes("@")){authError.textContent="Informe o e-mail para receber o link de criação ou recuperação de senha.";return}passwordRequestBusy=true;setButtonBusy(button,true,"Enviando...");authError.textContent="Enviando link...";try{const {error}=await sb.auth.resetPasswordForEmail(email,{redirectTo:PASSWORD_RESET_URL});if(error){authError.textContent=authFriendlyMessage(error);return}authError.textContent="Se o e-mail estiver autorizado, enviaremos um link para criar ou recuperar a senha.";startPasswordCooldown(60)}catch(error){console.error(error);authError.textContent=authFriendlyMessage(error)}finally{passwordRequestBusy=false;if(Date.now()>=passwordRequestCooldownUntil)setButtonBusy(button,false)}}
async function saveFirstPassword(){const password=document.getElementById("newPassword")?.value||"",confirmation=document.getElementById("newPasswordConfirm")?.value||"",error=document.getElementById("passwordSetupError"),button=document.getElementById("saveFirstPasswordButton");if(firstPasswordBusy)return;if(password.length<8){error.textContent="A senha deve ter pelo menos 8 caracteres.";return}if(password!==confirmation){error.textContent="As senhas não conferem.";return}firstPasswordBusy=true;setButtonBusy(button,true,"Salvando...");error.textContent="Salvando senha...";try{const {error:saveError}=await sb.auth.updateUser({password,data:{first_access_completed:true,first_access_completed_at:new Date().toISOString()}});if(saveError){error.textContent=authFriendlyMessage(saveError,"Não foi possível salvar a senha. Tente novamente mais tarde.");return}const form=document.getElementById("passwordSetupForm"),success=document.getElementById("passwordSetupSuccess");if(form)form.style.display="none";if(success)success.style.display="block";if(error)error.textContent="";clearPasswordRoute()}catch(saveError){console.error(saveError);error.textContent=authFriendlyMessage(saveError,"Não foi possível salvar a senha. Tente novamente mais tarde.")}finally{firstPasswordBusy=false;setButtonBusy(button,false)}}
async function finishPasswordSetup(){try{await sb.auth.signOut()}catch(error){console.error(error)}passwordRecoveryActive=false;document.getElementById("newPassword").value="";document.getElementById("newPasswordConfirm").value="";document.getElementById("passwordSetupOverlay").style.display="none";document.getElementById("authOverlay").style.display="flex";document.getElementById("loginPassword").value="";document.getElementById("authError").textContent="Senha atualizada. Entre com seu e-mail e a nova senha.";syncMsg("Senha atualizada")}
async function logout(){await sb.auth.signOut();authOverlay.style.display="flex";syncMsg("Sessão encerrada")}
async function loadOperationConfigForOperation(operationId){if(!operationId)return;const q=await sb.from("sustentacao_configuracoes_operacao").select("id,operacao_id,responsavel_user_id,responsavel_nome,polaridade,objetivo,formato_calculo,peso,ativo,updated_at,updated_by").eq("operacao_id",operationId).eq("ativo",true).maybeSingle();if(q.error)throw q.error;operationConfigs[operationId]=q.data||null;if(operationId===activeOperationId)setOperationContext()}
async function loadOperations(){const q=await sb.from('sustentacao_operacoes').select('id,codigo,nome,ativo,responsavel_user_id').eq('ativo',true).order('id');if(q.error)throw q.error;operations=q.data||[];if(!operations.length)throw new Error('Nenhuma operação disponível para este usuário.');if(!operations.some(x=>x.codigo===activeOperationCode))activeOperationCode=operations[0].codigo||'MATRIZ';const active=operations.find(x=>x.codigo===activeOperationCode)||operations[0];activeOperationCode=active.codigo;activeOperationId=active.id;currentUserOperationIds=new Set(operations.map(x=>Number(x.id)));localStorage.setItem('activeOperationCode',activeOperationCode);setOperationContext()}
async function enter(u){
  try{
    authError.textContent="Validando permissão...";
    const verified=await sb.auth.getUser();
    const authUser=verified?.data?.user;
    if(verified?.error||!authUser)throw verified?.error||new Error("Sessão Auth inválida");
    const {data: acesso,error}=await sb.from("sustentacao_usuarios").select("user_id,email,perfil,ativo").eq("user_id",authUser.id).eq("ativo",true).maybeSingle();
    if(error)throw error;
    if(!acesso){await sb.auth.signOut();authOverlay.style.display="flex";authError.textContent="Acesso não autorizado ao Plano de Sustentação.";syncMsg("Acesso negado","err");return}
    window.usuarioSustentacao=acesso;currentUserId=authUser.id;currentUserProfile=acesso.perfil;currentUserIsAdmin=["admin","super_admin"].includes(acesso.perfil);currentUserIsOperationAdmin=["gestor","administrador_operacao"].includes(acesso.perfil);currentUserOperationIds=new Set();authError.textContent="";authOverlay.style.display="none";years();await loadMyPermissions();await loadOperations();syncMsg("Carregando...");await loadAll(); if(absSourceMode==="supabase") await absLoadSupabase();updateOperationTabs();
  }catch(e){console.error(e);await sb.auth.signOut();authOverlay.style.display="flex";authError.textContent="Não foi possível validar sua permissão: "+e.message;syncMsg("Acesso não validado","err")}
}
async function switchOperation(code){if(!operations.some(x=>x.codigo===code))return;if(code===activeOperationCode&&document.getElementById("viewPlano")?.classList.contains("active"))return;activeOperationCode=code;const op=operations.find(x=>x.codigo===code);activeOperationId=op?.id||null;localStorage.setItem("activeOperationCode",code);operationLoadToken++;operationConfigs[activeOperationId]=null;setOperationContext();await loadOperationConfigForOperation(activeOperationId);document.getElementById("viewPlano").classList.add("active");document.getElementById("viewAbsenteismo").classList.remove("active");document.getElementById("tabAbsenteismo").classList.remove("active");rows=[];indicatorIdMap={};indicatorMeta={};indicatorDetails={};render();await loadAll();if(absSourceMode==="supabase")await absLoadSupabase()}
async function changeYear(){selectedYear=+yearSelect.value;await loadResults();await loadSlaNeolog();if(document.getElementById("viewAbsenteismo")?.classList.contains("active"))await absLoadSupabase();if(document.getElementById("viewExecutive")?.classList.contains("active"))await loadExecutiveData()}
async function loadAll(){const token=++operationLoadToken;try{if(!activeOperationId)await loadOperations();await loadOperationConfigForOperation(activeOperationId);let q=await sb.from("sustentacao_indicadores").select("id,nome,peso,meta,polaridade,ordem,ativo,operacao_id,formato").eq("operacao_id",activeOperationId).eq("ativo",true).order("ordem");if(q.error)throw q.error;if(token!==operationLoadToken)return;indicatorIdMap={};indicatorMeta={};rows=(q.data||[]).map(x=>{indicatorIdMap[x.nome]=x.id;indicatorMeta[x.nome]={id:x.id,polaridade:x.polaridade,meta:Number(x.meta||0),peso:Number(x.peso||0),ordem:x.ordem,operacao_id:x.operacao_id,ativo:x.ativo!==false,formato:x.formato||"PERCENT"};return [x.nome,Number(x.peso||0),Number(x.meta||0),Array(12).fill(null)]});indicatorDetails={};const saved=localStorage.getItem(operationStorageKey("indicatorDetailsMonthly"));if(saved)try{indicatorDetails=JSON.parse(saved)||{}}catch(_){indicatorDetails={}};await loadResults();await loadActions();await loadSlaNeolog();setOperationContext();syncMsg(rows.length?"Sincronizado":"Operação sem indicadores","ok")}catch(e){console.error(e);syncMsg(e.message,"err")}}
async function loadSlaNeolog(){slaResetValues();if(activeOperationCode!=="GLP_ACHE"||!activeOperationId){renderSlaNeolog();return}const q=await sb.from("sustentacao_sla_neolog_pontuacoes").select("id,operacao_id,ano,indicador,indicador_id,mes,tipo,valor").eq("operacao_id",activeOperationId).eq("ano",selectedYear).order("mes").order("indicador");if(q.error)throw q.error;(q.data||[]).forEach(x=>{if(slaNeologValues[x.indicador]&&x.mes>=1&&x.mes<=12)slaNeologValues[x.indicador][x.mes-1]=x.valor==null?null:Number(x.valor)});renderSlaNeolog()}
async function saveSlaNeolog(){if(activeOperationCode!=="GLP_ACHE"||!activeOperationId)return;const existing=await sb.from("sustentacao_sla_neolog_pontuacoes").select("id,indicador,mes").eq("operacao_id",activeOperationId).eq("ano",selectedYear).limit(500);if(existing.error)throw existing.error;const kept=new Set();for(const item of slaNeologIndicators.filter(x=>!x.final&&canSlaItem(x,'EDIT'))){for(let m=0;m<12;m++){const value=slaNeologValues[item.name]?.[m];if(value===null||value===undefined||value==="")continue;const payload={operacao_id:activeOperationId,ano:selectedYear,indicador:item.name,mes:m+1,tipo:item.type,valor:Number(value),updated_at:new Date().toISOString()};const q=await sb.from("sustentacao_sla_neolog_pontuacoes").upsert(payload,{onConflict:"operacao_id,ano,indicador,mes"}).select("id").single();if(q.error)throw q.error;kept.add(`${item.name}:${m+1}`)}}const stale=(existing.data||[]).filter(x=>!kept.has(`${x.indicador}:${x.mes}`)).map(x=>x.id);if(stale.length){const d=await sb.from("sustentacao_sla_neolog_pontuacoes").delete().in("id",stale).eq("operacao_id",activeOperationId);if(d.error)throw d.error}}
async function loadResults(){rows.forEach(r=>r[3]=Array(12).fill(null));let q=await sb.from("sustentacao_resultados").select("*").eq("operacao_id",activeOperationId).eq("ano",selectedYear).order("mes");if(q.error)throw q.error;let names={};Object.entries(indicatorIdMap).forEach(([n,id])=>names[id]=n);(q.data||[]).forEach(x=>{let n=names[x.indicador_id],r=rows.find(z=>z[0]===n);if(!r)return;r[3][x.mes-1]=x.resultado==null?null:+x.resultado;if(!indicatorDetails[n])indicatorDetails[n]={};indicatorDetails[n][x.mes-1]={volumeProduto:x.volume_produto||"",volumeTotal:x.total_processado??"",foraTotal:x.total_fora_meta??"",obs:x.observacao||"",clientes:[],_id:x.id}});let ids=(q.data||[]).map(x=>x.id);if(ids.length){let inv=await sb.from("sustentacao_inventarios").select("*").eq("operacao_id",activeOperationId).in("resultado_id",ids);if(inv.error)throw inv.error;let rm={};(q.data||[]).forEach(x=>rm[x.id]=[names[x.indicador_id],x.mes-1]);(inv.data||[]).forEach(v=>{let z=rm[v.resultado_id];if(z)getDetail(z[0],z[1]).clientes.push({_id:v.id,cliente:v.cliente||"",total:v.total_inventariado??"",correto:v.total_correto??"",fora:v.total_divergente??"",resultado:v.resultado_percentual??""})})}render();saveDetails();syncMsg(rows.length?"Ano "+selectedYear+" carregado":"Operação sem resultados","ok")}
function N(v){if(v==null||String(v).trim()==="")return null;let n=Number(String(v).replace("%","").replace(",",".").replace(/[^0-9.-]/g,""));return isNaN(n)?null:n}
async function saveSupabase(options={}){const silent=!!options.silent;try{if(!activeOperationId)throw new Error("Selecione uma operação carregada.");if(!currentUserIsAdmin&&!canModule(activeOperationId,"PLANO_SUSTENTACAO","EDIT")&&!canModule(activeOperationId,"INVENTARIOS","EDIT")&&!canAction("EDIT")&&!canAction("STATUS")&&!canAction("CONCLUDE")&&!canModule(activeOperationId,"SLA_NEOLOG","EDIT")){if(!silent)syncMsg("Você não possui permissão de edição nesta operação","err");return}if(!silent)syncMsg("Salvando...");for(const r of rows){const resultEditable=canLaunchIndicator(r[0]),inventoryEditable=canEditInventory(r[0]),iid=indicatorIdMap[r[0]];for(let m=0;m<12;m++){let d=getDetail(r[0],m),v=r[3][m],has=d.volumeProduto||d.volumeTotal!==""||d.foraTotal!==""||d.obs||d.clientes?.length,dirty=autoSaveDirtyAll||autoSaveDirtyKeys.has(`detail:${r[0]}:${m}`)||autoSaveDirtyKeys.has(`result:${r[0]}:${m}`);if(silent&&!dirty)continue;if(v==null&&!has)continue;if(!resultEditable&&!inventoryEditable)continue;let resultId=d._id;if(resultEditable){let payload={operacao_id:activeOperationId,indicador_id:iid,ano:selectedYear,mes:m+1,resultado:N(v),volume_produto:d.volumeProduto||null,total_processado:N(d.volumeTotal),total_fora_meta:N(d.foraTotal),observacao:d.obs||null,updated_at:new Date().toISOString()};let q=await sb.from("sustentacao_resultados").upsert(payload,{onConflict:"operacao_id,indicador_id,ano,mes"}).select("id").single();if(q.error)throw q.error;resultId=q.data.id;d._id=resultId}else if(!resultId)continue;if(r[0]==="Acuracidade de Estoque"&&inventoryEditable){let existing=await sb.from("sustentacao_inventarios").select("id").eq("operacao_id",activeOperationId).eq("resultado_id",resultId).limit(100);if(existing.error)throw existing.error;let beforeIds=new Set((existing.data||[]).map(x=>x.id)),keptIds=new Set();for(const c of(d.clientes||[]).filter(c=>c.cliente?.trim())){let inventoryPayload={operacao_id:activeOperationId,resultado_id:resultId,cliente:c.cliente.trim(),total_inventariado:N(c.total),total_correto:N(c.correto),total_divergente:N(c.fora),resultado_percentual:N(c.resultado)};if(c._id){let u=await sb.from("sustentacao_inventarios").update(inventoryPayload).eq("id",c._id).eq("operacao_id",activeOperationId).eq("resultado_id",resultId).select("id").single();if(u.error)throw u.error;keptIds.add(c._id)}else{let ins=await sb.from("sustentacao_inventarios").insert(inventoryPayload).select("id").single();if(ins.error)throw ins.error;if(ins.data?.id){c._id=ins.data.id;keptIds.add(ins.data.id)}}}let removed=[...beforeIds].filter(id=>!keptIds.has(id));if(removed.length){let z=await sb.from("sustentacao_inventarios").delete().in("id",removed).eq("operacao_id",activeOperationId);if(z.error)throw z.error}}}}if(canAction("VIEW"))await saveActionsDB();if(canModule(activeOperationId,"SLA_NEOLOG","EDIT"))await saveSlaNeolog();if(silent){autoSaveDirtyKeys.clear();autoSaveDirtyAll=false}syncMsg(silent?"Salvamento automático concluído ✓":"Salvo no Supabase ✓","ok")}catch(e){console.error(e);syncMsg(silent?"Erro no salvamento automático":"Erro ao salvar","err");if(!silent)alert(e.message)}}
function dateDB(s){s=(s||"").trim();if(!s)return null;let p=s.split("/");return p.length===3?p[2]+"-"+p[1]+"-"+p[0]:s}
function dateBR(s){if(!s)return "";let p=s.split("-");return p.length===3?p[2]+"/"+p[1]+"/"+p[0]:s}
async function saveActionsDB(){if(!activeOperationId||!canAction("VIEW"))return;if(!canAction("CREATE")&&!canAction("EDIT")&&!canAction("STATUS")&&!canAction("CONCLUDE")&&!canAction("DELETE"))return;let existing=await sb.from("sustentacao_plano_acao").select("id").eq("operacao_id",activeOperationId).limit(500);if(existing.error)throw existing.error;let activeIds=new Set();let items=[...document.querySelectorAll("#actionTable tbody tr")].map((tr,i)=>({tr,i,id:Number(tr.dataset.id)||null,numero:i+1,acao:(tr.cells[1]?.innerText||"").trim(),responsavel:(tr.cells[2]?.childNodes?.[0]?.textContent||tr.cells[2]?.innerText||"").trim()||null,responsavel_user_id:tr.dataset.responsavelUserId||null,indicador_id:Number(tr.dataset.indicadorId)||null,data_inicio:dateDB(tr.cells[3]?.innerText),data_fim:dateDB(tr.cells[4]?.innerText),status:(tr.cells[5]?.innerText||"").trim()||null,observacao:(tr.cells[6]?.innerText||"").trim()||null,ordem:i+1,concluido:tr.dataset.concluido==="true"})).filter(x=>x.acao);for(const item of items){let payload={operacao_id:activeOperationId,indicador_id:item.indicador_id,responsavel_user_id:item.responsavel_user_id,numero:item.numero,acao:item.acao,responsavel:item.responsavel,data_inicio:item.data_inicio,data_fim:item.data_fim,status:item.status,observacao:item.observacao,ordem:item.ordem,concluido:item.concluido};if(item.id){let q=await sb.from("sustentacao_plano_acao").update(payload).eq("id",item.id).eq("operacao_id",activeOperationId).select("id").single();if(q.error)throw q.error;activeIds.add(item.id)}else if(canAction("CREATE")){let q=await sb.from("sustentacao_plano_acao").insert(payload).select("id").single();if(q.error)throw q.error;if(q.data?.id){item.tr.dataset.id=q.data.id;activeIds.add(q.data.id)}}}let removed=(existing.data||[]).map(x=>x.id).filter(id=>!activeIds.has(id));if(removed.length&&canAction("DELETE")){let d=await sb.from("sustentacao_plano_acao").delete().in("id",removed).eq("operacao_id",activeOperationId);if(d.error)throw d.error}}
async function loadActions(){if(!activeOperationId)return;let q=await sb.from("sustentacao_plano_acao").select("*").eq("operacao_id",activeOperationId).order("ordem");if(q.error)throw q.error;let tb=document.querySelector("#actionTable tbody");tb.innerHTML="";if(!q.data?.length){tb.innerHTML=`<tr><td colspan="8" style="padding:24px;text-align:center;color:#667788">Nenhum plano de ação cadastrado para ${esc(operationDisplayName())}.</td></tr>`;applyPermissionUI();return}q.data.forEach((a,i)=>{let tr=document.createElement("tr");tr.dataset.id=String(a.id);tr.dataset.concluido=String(!!a.concluido);tr.dataset.indicadorId=a.indicador_id?String(a.indicador_id):"";tr.dataset.responsavelUserId=a.responsavel_user_id?String(a.responsavel_user_id):"";const assignee=(typeof adminUsers!=="undefined"&&adminCanUseCentral()&&adminUsers.length)?`<select class="actionAssignee" onchange="actionAssigneeChanged(this)"><option value="">Sem usuário atribuído</option>${adminUsers.map(u=>`<option value="${u.user_id}" ${a.responsavel_user_id===u.user_id?"selected":""}>${esc(u.nome||u.email)}</option>`).join("")}</select>`:"";const complete=(a.concluido?"Reabrir":"Concluir");tr.innerHTML=`<td>${a.numero??i+1}</td><td contenteditable="true">${esc(a.acao)}</td><td contenteditable="true">${esc(a.responsavel||"")}${assignee}</td><td contenteditable="true">${dateBR(a.data_inicio)}</td><td contenteditable="true">${dateBR(a.data_fim)}</td><td contenteditable="true">${esc(a.status||"")}</td><td contenteditable="true">${esc(a.observacao||"")}</td><td><button class="completeAction" onclick="toggleActionComplete(this)">${complete}</button><button class="deleteRow" onclick="deleteActionRow(this)">Excluir</button></td>`;tb.appendChild(tr)});applyPermissionUI()}
function actionAssigneeChanged(select){select.closest("tr").dataset.responsavelUserId=select.value;saveLocal(false);scheduleAutoSave("responsável do plano de ação")}
function toggleActionComplete(btn){const tr=btn.closest("tr");tr.dataset.concluido=String(tr.dataset.concluido!=="true");btn.textContent=tr.dataset.concluido==="true"?"Reabrir":"Concluir";saveLocal(false);scheduleAutoSave("conclusão do plano de ação")}
(async function bootstrapAuth(){
 handleAuthRedirectFeedback();
 const passwordRoute=hasPasswordRecoveryIntent();
 if(passwordRoute)showPasswordSetup("recovery");
 sb.auth.onAuthStateChange((event,session)=>{if(event==="PASSWORD_RECOVERY"&&session?.user){passwordRecoveryActive=true;window.setTimeout(()=>showPasswordSetup("recovery"),0)}else if(event==="SIGNED_OUT"&&!passwordRecoveryActive){authOverlay.style.display="flex"}});
 const {search}=authReturnParams();
 let data=null,error=null;
 if(search.get("code")){
   const exchanged=await sb.auth.exchangeCodeForSession(search.get("code"));
   data=exchanged.data;error=exchanged.error;
 }else{
   const current=await sb.auth.getSession();data=current.data;error=current.error;
 }
 if(error){console.error(error);if(passwordRoute){showPasswordSetup("recovery");document.getElementById("passwordSetupError").textContent="O link de redefinição é inválido ou expirou. Solicite um novo e-mail."}else authOverlay.style.display="flex";return}
 if(data?.session?.user){if(passwordRoute||passwordRecoveryActive){showPasswordSetup("recovery");return}await enter(data.session.user)}
 else if(passwordRoute){showPasswordSetup("recovery");document.getElementById("passwordSetupError").textContent="O link de redefinição é inválido ou expirou. Solicite um novo e-mail."}
 else authOverlay.style.display="flex";
})();
</script>
</body></html>
